  "downloadAtInstall": [
    {
      "_comment": [
        "NOT inside RetroHub-Setup.exe (owner decision): Setup downloads it during the installation from Eden's own server",
        "(optional task 'eden', checked by default), checks this SHA-256 and unpacks it flat into emulators\\eden",
        "(RetroHub.iss, [Code] InstallEden). build.ps1 passes url/sha256/size to ISCC and checks that the pinned file",
        "still matches (it is downloaded into <WorkDir>\\downloads\\eden\\ for that check, never staged).",
        "uninstallFiles: what Setup removes on uninstall (the extracted files are not in Setup's uninstall log) –",
        "keep it in sync with the archive's top level when the version changes. Eden's data folder user\\ stays."
      ],
      "id": "eden",
      "name": "Eden",
      "version": "0.2.1",
      "license": "GPL-3.0-or-later",
      "website": "https://eden-emu.dev/",
      "source": "https://git.eden-emu.dev/eden-emu/eden",
      "url": "https://stable.eden-emu.dev/v0.2.1/Eden-Windows-v0.2.1-amd64-msvc-standard.zip",
      "sha256": "FF498E5DA9630216926AC3CBE9FB493B14930665C728A40A8F5B59507FDD7EBF",
      "size": 31319001,
      "target": "emulators\\eden",
      "exe": "eden.exe",
      "uninstallFiles": ["eden.exe", "eden-cli.exe", "LICENSE.txt", "README.md", "LICENSES\\", "version.txt"]
    }
  ],
