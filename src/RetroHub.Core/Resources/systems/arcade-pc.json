    "sortOrder": 800
  },
  {
    "id": "pc",
    "name": "PC (Windows)",
    "shortName": "PC",
    "manufacturer": "Microsoft",
    "category": "Pc",
    "folders": ["pc", "windows"],
    // .exe = portable game, .lnk/.url = shortcut to an installed game (also steam:// links)
    "extensions": [".exe", ".lnk", ".url"],
    "emulators": ["native"],
    "accent": "#0078D4",
