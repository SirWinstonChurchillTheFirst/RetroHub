<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    RetroHub design tokens – "Fernsehlicht" (docs/design/DESIGN.md v1.1).
    Warm, opaque neutrals; the only brand colour is Standby-Bernstein #FFB547 (closed list of uses, DESIGN 2.2:
    grep "#FFB547|RhAccent" and compare). Radii 0/2/4/6 only. No glass, no alpha-white surfaces, no glow.
    Every consumer uses DynamicResource; light-colour-dependent tokens are replaced at runtime by ThemeManager.ApplyAccent.
    M6: the v0 "Nova" keys (glass, sidebar, hover/pressed/selected, gradients, glows, ambient brushes, size doubles) are gone.
    Rule (from MonHub DESIGN.md): a token key never equals a ControlTheme/style key.
  -->

  <!-- ===== Neutrals (DESIGN 2.1) ===== -->
  <Color x:Key="RhRoomDeepColor">#0A0908</Color>
  <Color x:Key="RhBaseColor">#14120F</Color>
  <Color x:Key="RhSurfaceColor">#1E1B17</Color>
  <Color x:Key="RhSurfaceHiColor">#2A2620</Color>
  <Color x:Key="RhLineColor">#3A342B</Color>
  <Color x:Key="RhText1Color">#F4ECDF</Color>
  <Color x:Key="RhText2Color">#C9BFAF</Color>
  <Color x:Key="RhText3Color">#948A7A</Color>
  <Color x:Key="RhInkColor">#14120F</Color>

  <!-- ===== Surfaces (all opaque) ===== -->
  <SolidColorBrush x:Key="RhRoomDeepBrush" Color="#0A0908" />
  <SolidColorBrush x:Key="RhBaseBrush" Color="#14120F" />
  <SolidColorBrush x:Key="RhSurfaceBrush" Color="#1E1B17" />
  <SolidColorBrush x:Key="RhSurfaceHiBrush" Color="#2A2620" />
  <SolidColorBrush x:Key="RhPaperBrush" Color="#F4ECDF" />
  <SolidColorBrush x:Key="RhInkBrush" Color="#14120F" />
  <!-- the few allowed translucencies (DESIGN 4.6) -->
  <SolidColorBrush x:Key="RhOverlayScrimBrush" Color="#B80A0908" />
  <SolidColorBrush x:Key="RhLaunchScrimBrush" Color="#F00A0908" />

  <!-- ===== Lines ===== -->
  <SolidColorBrush x:Key="RhLineBrush" Color="#3A342B" />
  <!-- 1 px light edge: wall split, top of overlays -->
  <SolidColorBrush x:Key="RhLightEdgeBrush" Color="#17FFF3E0" />
  <!-- RhBoardLightBrush: ONE shared SolidColorBrush with a ColorTransition, added by ThemeManager (DESIGN 2.5.6) -->

  <!-- ===== Text ===== -->
  <SolidColorBrush x:Key="RhText1Brush" Color="#F4ECDF" />
  <SolidColorBrush x:Key="RhText2Brush" Color="#C9BFAF" />
  <SolidColorBrush x:Key="RhText3Brush" Color="#948A7A" />
  <SolidColorBrush x:Key="RhTextOnAccentBrush" Color="#14120F" />

  <!-- ===== Light colour / accent (replaced at runtime; solid colours only) ===== -->
  <SolidColorBrush x:Key="RhAccentBrush" Color="#FFB547" />
  <SolidColorBrush x:Key="RhAccentPressedBrush" Color="#E59A2E" />
  <SolidColorBrush x:Key="RhAccentSoftBrush" Color="#33FFB547" />
  <SolidColorBrush x:Key="RhAccentTextBrush" Color="#FFC877" />
  <!-- the only shadow: dialogs and overlays (DESIGN 4.4) -->
  <BoxShadows x:Key="RhPanelShadow">0 24 64 -16 #F0000000</BoxShadows>

  <!-- ===== States (DESIGN 2.3; always with an icon) ===== -->
  <SolidColorBrush x:Key="RhSuccessBrush" Color="#8FD694" />
  <SolidColorBrush x:Key="RhSuccessSoftBrush" Color="#2A3A2A" />
  <SolidColorBrush x:Key="RhWarningBrush" Color="#FF9A4A" />
  <SolidColorBrush x:Key="RhWarningSoftBrush" Color="#3E2E1F" />
  <SolidColorBrush x:Key="RhDangerBrush" Color="#FF6A5E" />
  <SolidColorBrush x:Key="RhDangerSoftBrush" Color="#3F2621" />
  <SolidColorBrush x:Key="RhCloseHoverBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="RhFavoriteBrush" Color="#FFD36A" />

  <!-- ===== Shape (DESIGN 4.1) ===== -->
  <CornerRadius x:Key="RhRadiusNone">0</CornerRadius>
  <CornerRadius x:Key="RhRadiusSmall">2</CornerRadius>
  <CornerRadius x:Key="RhRadiusChip">2</CornerRadius>
  <CornerRadius x:Key="RhRadiusTile">2</CornerRadius>
  <CornerRadius x:Key="RhRadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RhRadiusPanel">6</CornerRadius>
  <CornerRadius x:Key="RhRadiusPill">4</CornerRadius>
  <x:Double x:Key="RhChamferRing">6</x:Double>
  <x:Double x:Key="RhChamferPlate">4</x:Double>
  <!-- page margins: 96 px at a logical width ≥ 1600, else 56 (the shell replaces these at runtime, DESIGN 7.0) -->
  <Thickness x:Key="RhPageInset">96,24,96,48</Thickness>
  <Thickness x:Key="RhGridInset">96,48,96,64</Thickness>
  <Thickness x:Key="RhPageInsetX">96,0,96,0</Thickness>
  <!-- library (DESIGN 7.2.1): 40 px above the first row (lift, ring, the short cone); the list's left column -->
  <Thickness x:Key="RhShelfInset">96,40,96,64</Thickness>
  <Thickness x:Key="RhListInset">96,16,0,48</Thickness>

  <!-- ===== Type (DESIGN 3.1; each width in its own folder, Inter as the last fallback) ===== -->
  <FontFamily x:Key="RhFontPoster">avares://RetroHub.App/Assets/Fonts/ArchivoExpanded#Archivo Expanded, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="RhFontNumber">avares://RetroHub.App/Assets/Fonts/ArchivoSemiExpanded#Archivo SemiExpanded, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="RhFontUi">avares://RetroHub.App/Assets/Fonts/ArchivoSemiCondensed#Archivo SemiCondensed, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="RhFontSpine">avares://RetroHub.App/Assets/Fonts/ArchivoCondensed#Archivo Condensed, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="RhFontRead">avares://RetroHub.App/Assets/Fonts/Atkinson#Atkinson Hyperlegible Next, fonts:Inter#Inter</FontFamily>
  <!-- the window default: UI role -->
  <FontFamily x:Key="RhFont">avares://RetroHub.App/Assets/Fonts/ArchivoSemiCondensed#Archivo SemiCondensed, fonts:Inter#Inter</FontFamily>
  <!-- Motion tokens (DESIGN 9.1) live in Theming/Motion.cs; XAML transitions use the literal values 0.09/0.14/0.22/0.28/0.42 s. -->
</ResourceDictionary>
