<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Maps the "Fernsehlicht" tokens onto the Fluent theme's resource keys, so the few stock controls left (TextBox, scroll
    bars, tool tips) fit in. M6: no ComboBox, ToggleSwitch, Slider or ProgressBar remains in RetroHub. All opaque. Light-colour-dependent Fluent keys
    (SystemAccentColor*) are set at runtime by ThemeManager.
  -->
  <!-- text fields: Regal, 2 px light frame when focused -->
  <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextControlBackground" Color="#1A1C20" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#24272D" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1A1C20" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="#343840" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#474C55" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2FD3F5" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A0A7B2" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#ADB3BD" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A0A7B2" />
  <SolidColorBrush x:Key="TextControlButtonForeground" Color="#C3C8D1" />
  <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#F5F7FA" />
  <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>

  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>



  <!-- popups / tooltips -->
  <SolidColorBrush x:Key="ToolTipBackground" Color="#1A1C20" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#343840" />
</ResourceDictionary>
