<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Maps the "Fernsehlicht" tokens onto the Fluent theme's resource keys, so the few stock controls left (TextBox, scroll
    bars, tool tips) fit in. M6: no ComboBox, ToggleSwitch, Slider or ProgressBar remains in RetroHub. All opaque. Light-colour-dependent Fluent keys
    (SystemAccentColor*) are set at runtime by ThemeManager.
  -->
  <!-- text fields: Regal, 2 px light frame when focused -->
  <SolidColorBrush x:Key="TextControlForeground" Color="#F4ECDF" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F4ECDF" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F4ECDF" />
  <SolidColorBrush x:Key="TextControlBackground" Color="#1E1B17" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2620" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1B17" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A342B" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4A4337" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFB547" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#948A7A" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#A79D8C" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#948A7A" />
  <SolidColorBrush x:Key="TextControlButtonForeground" Color="#C9BFAF" />
  <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#F4ECDF" />
  <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>

  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>



  <!-- popups / tooltips -->
  <SolidColorBrush x:Key="ToolTipBackground" Color="#1E1B17" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="#F4ECDF" />
  <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3A342B" />
</ResourceDictionary>
