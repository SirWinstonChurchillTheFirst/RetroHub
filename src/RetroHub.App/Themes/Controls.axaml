<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:RetroHub.App.Controls"
                    xmlns:vm="using:RetroHub.App.ViewModels"
                    xmlns:l="using:RetroHub.App.Localization">
  <!--
    RetroHub control themes – "Fernsehlicht" (DESIGN 4, 8). State-dependent values live in "^:state /template/ Part"
    styles (never as template attributes), so the global motion styles (Styles.axaml) can switch transitions off.
    Focus language: objects (box, wall, primary button) get the chamfered ring and a lift; small elements INVERT
    (paper face, ink text); rows turn "Regal hell" with a side bar and a paper chip. No glow, no blur, no gradients.
    Motion: Blink 0.09 s (ring, inversion), Step 0.14 s (lift, scale).
  -->

  <!-- ================= Buttons ================= -->
  <!-- secondary: Regal hell, R 4; focus = inversion -->
  <ControlTheme x:Key="RhButton" TargetType="Button">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusControl}" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.09" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#363128" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button" BasedOn="{StaticResource RhButton}" />

  <!-- primary ("Spielen"): chamfered plate in Bernstein, ink text; focus = paper ring with a room-deep gap + 1.03 -->
  <ControlTheme x:Key="RhPrimaryButton" TargetType="Button" BasedOn="{StaticResource RhButton}">
    <Setter Property="Background" Value="{DynamicResource RhAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RhTextOnAccentBrush}" />
    <Setter Property="Padding" Value="28,0" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <c:FocusRing Name="PART_Ring" Brush="{DynamicResource RhPaperBrush}" Chamfer="6" Opacity="0" />
          <c:ChamferPlate Name="PART_Plate" Background="{TemplateBinding Background}" Chamfer="4" Depth="3" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ c|FocusRing#PART_Ring">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.09" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ c|ChamferPlate#PART_Plate">
      <Setter Property="Background" Value="{DynamicResource RhAccentTextBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ c|ChamferPlate#PART_Plate">
      <Setter Property="Background" Value="{DynamicResource RhAccentPressedBrush}" />
      <Setter Property="Depth" Value="1" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="RenderTransform" Value="scale(1.03)" />
      <Setter Property="Foreground" Value="{DynamicResource RhTextOnAccentBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:focus-visible /template/ c|FocusRing#PART_Ring">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- not startable: a visible plate with a warning outline (the full "Lösungs-Button" follows in M4) -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource RhText3Brush}" />
    </Style>
    <Style Selector="^:disabled /template/ c|ChamferPlate#PART_Plate">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
      <Setter Property="Outline" Value="{DynamicResource RhWarningBrush}" />
    </Style>
  </ControlTheme>

  <!-- text/tool button: no face; focus = inversion -->
  <ControlTheme x:Key="RhGhostButton" TargetType="Button" BasedOn="{StaticResource RhButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusSmall}" />
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="RhIconButton" TargetType="Button" BasedOn="{StaticResource RhGhostButton}">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </ControlTheme>

  <ControlTheme x:Key="RhDangerButton" TargetType="Button" BasedOn="{StaticResource RhButton}">
    <Setter Property="Background" Value="{DynamicResource RhDangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RhDangerBrush}" />
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4E2E27" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
  </ControlTheme>


  <!-- ticker entry (DESIGN 7.2.1, 8.2): no face of its own; the content (code chip, count, underline) is styled by the
       page. Focus = inversion of the code chip only, the underline stays. -->
  <ControlTheme x:Key="RhTickerItem" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <!-- as a link (Lieferschein spine, Gerätefach segment, R2): pulled up under the pointer, pressed back down -->
    <Style Selector="^.game-link, ^.segment">
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^.game-link:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-4px)" />
    </Style>
    <Style Selector="^.segment:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>
    <Style Selector="^.game-link:pressed, ^.segment:pressed">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
  </ControlTheme>

  <!-- footer hint as a mouse target (R2): no face; hover lights the glyph (ButtonGlyph.Hot) and draws a 1 px line in
       Text 3 under the hint, press presses it in (0.97). Never focusable: the controller focus stays on the page. -->
  <ControlTheme x:Key="RhHintButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" /></Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" VerticalContentAlignment="Center" />
          <Border Name="PART_Under" Height="1" VerticalAlignment="Bottom" Margin="6,0,6,6" Background="{DynamicResource RhText3Brush}"
                  Opacity="0" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Under">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
  </ControlTheme>

  <!-- the footer's section word ("Bibliothek ›") as a way up: Text 3, on hover Text 1 with a 1 px underline in Text 3 -->
  <ControlTheme x:Key="RhCrumbButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText3Brush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                            VerticalContentAlignment="Center" />
          <Border Name="PART_Under" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,7" Background="{DynamicResource RhText3Brush}"
                  Opacity="0" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Under">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <!-- ================= Header channels ("1 Start  2 Bibliothek  3 Konsolen") ================= -->
  <ControlTheme x:Key="RhChannel" TargetType="Button">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Bg" CornerRadius="2" Background="{TemplateBinding Background}" />
          <ContentPresenter Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <!-- channel mark (12 × 3) under the digit, below the baseline -->
          <Border Name="PART_Mark" Width="12" Height="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,4"
                  Background="{DynamicResource RhAccentBrush}" Opacity="0" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Border#PART_Bg">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.09" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^.selected">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^.selected /template/ Border#PART_Mark">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
  </ControlTheme>

  <!-- ================= Caption buttons (own min/max/close, OS frame kept) ================= -->
  <ControlTheme x:Key="RhCaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" Background="{TemplateBinding Background}">
          <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Width="10" Height="10"
                Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="RhCaptionClose" TargetType="Button" BasedOn="{StaticResource RhCaptionButton}">
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhCloseHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
  </ControlTheme>

  <!-- ================= Game box ("Schachtel") ================= -->
  <!-- The tile draws no focus visuals: the grid's/shelf's FocusLayer draws cone, board piece and ring; the board
       (shelf edge) is drawn by the row. The cover area lifts from the bottom centre (1.06, Step). -->
  <ControlTheme x:Key="{x:Type c:GameTile}" TargetType="c:GameTile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate x:DataType="vm:GameItemViewModel">
        <Grid RowDefinitions="*,Auto" Background="Transparent">
          <Panel Name="PART_CoverArea" RenderTransformOrigin="50%,100%" RenderTransform="scale(1)">
            <c:CoverArt Name="PART_Art" Source="{Binding CoverPath}" Title="{Binding Title}" Badge="{Binding SystemShort}"
                        SystemId="{Binding SystemId}" Accent="{Binding Accent}" IsFavorite="{Binding IsFavorite}" IsMissing="{Binding IsMissing}"
                        ShowFavorite="{TemplateBinding ShowFavorite}" SlotFormat="{TemplateBinding PlaceholderFormat}" Year="{Binding YearText}" />
            <!-- the sticker "Neu" (library only): over the box's top left corner, lifts with the box -->
            <c:NewSticker Name="PART_New" IsVisible="{TemplateBinding ShowSticker}" IsNew="{Binding IsNew}" />
          </Panel>
          <!-- caption: 12 px below the 12 px shelf edge, in a fixed 66 px slot (the row pitch stays regular): a fixed
               42 px title block (max. 2 lines) and 4 px under it the label line – every box of a row, placeholders
               included, has its title and its label line on the same lines (M3 QA: one baseline grid per row). On the
               system page the code and the bar drop out (.in-system); in the library's compartment only the code
               (.no-code). -->
          <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="4" Height="66" IsVisible="{TemplateBinding ShowCaption}">
            <c:TailCaption Name="PART_Title" Classes="caption" Source="{Binding WrapCaption}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                           Height="42" />

            <!-- label line: bar, code, the variant where a namesake stands in the same list ("Englisch" / "Japan"), year -->
            <StackPanel Orientation="Horizontal" Spacing="8" Height="20" ClipToBounds="True">
              <Border Name="PART_Bar" Width="3" Height="14" Background="{Binding SystemColorBrush}" VerticalAlignment="Center" />
              <TextBlock Name="PART_Code" Classes="label" Text="{Binding SystemShort}" VerticalAlignment="Center" />
              <TextBlock Name="PART_Variant" Classes="label" Text="{Binding Variant}" VerticalAlignment="Center"
                         IsVisible="{Binding Variant, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="number" FontSize="15" Foreground="{DynamicResource RhText3Brush}" Text="{Binding YearText}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Panel#PART_CoverArea">
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <!-- mouse hover (R2): the box comes 3 % forward, the ring at 40 % (FocusLayer); focus (1.06) and press win -->
    <Style Selector="^:pointerover /template/ Panel#PART_CoverArea">
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Panel#PART_CoverArea">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="^:focus-visible /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^:pointerover /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^:pressed /template/ Panel#PART_CoverArea">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <!-- system context (system page): the whole page is that system – only the year remains in the label line -->
    <Style Selector="^.in-system /template/ Border#PART_Bar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.in-system /template/ TextBlock#PART_Code">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- the library filtered to one system (DESIGN 7.2.1): the code drops out, bar, variant and year stay -->
    <Style Selector="^.no-code /template/ TextBlock#PART_Code">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- …and with neither variant nor year the line stays empty (its 20 px are kept): no lone colour bar -->
    <Style Selector="^.no-code.bare /template/ Border#PART_Bar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <!-- list row (same GameTile class, so clicks/favourites work identically): bar, title, code, star; focus = light
       row, 8 px bar, light edge, title in a paper chip – never a full-width paper bar -->
  <ControlTheme x:Key="RhGameRow" TargetType="c:GameTile">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Height" Value="64" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate x:DataType="vm:GameItemViewModel">
        <Panel>
          <Border Name="PART_Bg" Background="{TemplateBinding Background}" />
          <Border Name="PART_Edge" Height="1" VerticalAlignment="Top" Background="{DynamicResource RhLightEdgeBrush}" Opacity="0" />
          <c:Groove VerticalAlignment="Bottom" />
          <Border Name="PART_Bar" Width="4" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding SystemColorBrush}" />
          <Grid ColumnDefinitions="*,Auto,40" Margin="24,0,16,0">
            <Border Name="PART_Chip" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,4" CornerRadius="2" Background="Transparent" Margin="-8,0,0,0">
              <!-- no class "ui-l": an app-level class style would win over the focus style below (paper on paper) -->
              <!-- a title wider than the column keeps its head AND its tail ("BS The Legend of Zelda – …Kapitel 1"):
                   namesakes differ at the end (M3 QA), until the marquee exists -->
              <TextBlock Name="PART_Title" Text="{Binding Caption}" TextTrimming="{Binding Caption, Converter={x:Static c:TitleTrimming.Converter}}" FontFamily="{DynamicResource RhFontUi}"
                         FontWeight="Medium" FontSize="20" LineHeight="26" Foreground="{DynamicResource RhText1Brush}" />
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="24,0,0,0">
              <TextBlock Classes="label" Text="{Binding Variant}" IsVisible="{Binding Variant, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="label" Text="{Binding SystemShort}" />
            </StackPanel>
            <c:RhIcon Grid.Column="2" Data="{DynamicResource Icon.Star}" Filled="True" Width="18" Height="18" IsVisible="{Binding IsFavorite}"
                      Foreground="{DynamicResource RhFavoriteBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Edge">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bar">
      <Setter Property="Width" Value="8" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Chip">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
  </ControlTheme>


  <!-- the solution button (DESIGN 7.3 "Spielen nicht möglich"): a chamfered plate in Regal hell with a 2 px warning
       contour, Icon.Warning and the way out ("Emulator einrichten"); focus = the paper ring like the primary plate -->
  <ControlTheme x:Key="RhSolutionButton" TargetType="Button" BasedOn="{StaticResource RhPrimaryButton}">
    <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Style Selector="^ /template/ c|ChamferPlate#PART_Plate">
      <Setter Property="Outline" Value="{DynamicResource RhWarningBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ c|ChamferPlate#PART_Plate">
      <Setter Property="Background" Value="#363128" />
    </Style>
    <Style Selector="^:pressed /template/ c|ChamferPlate#PART_Plate">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceBrush}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
  </ControlTheme>

  <!-- ================= Detail (DESIGN 7.3, M4) ================= -->
  <!-- the box pulled from the shelf: the generated spine (left) and the cover stand in ONE lift panel, so the box lifts
       as one object; the page's FocusLayer draws cone, lit board piece and the standing ring around spine + front.
       The placeholder prints no band on its front: the spine is the box's real side. -->
  <ControlTheme x:Key="RhPulledBox" TargetType="c:GameTile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate x:DataType="vm:GameItemViewModel">
        <Panel Name="PART_CoverArea" Background="Transparent" RenderTransformOrigin="50%,100%" RenderTransform="scale(1)">
          <c:CoverArt Name="PART_Art" Margin="{TemplateBinding Padding}" Source="{Binding CoverPath}" Title="{Binding Title}" Badge="{Binding SystemShort}"
                      SystemId="{Binding SystemId}" Accent="{Binding Accent}" IsMissing="{Binding IsMissing}" ShowFavorite="False" PrintedSpine="False"
                      Year="{Binding YearText}" />
          <c:BoxSpine Name="PART_Spine" Title="{Binding Title}" Code="{Binding SystemShort}" Year="{Binding YearText}"
                      SystemId="{Binding SystemId}" Accent="{Binding Accent}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Panel#PART_CoverArea">
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Panel#PART_CoverArea">
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Panel#PART_CoverArea">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="^:pressed /template/ Panel#PART_CoverArea">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
  </ControlTheme>

  <!-- a value row that opens something (the file row of "Start"): label 200 in Text 3, value, arrow; focus like the
       choice rows (Regal hell, 8 px bar, light edge, label in a paper chip) -->
  <ControlTheme x:Key="RhInfoRow" TargetType="Button">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Bg" Background="{TemplateBinding Background}" />
          <Border Name="PART_Edge" Height="1" VerticalAlignment="Top" Background="{DynamicResource RhLightEdgeBrush}" Opacity="0" />
          <c:Groove VerticalAlignment="Bottom" />
          <Border Name="PART_Bar" Width="8" HorizontalAlignment="Left" Background="{DynamicResource RhAccentBrush}" Opacity="0" />
          <Grid ColumnDefinitions="200,*,Auto" Margin="16,0,16,0">
            <Border Name="PART_Chip" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,4" CornerRadius="2" Margin="-8,0,0,0" Background="Transparent">
              <TextBlock Name="PART_Label" Text="{TemplateBinding Tag}" Foreground="{DynamicResource RhText3Brush}" />
            </Border>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" Margin="0,0,16,0" />
            <!-- the "Winkel": the chamfered chevron, 16 px, Text 3 (Papier on focus) - not a filled media triangle (M4 QA) -->
            <c:RhIcon Grid.Column="2" Name="PART_Arrow" Data="{DynamicResource Icon.ChevronRight}" Width="16" Height="16" StrokeThickness="3" VerticalAlignment="Center"
                      Foreground="{DynamicResource RhText3Brush}" />
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Edge">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Chip">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ c|RhIcon#PART_Arrow">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
  </ControlTheme>

  <!-- an action row of an overlay ("Cover wählen…", "Dateiinfo"): icon + text, 56 px, focus like a row -->
  <ControlTheme x:Key="RhSheetRow" TargetType="Button">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Bg" Background="{TemplateBinding Background}" />
          <Border Name="PART_Edge" Height="1" VerticalAlignment="Top" Background="{DynamicResource RhLightEdgeBrush}" Opacity="0" />
          <Border Name="PART_Bar" Width="8" HorizontalAlignment="Left" Background="{DynamicResource RhAccentBrush}" Opacity="0" />
          <Border Name="PART_Chip" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,4" CornerRadius="2" Margin="20,0,0,0" Background="Transparent">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Edge">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Chip">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
  </ControlTheme>

  <!-- ================= Service menu (DESIGN 7.6) ================= -->
  <!-- A row of the service menu: label in ui-l Papier (one meta line under it), the value right between two filled
       arrows in a fixed 320 px column (the values of a section stand on one axis, like a TV's service menu), or an
       action ("Öffnen ›"). No toggle switch, no slider, no segment control. Focus = the row language of 8.2: Regal hell,
       8 px Bernstein bar, 1 px light edge, the label in a paper chip; the arrows turn Papier. An arrow at the end of an
       ordered row stays dim. -->
  <ControlTheme x:Key="{x:Type c:ServiceRow}" TargetType="c:ServiceRow">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate x:DataType="vm:ServiceSetting">
        <Panel>
          <Border Name="PART_Bg" Background="{TemplateBinding Background}" />
          <Border Name="PART_Edge" Height="1" VerticalAlignment="Top" Background="{DynamicResource RhLightEdgeBrush}" Opacity="0" />
          <c:Groove VerticalAlignment="Bottom" />
          <Border Name="PART_Bar" Width="8" HorizontalAlignment="Left" Background="{DynamicResource RhAccentBrush}" Opacity="0" />
          <Grid Name="PART_Columns" ColumnDefinitions="Auto,*,392" Margin="24,0,8,0">
            <!-- the service-menu number "01" … (Rücken 17, Text 3); the label follows 48 px further on -->
            <TextBlock Name="PART_Number" Text="{Binding Number}" IsVisible="{Binding HasNumber}" Width="44" VerticalAlignment="Center"
                       FontFamily="{DynamicResource RhFontSpine}" FontWeight="Bold" FontSize="17" LineHeight="20" LetterSpacing="0.7"
                       Foreground="{DynamicResource RhText3Brush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,10,24,10">
              <Border Name="PART_Chip" HorizontalAlignment="Left" Padding="8,2" CornerRadius="2" Margin="-8,0,0,0" Background="Transparent">
                <TextBlock Name="PART_Label" Text="{Binding Label}" FontFamily="{DynamicResource RhFontUi}" FontWeight="Medium" FontSize="20" LineHeight="26"
                           Foreground="{DynamicResource RhText1Brush}" />
              </Border>
              <TextBlock Name="PART_Hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" FontFamily="{DynamicResource RhFontRead}" FontSize="15" LineHeight="20"
                         Foreground="{DynamicResource RhText3Brush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- ◀ value ▶ : filled triangles 12 × 20, 12 px outside a 320-wide value column (QA 2: the "display window"
                 only for the focused row – unfocused rows carry no fill and no border, the value in Zahl 20 Papier 85 %,
                 the arrows Text 3 at 40 %; focused: Raum-Tief, 1 px Kante, 2 px top edge in the light colour, arrows
                 Papier – the one lit display of the list, as on a TV's OSD). A fixed value ("Immer aktiv") is plain Text 2. -->
            <Grid Name="PART_Value" Grid.Column="2" ColumnDefinitions="36,320,36" IsVisible="{Binding IsChoice}" VerticalAlignment="Stretch" HorizontalAlignment="Center">
              <Border Name="PART_Previous" Background="Transparent" Cursor="Hand" IsVisible="{Binding !IsFixed}">
                <Panel>
                  <!-- a small rocker key under the arrow (M7): shown with the focused row's display window -->
                  <c:KeyCap Name="PART_PrevKey" Width="26" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Opacity="0" />
                  <Path Name="PART_PrevIcon" Data="M12,0 L12,20 L0,10 Z" Width="12" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,2"
                        Fill="{DynamicResource RhText3Brush}" Classes.end="{Binding !CanPrevious}" />
                </Panel>
              </Border>
              <Border Name="PART_Window" Grid.Column="1" Height="40" VerticalAlignment="Center" Background="Transparent"
                      BorderBrush="Transparent" BorderThickness="1" CornerRadius="0" Classes.fixed="{Binding IsFixed}">
                <Panel>
                  <!-- the window is set into the bench: inner shadow, light lower edge, a faint reflection (M7) -->
                  <c:WindowGlass Name="PART_Glass" Opacity="0" />
                  <Border Name="PART_WindowEdge" Height="2" VerticalAlignment="Top" Background="{DynamicResource RhAccentBrush}" Opacity="0" />
                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="16" Height="16" Background="{Binding Swatch}" IsVisible="{Binding HasSwatch}" VerticalAlignment="Center" />
                    <TextBlock Name="PART_ValueText" Text="{Binding ValueText}" Classes="number" Classes.fixed="{Binding IsFixed}" FontSize="20" LineHeight="24"
                               Foreground="{DynamicResource RhText1Brush}" Opacity="0.85" VerticalAlignment="Center" />
                  </StackPanel>
                </Panel>
              </Border>
              <Border Name="PART_Next" Grid.Column="2" Background="Transparent" Cursor="Hand" IsVisible="{Binding !IsFixed}">
                <Panel>
                  <c:KeyCap Name="PART_NextKey" Width="26" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" Opacity="0" />
                  <Path Name="PART_NextIcon" Data="M0,0 L0,20 L12,10 Z" Width="12" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,2"
                        Fill="{DynamicResource RhText3Brush}" Classes.end="{Binding !CanNext}" />
                </Panel>
              </Border>
            </Grid>
            <!-- action: "Öffnen ›" right-aligned on the arrows' outer edge -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        IsVisible="{Binding IsAction}">
              <TextBlock Name="PART_ActionText" Text="{Binding ActionText}" FontFamily="{DynamicResource RhFontUi}" FontWeight="SemiBold" FontSize="18" LineHeight="22"
                         LetterSpacing="0.3" Foreground="{DynamicResource RhText2Brush}" VerticalAlignment="Center" />
              <c:RhIcon Name="PART_Chevron" Data="{DynamicResource Icon.ChevronRight}" Width="16" Height="16" StrokeThickness="3" Foreground="{DynamicResource RhText3Brush}"
                        VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- unfocused: the arrows recede (Text 3 at 40 %); the end of an ordered row even further -->
    <Style Selector="^ /template/ Path">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^ /template/ Path.end">
      <Setter Property="Opacity" Value="0.15" />
    </Style>
    <Style Selector="^:focus-visible /template/ Path, ^.open /template/ Path">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Path.end, ^.open /template/ Path.end">
      <Setter Property="Opacity" Value="0.3" />
    </Style>
    <!-- the focused row's display window (not for a fixed value) -->
    <Style Selector="^:focus-visible /template/ Border#PART_Window, ^.open /template/ Border#PART_Window">
      <Setter Property="Background" Value="{DynamicResource RhRoomDeepBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RhLineBrush}" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Window.fixed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:focus-visible /template/ TextBlock#PART_ValueText, ^.open /template/ TextBlock#PART_ValueText">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_ValueText.fixed">
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceBrush}" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Previous:pointerover Path, ^ /template/ Border#PART_Next:pointerover Path">
      <Setter Property="Fill" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <!-- the arrow clicked (R2): accent, the key goes down onto its edge for 90 ms -->
    <Style Selector="^ /template/ Border#PART_Previous.pressed Path, ^ /template/ Border#PART_Next.pressed Path">
      <Setter Property="Fill" Value="{DynamicResource RhAccentBrush}" />
      <Setter Property="RenderTransform" Value="translate(0px, 2px) scale(0.9)" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Previous.pressed c|KeyCap, ^ /template/ Border#PART_Next.pressed c|KeyCap">
      <Setter Property="Pressed" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ c|KeyCap, ^.open /template/ c|KeyCap, ^ /template/ Border#PART_Previous:pointerover c|KeyCap, ^ /template/ Border#PART_Next:pointerover c|KeyCap">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ c|WindowGlass, ^.open /template/ c|WindowGlass">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Window.fixed c|WindowGlass">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:focus-visible /template/ Path">
      <Setter Property="Fill" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_WindowEdge, ^.open /template/ Border#PART_WindowEdge">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Window.fixed Border#PART_WindowEdge">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- a row whose list is folded open under it (Importe "Mehr") keeps its focus look while the focus is in the list -->
    <Style Selector="^.open /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^.open /template/ Border#PART_Edge, ^.open /template/ Border#PART_Bar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^.open /template/ Border#PART_Chip">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
    <Style Selector="^.open /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Edge">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Chip">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ c|RhIcon">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ TextBlock#PART_ActionText">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
  </ControlTheme>

  <!-- a row that folds open (DESIGN 7.6 Emulatoren: one row per system): the header is this button; the fold below it
       belongs to the page. Same focus language as every row (8.2); the bar takes the system's colour (Tag = brush). -->
  <ControlTheme x:Key="RhFoldRow" TargetType="Button">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Bg" Background="{TemplateBinding Background}" />
          <Border Name="PART_Edge" Height="1" VerticalAlignment="Top" Background="{DynamicResource RhLightEdgeBrush}" Opacity="0" />
          <Border Name="PART_Bar" Width="8" HorizontalAlignment="Left" Background="{DynamicResource RhAccentBrush}" Opacity="0" />
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="0" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Edge">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- a row that brings its own bar (the system's colour band of an emulator row grows to the full height instead) -->
    <Style Selector="^.own-bar:focus-visible /template/ Border#PART_Bar">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- the content's own parts (band, label chip, chevron) are styled in Styles.axaml (Button.fold-row …): a control
         theme may not reach into its content -->
  </ControlTheme>

  <!-- a screen on the back (title screen, snap): the set stands on a shelf edge; focus = the standing ring in the light
       colour around the set and a lift of 1.03 from its foot (an object, DESIGN 8.2) -->
  <ControlTheme x:Key="RhScreenButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Lift" RenderTransformOrigin="50%,100%" RenderTransform="scale(1)" Background="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          <c:FocusRing Name="PART_Ring" Brush="{DynamicResource RhAccentBrush}" Standing="True" Opacity="0" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Panel#PART_Lift">
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ c|FocusRing#PART_Ring">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.09" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ c|FocusRing#PART_Ring">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^:focus-visible /template/ Panel#PART_Lift">
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="^:focus-visible /template/ c|FocusRing#PART_Ring">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>


  <!-- toggle (e.g. "Favoriten" filter): checked = favourite yellow; focus = inversion -->
  <ControlTheme x:Key="RhToggleChip" TargetType="ToggleButton">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusSmall}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource RhFavoriteBrush}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
  </ControlTheme>

  <!-- the "Alle anzeigen" spine (DESIGN 7.1): 72 wide, Regal hell, 8 px Bernstein band, text −90° in Rücken 18;
       focus = the chamfered ring in paper (like the primary plate) -->
  <ControlTheme x:Key="RhSpineButton" TargetType="Button">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Width" Value="72" />
    <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="RenderTransformOrigin" Value="50%,100%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- a drawn box like the system spines beside it: printed band, curvature, edges, side and top faces (M7) -->
          <c:BoxFace Name="PART_Face" Fill="{TemplateBinding Background}" Band="{DynamicResource RhAccentBrush}" />
          <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="-90" />
            </LayoutTransformControl.LayoutTransform>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              FontFamily="{DynamicResource RhFontSpine}" FontWeight="Bold" FontSize="18" />
          </LayoutTransformControl>
          <c:FocusRing Name="PART_Ring" Brush="{DynamicResource RhPaperBrush}" Opacity="0" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ c|FocusRing#PART_Ring">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.09" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ c|BoxFace#PART_Face">
      <Setter Property="Fill" Value="#363128" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="^:focus-visible /template/ c|FocusRing#PART_Ring">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <!-- ================= Shelf (a board with boxes and a paper label) ================= -->
  <!-- No "Alle anzeigen ›" link (DESIGN 1.3): the way into the library is a spine standing at the end of the board. -->
  <!-- The board and the label stay; only the track (boxes + focus layers) glides to the horizontal anchor. The label is
       drawn above the track, so a lit board piece never covers it. -->
  <ControlTheme x:Key="{x:Type c:Shelf}" TargetType="c:Shelf">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- transparent ground: the whole shelf (gaps and board too) keeps the pointer, so the wheel and the plates
             do not drop out between two boxes (R2) -->
        <Grid Name="PART_Host" RowDefinitions="Auto,24,4" Background="Transparent">
          <c:ShelfBoard Grid.Row="1" Height="24" WallLook="{TemplateBinding BoardLook}" />
          <c:ShelfTrack Name="PART_Track" Grid.RowSpan="3" Margin="{TemplateBinding ItemsMargin}">
            <StackPanel Name="PART_Row" Orientation="Horizontal" Spacing="{TemplateBinding ItemSpacing}" VerticalAlignment="Top"
                        HorizontalAlignment="Left" Height="{TemplateBinding ItemHeight}">
              <!-- ClipToBounds off (the Fluent theme clips ItemsControl): the lifted box (×1.06) and the ring of a focused
                   front rise above the row; only the shelf viewport clips -->
              <ItemsControl Name="PART_Items" ItemsSource="{TemplateBinding ItemsSource}" ItemTemplate="{TemplateBinding ItemTemplate}" VerticalAlignment="Bottom"
                            ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="{Binding $parent[c:Shelf].ItemSpacing}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <c:Bookend IsVisible="{TemplateBinding Bookend}" Height="{TemplateBinding ItemHeight}" VerticalAlignment="Bottom" />
              <Button Name="PART_AllSpine" Theme="{StaticResource RhSpineButton}" Content="{TemplateBinding ActionLabel}" Command="{TemplateBinding ActionCommand}"
                      Height="{TemplateBinding ItemHeight}" VerticalAlignment="Bottom"
                      IsVisible="{TemplateBinding ActionLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </c:ShelfTrack>
          <Border Grid.Row="0" Height="{TemplateBinding ItemHeight}" IsHitTestVisible="False" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top" Margin="{TemplateBinding LabelMargin}" IsHitTestVisible="False"
                      IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <c:ShelfLabel Text="{TemplateBinding Header}" Height="24" />
            <TextBlock Text="{TemplateBinding SubHeader}" Classes="meta" VerticalAlignment="Center" />
          </StackPanel>
          <!-- mouse: two "Winkel" plates at the board's right end (R2), shown while the pointer is over an overflowing row -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
            <c:ShelfEdge Name="PART_EdgeLeft" Direction="-1" />
            <c:ShelfEdge Name="PART_EdgeRight" Direction="1" />
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
