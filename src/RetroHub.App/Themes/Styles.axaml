<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:RetroHub.App.Controls">
  <!-- Global styles: window defaults, surfaces, input fields, motion levels (.motion-*, .nav-repeat on the shell root). -->
  <StyleInclude Source="avares://RetroHub.App/Themes/Typography.axaml" />

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource RhFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="Background" Value="{DynamicResource RhBaseBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <!-- ===== Surfaces (opaque; no cards in cards – DESIGN 4.3) ===== -->
  <!-- etikett = the paper label of DESIGN 1.2 as a plain border (demo mode in the header): paper, ink, 15, 8 × 3, R 0 -->
  <Style Selector="Border.etikett">
    <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.etikett > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource RhLineBrush}" />
  </Style>

  <!-- ===== Text fields: Regal, 2 px Bernstein frame when focused (DESIGN 8.2) ===== -->
  <Style Selector="TextBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource RhAccentSoftBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource RhAccentBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusControl}" />
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="2,0,12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="InnerLeftContent">
      <Template>
        <c:RhIcon Data="{DynamicResource Icon.Search}" Width="20" Height="20" Margin="14,0,8,0" Foreground="{DynamicResource RhText3Brush}" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <!-- scroll bars: a 2 px edge-coloured thumb without a track, visible only while scrolling (class "scrolling", set by
       the shell for 900 ms after each scroll) or under the mouse -->
  <Style Selector="ScrollViewer /template/ ScrollBar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.14" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer.scrolling /template/ ScrollBar, ScrollViewer /template/ ScrollBar:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource RhLineBrush}" />
  </Style>

  <!-- ===== Rows that fold open (RhFoldRow + class "fold-row", DESIGN 7.6, 8.2) ===== -->
  <!-- the system's colour band grows to the full row height; the label turns into a paper chip; the chevron Papier -->
  <Style Selector="Button.fold-row Border.row-band">
    <Setter Property="Margin" Value="0,12" />
  </Style>
  <Style Selector="Button.fold-row:focus-visible Border.row-band">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Button.fold-row:focus-visible Border.row-chip">
    <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
  </Style>
  <Style Selector="Button.fold-row:focus-visible Border.row-chip > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
  </Style>
  <Style Selector="Button.fold-row:focus-visible c|RhIcon.row-chevron">
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
  </Style>

  <!-- ===== Motion levels (classes on the shell root) ===== -->
  <Style Selector=".motion-off Button, .motion-off ToggleButton, .motion-off c|GameTile">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector=".motion-off Button /template/ :is(Control), .motion-off ToggleButton /template/ :is(Control), .motion-off c|GameTile /template/ :is(Control)">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <!-- reduced: no lift, no scaling (DESIGN 9.4) -->
  <Style Selector=".motion-reduced c|GameTile /template/ Panel#PART_CoverArea, .motion-off c|GameTile /template/ Panel#PART_CoverArea">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector=".motion-reduced Button:focus-visible, .motion-off Button:focus-visible">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <!-- auto-repeat: the lift jumps (no transition), the ring jumps along (DESIGN 8.4) -->
  <Style Selector=".nav-repeat c|GameTile /template/ Panel#PART_CoverArea, .nav-repeat Button">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
</Styles>
