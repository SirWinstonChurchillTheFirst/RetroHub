<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:RetroHub.App.Controls">
  <!-- Global styles: window defaults, surfaces, input fields, motion levels (.motion-*, .nav-repeat on the shell root). -->
  <StyleInclude Source="avares://RetroHub.App/Themes/Typography.axaml" />

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource RhFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    <Setter Property="Background" Value="{DynamicResource RhBaseBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <!-- ===== Surfaces (opaque; no cards in cards – DESIGN 4.3) ===== -->
  <!-- "glass"/"card" are legacy class names: flat, opaque shelf surfaces now (removed in M6) -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource RhSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RhLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusPanel}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource RhSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RhLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusNone}" />
  </Style>
  <!-- chip = paper label ("Etikett"): paper, ink, square -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusSmall}" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
  </Style>
  <Style Selector="Border.chip.ok">
    <Setter Property="Background" Value="{DynamicResource RhSuccessSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.ok > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RhSuccessBrush}" />
  </Style>
  <Style Selector="Border.chip.warn">
    <Setter Property="Background" Value="{DynamicResource RhWarningSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.warn > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RhWarningBrush}" />
  </Style>
  <Style Selector="Border.chip.bad">
    <Setter Property="Background" Value="{DynamicResource RhDangerSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.bad > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RhDangerBrush}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource RhLineBrush}" />
  </Style>

  <!-- ===== Text fields: Regal, 2 px Bernstein frame when focused (DESIGN 8.2) ===== -->
  <Style Selector="TextBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource RhAccentSoftBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource RhAccentBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusControl}" />
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="2,0,12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="InnerLeftContent">
      <Template>
        <c:RhIcon Data="{DynamicResource Icon.Search}" Width="20" Height="20" Margin="14,0,8,0" Foreground="{DynamicResource RhText3Brush}" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="{DynamicResource RhRadiusControl}" />
    <Setter Property="Padding" Value="14,0,10,0" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <!-- choice fields (replaced by service-menu rows in M6): a 2 px paper frame when focused -->
  <Style Selector="ComboBox:focus-visible /template/ Border#Background, ComboBox:focus /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource RhPaperBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground, ComboBox:focus /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="ToggleSwitch:focus-visible /template/ Border#OuterBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource RhPaperBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Slider:focus-visible /template/ Thumb">
    <Setter Property="BorderBrush" Value="{DynamicResource RhPaperBrush}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource RhAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <!-- scroll bars: a 2 px edge-coloured thumb without a track, visible only while scrolling (class "scrolling", set by
       the shell for 900 ms after each scroll) or under the mouse -->
  <Style Selector="ScrollViewer /template/ ScrollBar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.14" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer.scrolling /template/ ScrollBar, ScrollViewer /template/ ScrollBar:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource RhLineBrush}" />
  </Style>

  <!-- ===== Motion levels (classes on the shell root) ===== -->
  <Style Selector=".motion-off Button, .motion-off ToggleButton, .motion-off c|GameTile, .motion-off c|SystemCard">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector=".motion-off Button /template/ :is(Control), .motion-off ToggleButton /template/ :is(Control), .motion-off c|GameTile /template/ :is(Control), .motion-off c|SystemCard /template/ :is(Control)">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <!-- reduced: no lift, no scaling (DESIGN 9.4) -->
  <Style Selector=".motion-reduced c|GameTile /template/ Panel#PART_CoverArea, .motion-off c|GameTile /template/ Panel#PART_CoverArea">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector=".motion-reduced c|SystemCard:focus-visible, .motion-reduced Button:focus-visible, .motion-off c|SystemCard:focus-visible, .motion-off Button:focus-visible">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <!-- auto-repeat: the lift jumps (no transition), the ring jumps along (DESIGN 8.4) -->
  <Style Selector=".nav-repeat c|GameTile /template/ Panel#PART_CoverArea, .nav-repeat c|SystemCard, .nav-repeat Button">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
</Styles>
