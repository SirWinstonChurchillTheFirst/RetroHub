<Project Sdk="Microsoft.NET.Sdk">
  <!-- RetroHub.App: the Avalonia desktop UI (shell, pages, theme, controller navigation, game embedding host). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RetroHub.App</AssemblyName>
    <RootNamespace>RetroHub.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RetroHub.Core\RetroHub.Core.csproj" />
    <ProjectReference Include="..\RetroHub.Input\RetroHub.Input.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RetroHub.App.Tests" />
  </ItemGroup>
</Project>
