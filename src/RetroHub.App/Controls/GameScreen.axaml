<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroHub.App.ViewModels"
             xmlns:c="using:RetroHub.App.Controls"
             xmlns:l="using:RetroHub.App.Localization"
             x:Class="RetroHub.App.Controls.GameScreen"
             x:DataType="vm:LaunchCoordinator"
             Focusable="True">
  <!--
    The embedded game: a bar with title, emulator, elapsed time and Vollbild / Eigenes Fenster / Beenden – ABOVE the
    native host (airspace: Avalonia cannot draw over the emulator's window), then the place for the emulator window,
    sized to the picture and centred. While the emulator loads, the host is masked and the loading view behind it shows.
  -->
  <UserControl.Styles>
    <Style Selector="Button.bar">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bar.narrow TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Grid Name="Root" RowDefinitions="Auto,*" Background="Transparent">
    <Border Name="Bar" Height="64" Padding="28,0,152,0" Background="{DynamicResource RhLaunchScrimBrush}" BorderBrush="{DynamicResource RhLineBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="34" Height="46" CornerRadius="{DynamicResource RhRadiusSmall}" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,14,0">
          <c:CoverArt Source="{Binding Game.CoverPath}" Title="{Binding Game.Title}" SystemId="{Binding Game.SystemId}" Accent="{Binding Game.Accent}" Fill="True" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
          <TextBlock Name="TitleText" Text="{Binding Game.Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="meta" FontSize="15" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding EmulatorName}" /><Run Text=", " /><Run Text="{Binding ElapsedText}" /><Run Text="   " /><Run Text="{Binding StatusNote}" Foreground="{DynamicResource RhWarningBrush}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="FullscreenButton" Classes="bar" ToolTip.Tip="{l:T gamescreen.fullscreen.tip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:RhIcon Data="{StaticResource Icon.Fullscreen}" Width="16" Height="16" />
              <TextBlock Name="FullscreenText" Text="{l:T gamescreen.fullscreen}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="OwnWindowButton" Classes="bar" ToolTip.Tip="{l:T gamescreen.ownWindow.tip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:RhIcon Data="{StaticResource Icon.External}" Width="16" Height="16" />
              <TextBlock Text="{l:T gamescreen.ownWindow}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="QuitButton" Classes="bar" Theme="{StaticResource RhDangerButton}" Command="{Binding StopCommand}" ToolTip.Tip="{l:T gamescreen.quit.tip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:RhIcon Data="{StaticResource Icon.Stop}" Width="16" Height="16" />
              <TextBlock Text="{l:T gamescreen.quit}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Panel Name="Area" Grid.Row="1" Margin="24,20,24,24">
      <!-- behind the (masked) host while the emulator loads -->
      <StackPanel Name="LoadingView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" IsVisible="False">
        <Border Width="150" Height="210" CornerRadius="{DynamicResource RhRadiusControl}" ClipToBounds="True" HorizontalAlignment="Center" >
          <c:CoverArt Source="{Binding Game.CoverPath}" Title="{Binding Game.Title}" Badge="{Binding Game.SystemShort}" SystemId="{Binding Game.SystemId}" Accent="{Binding Game.Accent}" />
        </Border>
        <TextBlock Name="LoadingTitle" Classes="h2" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,28,0,6" MaxWidth="640" TextWrapping="Wrap" />
        <TextBlock Name="LoadingNote" Classes="meta" HorizontalAlignment="Center" TextAlignment="Center" MinWidth="260" />
        <ProgressBar Name="LoadingBar" IsIndeterminate="True" Width="200" Margin="0,22,0,0" HorizontalAlignment="Center" />
      </StackPanel>
      <c:GameScreenHost Name="Host" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
  </Grid>
</UserControl>
