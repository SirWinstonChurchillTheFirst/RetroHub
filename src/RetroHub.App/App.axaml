<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RetroHub.App.App"
             RequestedThemeVariant="Dark">
  <!-- Fluent as the base for stock controls, then RetroHub's own tokens + control themes ("Fernsehlicht"). -->
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#2FD3F5" RegionColor="#0B0C0E" ErrorText="#FF6A5E"
                               AltHigh="#0B0C0E" AltLow="#0B0C0E" AltMedium="#0B0C0E" AltMediumHigh="#0B0C0E" AltMediumLow="#0B0C0E"
                               BaseHigh="#FFFFFF" BaseLow="#343840" BaseMedium="#C3C8D1" BaseMediumHigh="#DADDE3" BaseMediumLow="#A0A7B2"
                               ChromeAltLow="#DADDE3" ChromeBlackHigh="#060708" ChromeBlackLow="#33060708" ChromeBlackMedium="#99060708"
                               ChromeBlackMediumLow="#66060708" ChromeDisabledHigh="#343840" ChromeDisabledLow="#A0A7B2"
                               ChromeGray="#A0A7B2" ChromeHigh="#474C55" ChromeLow="#1A1C20" ChromeMedium="#24272D" ChromeMediumLow="#202227"
                               ChromeWhite="#FFFFFF" ListLow="#24272D" ListMedium="#343840" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://RetroHub.App/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RetroHub.App/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/FluentOverrides.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
