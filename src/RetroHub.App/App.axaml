<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RetroHub.App.App"
             RequestedThemeVariant="Dark">
  <!-- Fluent as the base for stock controls, then RetroHub's own tokens + control themes ("Nova"). -->
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#7B61FF" RegionColor="#0B0A1A" ErrorText="#FF5C72"
                               AltHigh="#0B0A1A" AltLow="#0B0A1A" AltMedium="#0B0A1A" AltMediumHigh="#0B0A1A" AltMediumLow="#0B0A1A"
                               BaseHigh="#F3F4FA" BaseLow="#33FFFFFF" BaseMedium="#B9BCD3" BaseMediumHigh="#D6D8E6" BaseMediumLow="#80849E"
                               ChromeAltLow="#D6D8E6" ChromeBlackHigh="#000000" ChromeBlackLow="#33000000" ChromeBlackMedium="#99000000"
                               ChromeBlackMediumLow="#66000000" ChromeDisabledHigh="#33FFFFFF" ChromeDisabledLow="#80849E"
                               ChromeGray="#80849E" ChromeHigh="#3A3860" ChromeLow="#15142B" ChromeMedium="#1E1C3A" ChromeMediumLow="#191833"
                               ChromeWhite="#FFFFFF" ListLow="#14FFFFFF" ListMedium="#26FFFFFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://RetroHub.App/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RetroHub.App/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/FluentOverrides.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
