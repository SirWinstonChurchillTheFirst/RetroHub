<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RetroHub.App.App"
             RequestedThemeVariant="Dark">
  <!-- Fluent as the base for stock controls, then RetroHub's own tokens + control themes ("Fernsehlicht"). -->
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FFB547" RegionColor="#14120F" ErrorText="#FF6A5E"
                               AltHigh="#14120F" AltLow="#14120F" AltMedium="#14120F" AltMediumHigh="#14120F" AltMediumLow="#14120F"
                               BaseHigh="#F4ECDF" BaseLow="#3A342B" BaseMedium="#C9BFAF" BaseMediumHigh="#DCD3C4" BaseMediumLow="#948A7A"
                               ChromeAltLow="#DCD3C4" ChromeBlackHigh="#0A0908" ChromeBlackLow="#330A0908" ChromeBlackMedium="#990A0908"
                               ChromeBlackMediumLow="#660A0908" ChromeDisabledHigh="#3A342B" ChromeDisabledLow="#948A7A"
                               ChromeGray="#948A7A" ChromeHigh="#4A4337" ChromeLow="#1E1B17" ChromeMedium="#2A2620" ChromeMediumLow="#241F1A"
                               ChromeWhite="#F4ECDF" ListLow="#2A2620" ListMedium="#3A342B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://RetroHub.App/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RetroHub.App/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/FluentOverrides.axaml" />
        <ResourceInclude Source="avares://RetroHub.App/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
