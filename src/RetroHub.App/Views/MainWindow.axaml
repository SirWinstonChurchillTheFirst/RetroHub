<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroHub.App.ViewModels"
        xmlns:c="using:RetroHub.App.Controls"
        xmlns:v="using:RetroHub.App.Views"
        xmlns:l="using:RetroHub.App.Localization"
        x:Class="RetroHub.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RetroHub"
        Width="1600" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="40">
  <Window.Resources>
    <v:IconKeyConverter x:Key="IconKey" />
  </Window.Resources>
  <Window.Styles>
    <!-- channel digit: Zahl 15 in Text 3; inverted with the channel when focused -->
    <Style Selector="Button.channel TextBlock.digit">
      <Setter Property="Foreground" Value="{DynamicResource RhText3Brush}" />
    </Style>
    <Style Selector="Button.channel:focus-visible TextBlock.digit">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!--
    Visual tree (DESIGN 7.0): the room light, the game screen, the fly-out/OSD layers stay UNSCALED; only the shell
    (header 72 · pages · footer 56) and the dialogs are scaled by UiScale (LayoutTransformControl). A NativeControlHost
    never lives in the scaled subtree.
  -->
  <Grid Name="Root">
    <c:RoomBackdrop Name="Backdrop" />

    <LayoutTransformControl Name="ScaleHost">
      <Grid Name="Shell" RowDefinitions="72,*,56">
        <!-- the page's tones under the header's content: a ground (Raum while the detail's back is read) and the dim of an
             open overlay; both follow the current page (code-behind) -->
        <Border Name="HeaderGround" IsHitTestVisible="False" />
        <Border Name="HeaderDim" IsHitTestVisible="False" />
        <!-- ============ Header "Kanäle" (caption buttons keep 170 px free on the right) ============ -->
        <!-- the window's drag area is ONLY this bare strip behind the header (role TitleBar, code-behind) plus the word mark:
             Win32 resolves a mouse press by the nearest element role above the hit visual, so a role on the header grid
             itself made every channel and tool button caption (no clicks, R3 owner test). The header grid has no background
             – its gaps fall through to this strip; every button in it carries the client role User. -->
        <Border Name="DragBar" Background="Transparent" />
        <Grid Name="TopBar" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="48,0,170,0">
          <StackPanel Name="BrandBar" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Background="Transparent">
            <!-- the standby LED: the one Cyan square of the word mark -->
            <Border Width="8" Height="8" Background="{DynamicResource RhAccentBrush}" VerticalAlignment="Center" Margin="0,2,0,0" />
            <TextBlock Text="RetroHub" FontFamily="{DynamicResource RhFontPoster}" FontWeight="ExtraBold" FontSize="20" VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl Grid.Column="1" Name="ChannelList" ItemsSource="{Binding Channels}" Margin="56,0,0,0" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="24" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItemViewModel">
                <Button Theme="{StaticResource RhChannel}" Classes="channel navitem slide-mark" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Label}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="number digit" Text="{Binding Channel}" FontSize="15" VerticalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Name="SearchButton" Theme="{StaticResource RhIconButton}" Classes="navitem tool" Command="{Binding SearchCommand}"
                    ToolTip.Tip="{l:T hint.search}" AutomationProperties.Name="{l:T hint.search}">
              <c:RhIcon Data="{StaticResource Icon.Search}" Width="28" Height="28" />
            </Button>
            <ItemsControl Name="ToolList" ItemsSource="{Binding Tools}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                  <Button Theme="{StaticResource RhIconButton}" Classes="navitem tool" Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                    <c:RhIcon Data="{Binding IconKey, Converter={StaticResource IconKey}}" Width="28" Height="28" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- demo mode: plain text (label 15, Text 3) after a 6 × 6 square in Text 3 – no fill: a paper block was the
               brightest thing in the header and competed with the active channel (M3 QA); an orange square read as a
               second standby light beside the word mark's (M6 QA). Cyan stays reserved (2.2). -->
          <StackPanel Name="DemoChip" Grid.Column="4" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowDemoChip}" Background="Transparent"
                      ToolTip.Tip="{l:T shell.demo.tip}" VerticalAlignment="Center" Margin="24,0,0,0">
            <Border Width="6" Height="6" Background="{DynamicResource RhText3Brush}" VerticalAlignment="Center" />
            <TextBlock Classes="label" Text="{Binding DemoText}" Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center" Margin="24,0,0,0">
            <TextBlock Text="{Binding ControllerName}" IsVisible="{Binding ShowControllerName}" FontSize="16" Foreground="{DynamicResource RhText3Brush}"
                       MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Name="ClockText" Text="{Binding Clock}" Classes="number" FontSize="18" Foreground="{DynamicResource RhText1Brush}" VerticalAlignment="Center" />
          </StackPanel>
          <!-- the channel mark (12 × 3 under the digit) is ONE piece that slides to the chosen channel (Glide, R2
               animation) instead of jumping between the buttons -->
          <Canvas Name="MarkCanvas" Grid.ColumnSpan="6" IsHitTestVisible="False">
            <Border Name="ChannelMark" Width="12" Height="3" Background="{DynamicResource RhAccentBrush}" IsVisible="False"
                    RenderTransformOrigin="50%,50%">
              <Border.RenderTransform>
                <TransformGroup>
                  <ScaleTransform />
                  <TranslateTransform />
                </TransformGroup>
              </Border.RenderTransform>
            </Border>
          </Canvas>
        </Grid>

        <c:PageHost Name="Pages" Grid.Row="1" />
        <!-- the room fades in behind the footer (allowed translucency, DESIGN 4.6): 56 px, eased, reaching the footer's
             own tone at its top edge, so content runs out softly instead of being cut at the footer -->
        <!-- R2: shorter (40) – the page now runs under the footer's front ledge (FooterLip), the shade is the ledge's
             occlusion, not a fade into nothing -->
        <Border Grid.Row="1" Height="40" VerticalAlignment="Bottom" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#000B0C0E" />
              <GradientStop Offset="0.45" Color="#800B0C0E" />
              <GradientStop Offset="1" Color="#F00B0C0E" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- ============ Footer: location sentence + context hints ============ -->
        <Border Name="HintBar" Grid.Row="2" Background="#FA0B0C0E">
          <Panel>
          <c:FooterLip VerticalAlignment="Top" />
          <Grid ColumnDefinitions="*,Auto" Margin="48,0,40,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
              <!-- the section is a way up for the mouse on a drill-in page (Systemseite, Spiel-Detail): a text button with a
                   1 px underline on hover; on a top-level page it is plain text (nothing to go up to) -->
              <Button Name="LocationParentButton" Theme="{StaticResource RhCrumbButton}" Content="{Binding LocationParent}"
                      IsHitTestVisible="{Binding CanGoBack}" Click="OnLocationParentClick" />
              <TextBlock Text="{l:T shell.location.sep}" FontSize="16" Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Center" IsVisible="{Binding HasLocationText}" />
              <TextBlock Name="LocationText" c:Sentence.Text="{Binding LocationText}" FontSize="16" Foreground="{DynamicResource RhText2Brush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="760" />
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding VisibleHints}" VerticalAlignment="Center" IsVisible="{Binding ShowHints}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="16" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HintItem">
                  <!-- every hint but "Öffnen/Starten" (that acts on the focused object) is a mouse target: the same action as
                       its key or button (R2); never focusable, so the controller focus stays where it is -->
                  <Button Theme="{StaticResource RhHintButton}" IsHitTestVisible="{Binding IsClickable}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:ButtonGlyph Action="{Binding Action}" Keyboard="{Binding $parent[Window].((vm:MainViewModel)DataContext).KeyboardGlyphs}"
                                     Hot="{Binding $parent[Button].IsPointerOver}" VerticalAlignment="Center" />
                      <TextBlock Classes="hint" Text="{Binding Label}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          </Panel>
        </Border>

        <!-- right-click list (R2): hangs at the pointer, the same panel as the detail's "Mehr" (Regal, 1 px line, 1 px light
             edge on top, 56 px rows); a click beside it, Esc, Zurück or the mouse's back button closes it -->
        <Panel Name="ContextLayer" Grid.RowSpan="3" IsVisible="False" Background="Transparent">
          <!-- R2: a riveted plate of the workbench (PanelPlate), not a floating card -->
          <Border Name="ContextPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Width="320" Background="Transparent"
                  Padding="0,10,0,10" ClipToBounds="False">
            <Panel>
              <c:PanelPlate Margin="0,-10,0,-10" />
              <StackPanel Name="ContextRows" />
            </Panel>
          </Border>
        </Panel>
      </Grid>
    </LayoutTransformControl>

    <!-- channel display (unscaled, sizes × UiScale in code) -->
    <c:OsdLayer Name="Osd" />

    <!-- ============ Launch overlay ("Spiel wird gestartet", embedded game screen, running state) ============ -->
    <!-- modal: Tab cycles inside the overlay and never reaches the shell behind it -->
    <Panel Name="LaunchOverlay" IsVisible="{Binding Launch.IsActive}" KeyboardNavigation.TabNavigation="Cycle">
      <Border Name="LaunchScrim" Background="{DynamicResource RhLaunchScrimBrush}" />
      <!-- embedded: the emulator window lives in the game screen (masked while the start transition lies above it) -->
      <Panel Name="GameScreenPanel" IsVisible="{Binding Launch.ShowGameScreen}">
        <c:GameScreen Name="GameScreen" DataContext="{Binding Launch}" />
      </Panel>
      <!-- running in its own window (windowed, released, recovered, or fullscreen without a window) -->
      <Grid IsVisible="{Binding Launch.ShowRunningOverlay}" RowDefinitions="Auto,*,Auto" Margin="48,72,48,40">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
          <TextBlock Text="{l:T launch.running}" Classes="label" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Launch.Game.Title}" Classes="poster-s" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1100" />
          <TextBlock HorizontalAlignment="Center" Classes="read" Foreground="{DynamicResource RhText2Brush}">
            <Run Text="{Binding Launch.EmulatorName}" /><Run Text=", " /><Run Text="{Binding Launch.ModeText}" /><Run Text=", " /><Run Text="{Binding Launch.ElapsedText}" />
          </TextBlock>
          <TextBlock Text="{Binding Launch.StatusNote}" Classes="meta" Foreground="{DynamicResource RhWarningBrush}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <c:RhIcon Data="{StaticResource Icon.Window}" Width="48" Height="48" Foreground="{DynamicResource RhText3Brush}" HorizontalAlignment="Center" />
          <TextBlock Text="{l:T launch.externalHint}" Classes="read" TextAlignment="Center" MaxWidth="560" />
          <!-- status as icon + sentence (DESIGN 2.3: no pills) -->
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding Launch.WindowMissing}">
            <c:RhIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource RhWarningBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
            <TextBlock Text="{l:T launch.fullscreen.noWindow.hint}" Classes="read" Foreground="{DynamicResource RhText1Brush}" MaxWidth="560" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding Launch.IsRecovered}">
            <c:RhIcon Data="{StaticResource Icon.Info}" Width="20" Height="20" Foreground="{DynamicResource RhText2Brush}" VerticalAlignment="Top" Margin="0,4,0,0" />
            <TextBlock Text="{l:T launch.recovered.hint}" Classes="read" MaxWidth="560" />
          </StackPanel>
        </StackPanel>
        <Button Name="StopButton" Grid.Row="2" Theme="{StaticResource RhDangerButton}" HorizontalAlignment="Center" Command="{Binding Launch.StopCommand}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <c:RhIcon Data="{StaticResource Icon.Stop}" Width="18" Height="18" />
            <TextBlock Text="{l:T launch.stop}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <!-- starting (above the masked game screen): the start surface that opens from the power-on line (FlightLayer,
           DESIGN 9.3) – the box on a board, the title as a poster, "mGBA startet …" and the segment light -->
      <Panel Name="StartPanel" IsVisible="{Binding Launch.IsStarting}">
        <Border Background="{DynamicResource RhRoomDeepBrush}" />
        <LayoutTransformControl Name="StartScale" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="0">
            <!-- the box the game was started from: the flying copy lands here and becomes this box (the same bitmap) -->
            <Panel Name="StartBoxSlot" Width="240" Height="336" HorizontalAlignment="Center">
              <c:CoverArt Name="StartBoxArt" KeepTitleClear="True" Source="{Binding Launch.Game.CoverPath}" Title="{Binding Launch.Game.Title}" Badge="{Binding Launch.Game.SystemShort}"
                          SystemId="{Binding Launch.Game.SystemId}" Accent="{Binding Launch.Game.Accent}" Year="{Binding Launch.Game.YearText}" />
              <Image Name="StartBoxImage" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsVisible="False"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Panel>
            <c:ShelfBoard Width="420" Height="10" IsEdge="True" />
            <TextBlock Text="{Binding Launch.Game.Title}" Classes="poster-s" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="1000" TextWrapping="Wrap"
                       Margin="0,44,0,0" />
            <TextBlock HorizontalAlignment="Center" Classes="read-l" Margin="0,12,0,0" Text="{Binding Launch.StartingText}" />
            <c:SegmentBar Name="StartSegments" IsIndeterminate="{Binding Launch.IsStarting}" HorizontalAlignment="Center" Margin="0,32,0,0" />
          </StackPanel>
        </LayoutTransformControl>
      </Panel>
    </Panel>


    <!-- ============ Toasts ============ -->
    <!-- QA 2: no floating notification cards. A message docks LEFT IN THE FOOTER and takes the place of the location
         sentence for its 4 s (icon + one sentence, the detail in Text 2 behind it) – never over content. The newest lies on
         top (overlapping panel). Scaled like the shell in code; the dock is also the hole the game screen cuts for it. -->
    <LayoutTransformControl Name="ToastDock" HorizontalAlignment="Left" VerticalAlignment="Bottom">
      <ItemsControl Name="ToastHost" ItemsSource="{Binding Toasts.Items}" Width="900">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Panel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToastViewModel">
            <!-- R2: the message is a slip of paper taped into the footer (ink, the icon in a dark tone of its colour); it
                 slides up out of the footer (code-behind, Step; reduced: fades; off: it is there) -->
            <Border Height="50" Background="{DynamicResource RhBaseBrush}" Padding="40,0,24,0">
              <c:PaperNote SeedText="{Binding Text}" Padding="14,6,18,7" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0%,50%">
                <c:PaperNote.RenderTransform>
                  <RotateTransform Angle="-0.7" />
                </c:PaperNote.RenderTransform>
                <Grid ColumnDefinitions="Auto,10,*" VerticalAlignment="Center">
                  <Panel VerticalAlignment="Center">
                    <c:RhIcon Data="{StaticResource Icon.Info}" Width="18" Height="18" Foreground="#3C424B" IsVisible="{Binding IsInfo}" />
                    <c:RhIcon Data="{StaticResource Icon.Ok}" Width="18" Height="18" Foreground="#2F6B3F" IsVisible="{Binding IsSuccess}" />
                    <c:RhIcon Data="{StaticResource Icon.Warning}" Width="18" Height="18" Foreground="#C2410C" IsVisible="{Binding IsWarning}" />
                    <c:RhIcon Data="{StaticResource Icon.Error}" Width="18" Height="18" Foreground="#A2302A" IsVisible="{Binding IsError}" />
                  </Panel>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16" TextTrimming="CharacterEllipsis" MaxLines="1">
                    <Run Text="{Binding Text}" FontWeight="SemiBold" Foreground="#0B0C0E" /><Run Text="{Binding DetailRun}" Foreground="#4F5560" />
                  </TextBlock>
                </Grid>
              </c:PaperNote>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </LayoutTransformControl>

    <!-- the power-on line, the flying box, the switch-off (unscaled; DESIGN 9.3) – above the toasts: "Willkommen zurück"
         waits for the page anyway, and nothing may stand on the closed dark of the switch-off -->
    <!-- the box between shelf and detail stage (R2 animation, unscaled): pulled out, put back -->
    <c:PullLayer Name="Pull" />
    <c:FlightLayer Name="Flight" />

    <!-- ============ Dialog overlay (scaled like the shell) ============ -->
    <LayoutTransformControl Name="DialogScaleHost" IsVisible="{Binding Dialogs.IsOpen}">
      <Panel Name="DialogOverlay" IsVisible="{Binding Dialogs.IsOpen}">
        <!-- a click on the dim cancels (the non-destructive answer), like the other overlays; an arrow, not a hand -->
        <Border Name="DialogScrim" Background="{DynamicResource RhOverlayScrimBrush}" Cursor="Arrow" />
        <Border Name="DialogPanel" KeyboardNavigation.TabNavigation="Cycle" Background="Transparent" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="36,32" DataContext="{Binding Dialogs.Current}" x:DataType="vm:DialogViewModel" ClipToBounds="False">
          <Panel>
            <!-- R2: the dialog is a plate of the workbench laid over the dimmed page (rivets, edges, its own shadow) -->
            <c:PanelPlate Margin="-36,-32,-36,-32" />
            <StackPanel Spacing="16">
              <TextBlock Text="{Binding Title}" Classes="h2" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Message}" Classes="read" IsVisible="{Binding HasMessage}" />
              <ItemsControl ItemsSource="{Binding Details}" IsVisible="{Binding HasDetails}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DialogDetail">
                    <Border CornerRadius="{DynamicResource RhRadiusControl}" Padding="12,10" Background="{DynamicResource RhSurfaceHiBrush}">
                      <Grid ColumnDefinitions="Auto,*">
                        <Panel VerticalAlignment="Top" Margin="0,1,0,0">
                          <c:RhIcon Data="{StaticResource Icon.Error}" Width="20" Height="20" Foreground="{DynamicResource RhDangerBrush}" IsVisible="{Binding IsBlocking}" />
                          <c:RhIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource RhWarningBrush}" IsVisible="{Binding !IsBlocking}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Text}" Classes="read" Foreground="{DynamicResource RhText1Brush}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Name="DialogButtons" ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DialogButton">
                    <Panel>
                      <Button Theme="{StaticResource RhPrimaryButton}" IsVisible="{Binding IsPrimary}" Content="{Binding Label}" MinWidth="140"
                              Command="{Binding $parent[Border].((vm:DialogViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}" />
                      <Button IsVisible="{Binding !IsPrimary}" Content="{Binding Label}" MinWidth="120" MinHeight="56"
                              Command="{Binding $parent[Border].((vm:DialogViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Panel>
        </Border>
      </Panel>
    </LayoutTransformControl>

    <!-- ============ Caption buttons (OS frame kept: snap, shadow, resize) ============ -->
    <StackPanel Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button Name="MinimizeButton" Theme="{StaticResource RhCaptionButton}" Tag="{StaticResource Glyph.Minimize}" ToolTip.Tip="{l:T window.minimize}" />
      <Button Name="MaximizeButton" Theme="{StaticResource RhCaptionButton}" Tag="{StaticResource Glyph.Maximize}" ToolTip.Tip="{l:T window.maximize}" />
      <Button Name="CloseButton" Theme="{StaticResource RhCaptionClose}" Tag="{StaticResource Glyph.Close}" ToolTip.Tip="{l:T window.close}" />
    </StackPanel>
  </Grid>
</Window>
