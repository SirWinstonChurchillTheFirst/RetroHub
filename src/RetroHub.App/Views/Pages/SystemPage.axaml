<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.SystemPage"
            x:DataType="vm:SystemViewModel">
  <!--
    Systemseite "Das Fach" (DESIGN 7.5, M5). The WALL BANNER heads the grid and scrolls with it (randlos): the system's
    wall (38/62, band, texture 8 %), top left the neighbours as text buttons with shoulder glyphs, bottom left the name
    (measured poster), ONE sentence and the emulator line with "Systeminfo", right the motif (300) standing on the stage
    board – a board in the wall's own tone, so it reads in front of every wall. The wall's light zone has a FIXED height
    (88, ≈1100: 64; 24 without neighbours) and holds only the neighbour row; the title never reaches into it (M5 QA).
    Below the board the grid in the system's light on the wall as a flat tone. Once the banner has scrolled out, a
    compact header (64: wall, band, name, motif on a small board) takes its place – never a sliver of the banner.
    One to six games end in "Fachende" (a sentence with the way to the imports beside it); an empty compartment shows
    the empty shelf. Systeminfo is an overlay in the form of a filing card (folders, file types, emulators, BIOS).
    1080: wall window y 72–440, board 440–464, first box ≈ 512.
  -->
  <p:PageBase.Resources>
    <DataTemplate x:Key="GridTile" x:DataType="vm:GameItemViewModel">
      <!-- in one system the label line drops the code (bar, variant and year stay) -->
      <c:GameTile Classes="in-system no-code" Classes.bare="{Binding !HasLabelDetail}" ShowSticker="True" />
    </DataTemplate>
  </p:PageBase.Resources>
  <p:PageBase.Styles>
    <!-- R3 QA: the neighbours are two paper tags taped to the upper wall (ink on paper, the shoulder glyph beside each);
         hover brightens the paper, focus is the chamfered ring around the tag -->
    <Style Selector="Button.wall-tag">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
            <c:FocusRing Name="PART_Ring" Brush="{DynamicResource RhPaperBrush}" Opacity="0" Margin="-2" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.wall-tag:focus-visible /template/ c|FocusRing#PART_Ring">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.wall-tag c|PaperNote">
      <Setter Property="Paper" Value="#D9CFBC" />
    </Style>
    <Style Selector="Button.wall-tag:pointerover c|PaperNote, Button.wall-tag:focus-visible c|PaperNote">
      <Setter Property="Paper" Value="#EFE6D3" />
    </Style>
    <Style Selector="Button.wall-tag:pointerover c|ButtonGlyph">
      <Setter Property="Hot" Value="True" />
    </Style>
    <!-- the banner's text buttons: quiet on the wall (Text 2, ui 16), focus = inversion like every small element -->
    <Style Selector="Button.wall-text">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.wall-text:pointerover c|ButtonGlyph">
      <Setter Property="Hot" Value="True" />
    </Style>
  </p:PageBase.Styles>

  <Panel Name="Root">
    <c:CoverGrid Name="Covers" ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GridTile}" ItemWidth="176" Spacing="28" RowSpacing="24"
                 CoverAspect="{Binding SlotAspect}" CaptionHeight="90" MaxStretch="1.15" ContentPadding="{DynamicResource RhGridInset}" HeaderBleed="True"
                 StickyInset="64" SnapToEnd="True">
      <c:CoverGrid.Header>
        <Panel Name="Banner" Height="392" ClipToBounds="True">
          <c:SystemWall Name="BannerWall" Margin="0,0,0,24" SystemId="{Binding System.Id, FallbackValue={x:Null}}" Accent="{Binding System.Accent, FallbackValue=#948A7A}"
                        MotifShare="0" TextureOpacity="0.08" SplitHeight="88" Rail="True" />
          <c:ShelfBoard Name="BannerBoard" Height="24" VerticalAlignment="Bottom" WallLook="{Binding System.Look, FallbackValue={x:Null}}" />
          <Panel Name="BannerContent" Margin="{DynamicResource RhPageInsetX}">
            <!-- the neighbours: text buttons with the shoulder glyphs (the shoulders do the same) -->
            <StackPanel Name="Neighbours" Orientation="Horizontal" Spacing="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,30,0,0"
                        IsVisible="{Binding HasNeighbours}">
              <Button Name="PrevSystem" Classes="wall-tag" Command="{Binding PreviousSystemCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <c:ButtonGlyph Action="PageLeft" Quiet="True" VerticalAlignment="Center" />
                  <c:PaperNote SeedText="nachbar-links" Padding="10,4,12,5" VerticalAlignment="Center" RenderTransformOrigin="50%,0%">
                    <c:PaperNote.RenderTransform>
                      <RotateTransform Angle="-1.4" />
                    </c:PaperNote.RenderTransform>
                    <TextBlock Classes="ui" FontSize="16" Foreground="#1A1714" Text="{Binding Previous.Name, FallbackValue={x:Null}}" />
                  </c:PaperNote>
                </StackPanel>
              </Button>
              <Button Name="NextSystem" Classes="wall-tag" Command="{Binding NextSystemCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <c:PaperNote SeedText="nachbar-rechts" Padding="12,4,10,5" VerticalAlignment="Center" RenderTransformOrigin="50%,0%">
                    <c:PaperNote.RenderTransform>
                      <RotateTransform Angle="1.1" />
                    </c:PaperNote.RenderTransform>
                    <TextBlock Classes="ui" FontSize="16" Foreground="#1A1714" Text="{Binding Next.Name, FallbackValue={x:Null}}" />
                  </c:PaperNote>
                  <c:ButtonGlyph Action="PageRight" Quiet="True" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <!-- name, ONE sentence, the emulator line – anchored to the board -->
            <StackPanel Name="BannerText" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,380,48">
              <c:FitText Name="BannerTitle" Classes="poster" Source="{Binding System.PosterName, FallbackValue={x:Null}}" Sizes="72,56,44" MaxLines="2" LineFactor="1.04"
                         MaxTextHeight="138" />
              <TextBlock Name="BannerSentence" Classes="read-l" c:Sentence.Text="{Binding SentenceText}" TextWrapping="Wrap" MaxLines="2" Margin="0,8,0,0" />
              <StackPanel Name="StatusRow" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource RhSuccessBrush}" IsVisible="{Binding EmulatorReady}" VerticalAlignment="Center" />
                <c:RhIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource RhWarningBrush}" IsVisible="{Binding !EmulatorReady}"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding EmulatorText}" Classes="ui" FontSize="16" VerticalAlignment="Center" />
                <Button Name="SetupButton" Theme="{StaticResource RhGhostButton}" Classes="wall-text" Command="{Binding OpenEmulatorsCommand}"
                        IsVisible="{Binding !EmulatorReady}" Margin="4,0,0,0">
                  <TextBlock Text="{l:T system.setup}" />
                </Button>
                <Button Name="InfoButton" Theme="{StaticResource RhGhostButton}" Classes="wall-text" Command="{Binding ShowInfoCommand}" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:RhIcon Data="{StaticResource Icon.More}" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T system.info}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
            <c:MotifView Name="BannerMotif" Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                         SystemId="{Binding System.Id, FallbackValue={x:Null}}" Accent="{Binding System.Accent, FallbackValue=#948A7A}" />
          </Panel>
        </Panel>
      </c:CoverGrid.Header>
      <c:CoverGrid.Footer>
        <!-- one to six games: "Fachende" – the compartment ends in one sentence with the way to more beside it (one line, so
             it stays above the footer's fade at ≈ 1100); empty: the empty shelf (recessed places, one leaning spine). The
             bottom margin reserves the footer and its fade, so the button can always be brought fully into view. -->
        <StackPanel Name="Ending" Spacing="0" Margin="0,4,0,40">
          <StackPanel Name="EmptyEnding" IsVisible="{Binding IsEmpty}" Margin="0,24,0,0">
            <StackPanel Name="EmptyPlaces" Orientation="Horizontal" Spacing="24" ClipToBounds="True">
              <c:EmptyShelfDrawing Name="EmptyDrawing" Gesture="True" Width="140" Height="200" VerticalAlignment="Bottom" Margin="0,0,8,0" />
              <c:EmptySlot Recessed="True" Width="150" Height="200" VerticalAlignment="Bottom" />
              <c:EmptySlot Recessed="True" Width="150" Height="200" VerticalAlignment="Bottom" />
              <c:EmptySlot Recessed="True" Width="150" Height="200" VerticalAlignment="Bottom" />
            </StackPanel>
            <c:ShelfBoard Name="EmptyBoard" Height="12" IsEdge="True" Margin="-200,0,-200,0" />
            <TextBlock Name="EmptyTitle" Classes="poster-s" Text="{l:T system.emptyTitle}" Margin="0,48,0,0" />
            <TextBlock Classes="read-l" Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>
          <!-- R2: the sentence is a paper note; with one row of games it stands IN the compartment beside the last box
               (code-behind), never below it in the footer's fade -->
          <StackPanel Name="EndRow" Orientation="Horizontal" Spacing="24" Margin="0,8,0,0">
            <c:PaperNote Name="FewNote" SeedText="fachende" Padding="18,14,22,16" IsVisible="{Binding IsFewGames}" VerticalAlignment="Center"
                         HorizontalAlignment="Left" RenderTransformOrigin="50%,50%">
              <c:PaperNote.RenderTransform>
                <RotateTransform Angle="-1.2" />
              </c:PaperNote.RenderTransform>
              <TextBlock Name="FewText" Classes="read-l" Text="{l:T system.fewGames}" Foreground="#1A1714" TextWrapping="Wrap" />
            </c:PaperNote>
            <Button Name="ImportsButton" MinHeight="48" Padding="24,0" Command="{Binding OpenImportsCommand}" VerticalAlignment="Center" HorizontalAlignment="Left">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="IsEmpty" />
                  <Binding Path="IsFewGames" />
                </MultiBinding>
              </Button.IsVisible>
              <TextBlock Text="{l:T system.openImports}" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </StackPanel>
      </c:CoverGrid.Footer>
    </c:CoverGrid>

    <!-- ===== the compact header: once the banner has scrolled out (≥ 70 %), a 64 px strip of the wall with its band, the
         name and the motif on a small board takes its place (fades in, Step); rows snap below it ===== -->
    <Panel Name="CompactHeader" VerticalAlignment="Top" Height="76" Opacity="0" IsHitTestVisible="False">
      <Panel.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Panel.Transitions>
      <Border Name="CompactWall" Height="64" VerticalAlignment="Top" Background="{Binding System.WallBrush, FallbackValue={x:Null}}" />
      <Border Name="CompactFade" Height="12" VerticalAlignment="Top" Margin="0,64,0,0" />
      <Border Height="4" VerticalAlignment="Top" Background="{Binding System.AccentBrush, FallbackValue={x:Null}}" />
      <!-- the name scrolls back up to the banner on a click (R2) -->
      <TextBlock Name="CompactName" Classes="poster" FontSize="28" LineHeight="32" LetterSpacing="-0.28" Margin="96,18,640,0"
                 VerticalAlignment="Top" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxLines="1" Cursor="Hand" Background="Transparent"
                 Text="{Binding System.Name, FallbackValue={x:Null}}" />
      <!-- the mouse keeps the banner's actions while it is scrolled out (R2): the neighbours and the Systeminfo, quiet
           text buttons on the wall; never focusable (the controller has the shoulders and the banner) -->
      <StackPanel Name="CompactActions" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,184,0">
        <Button Name="CompactPrev" Theme="{StaticResource RhGhostButton}" Classes="wall-text" MinHeight="36" Focusable="False"
                Command="{Binding PreviousSystemCommand}" IsVisible="{Binding HasNeighbours}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Previous.ShortName, FallbackValue={x:Null}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="CompactNext" Theme="{StaticResource RhGhostButton}" Classes="wall-text" MinHeight="36" Focusable="False"
                Command="{Binding NextSystemCommand}" IsVisible="{Binding HasNeighbours}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Next.ShortName, FallbackValue={x:Null}}" VerticalAlignment="Center" />
            <c:RhIcon Data="{StaticResource Icon.ChevronRight}" Width="16" Height="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="CompactInfo" Theme="{StaticResource RhGhostButton}" Classes="wall-text" Width="36" Height="36" MinHeight="36" Padding="0" Focusable="False"
                Command="{Binding ShowInfoCommand}" ToolTip.Tip="{l:T system.info}">
          <c:RhIcon Data="{StaticResource Icon.Info}" Width="20" Height="20" />
        </Button>
      </StackPanel>
      <c:MotifView Name="CompactMotif" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,120,0"
                   SystemId="{Binding System.Id, FallbackValue={x:Null}}" Accent="{Binding System.Accent, FallbackValue=#948A7A}" />
      <c:ShelfBoard Name="CompactBoard" Height="6" Width="76" HorizontalAlignment="Right" Margin="0,58,104,0"
                    WallLook="{Binding System.Look, FallbackValue={x:Null}}" />
    </Panel>

    <!-- ===== Systeminfo: a filing card over the dimmed page (room-deep 72 %, no blur); header and footer stay. Left the
         system's colour band, the name in the poster face, the motif top right on a board line, labels in the code face,
         values in Cascadia. Square (R 0), 1 px edge plus a 1 px light edge on top. ===== -->
    <Panel Name="InfoLayer" IsVisible="{Binding IsInfoOpen}" Background="Transparent">
      <Border Name="InfoScrim" Background="#B80A0908" />
      <!-- QA 2: the one sheet left in the product, one template – Regal, the 8 px system band on top, the name in
           Rücken 22, the key/value grid of an opened Emulatoren row (keys Etikett 15 Text 3, 168 wide; values read
           Text 2 at + 200; folders and extensions in Cascadia Mono Regular 15). It hangs under the banner's action row
           like the detail's "Mehr" list hangs at its button – no centred modal. -->
      <!-- R2: an index card (Karteikarte) of light paper taped onto the page – the head line in red, ruled lines every
           32 px, ink text; a tab in the system's colour on its top edge. It drops in from 16 px above and settles. -->
      <c:PaperNote Name="InfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Width="760" SeedText="systeminfo" Paper="#ECE3D1"
                   RuleStep="32" RuleTop="62" RenderTransformOrigin="50%,0%">
        <c:PaperNote.Styles>
          <Style Selector="TextBlock.kv-key">
            <Setter Property="Foreground" Value="#6E6457" />
          </Style>
          <Style Selector="TextBlock.kv-value, TextBlock.kv-mono">
            <Setter Property="Foreground" Value="#2A241D" />
          </Style>
          <Style Selector="Run.name">
            <Setter Property="Foreground" Value="#1A1714" />
          </Style>
          <!-- the close key: an ink outline on the card, filled ink when focused (the card's own inversion) -->
          <Style Selector="Button#InfoCloseButton">
            <Setter Property="Foreground" Value="#1A1714" />
            <Setter Property="BorderBrush" Value="#1A1714" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="Button#InfoCloseButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="Button#InfoCloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22000000" />
          </Style>
          <Style Selector="Button#InfoCloseButton:focus-visible">
            <Setter Property="Foreground" Value="#ECE3D1" />
          </Style>
          <Style Selector="Button#InfoCloseButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A1714" />
          </Style>
        </c:PaperNote.Styles>
        <StackPanel Spacing="0">
          <Border Height="8" Width="120" HorizontalAlignment="Left" Margin="32,0,0,0" Background="{Binding System.AccentBrush, FallbackValue={x:Null}}" />
          <StackPanel Spacing="0" Margin="32,18,32,24">
            <TextBlock Name="InfoTitle" FontFamily="{DynamicResource RhFontSpine}" FontWeight="Bold" FontSize="22" LineHeight="28" LetterSpacing="0.6"
                       Foreground="#1A1714" Margin="0,0,0,14" Text="{Binding System.Name, FallbackValue={x:Null}}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding InfoLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InfoLine">
                  <Grid ColumnDefinitions="168,32,*" MinHeight="32">
                    <TextBlock Classes="kv-key" Text="{Binding Label}" />
                    <TextBlock Grid.Column="2" Classes="kv-value" c:Sentence.Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding !Mono}" />
                    <TextBlock Grid.Column="2" Classes="kv-mono" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding Mono}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Name="InfoCloseButton" Command="{Binding CloseInfoCommand}" MinHeight="44" Margin="200,16,0,0" HorizontalAlignment="Left">
              <TextBlock Text="{l:T detail.close}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </c:PaperNote>
    </Panel>
  </Panel>
</p:PageBase>
