<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.SystemPage"
            x:DataType="vm:SystemViewModel">
  <!-- Systemseite (M1 foundation state): the page ground is the system's wall (RoomBackdrop); banner and motif follow in M5 (DESIGN 7.5). -->
  <p:PageBase.Resources>
    <DataTemplate x:Key="GridTile" x:DataType="vm:GameItemViewModel">
      <c:GameTile Classes="in-system" />
    </DataTemplate>
  </p:PageBase.Resources>
  <Panel>
    <c:CoverGrid Name="Covers" ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GridTile}" ItemWidth="176" Spacing="28" RowSpacing="24"
                 CoverAspect="{Binding SlotAspect}" CaptionHeight="92" MaxStretch="1.15" ContentPadding="{DynamicResource RhGridInset}">
      <c:CoverGrid.Header>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,48">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="4" Height="18" Background="{Binding System.AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding System.ShortName}" Classes="code" Foreground="{Binding System.LightBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding System.Name}" Classes="poster" TextWrapping="Wrap" MaxLines="2" Margin="0,6,0,0" />
            <TextBlock Classes="read-l" c:Sentence.Text="{Binding SentenceText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom" MaxWidth="440">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource RhSuccessBrush}" IsVisible="{Binding EmulatorReady}" VerticalAlignment="Center" />
              <c:RhIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource RhWarningBrush}" IsVisible="{Binding !EmulatorReady}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding EmulatorText}" Classes="ui" FontSize="16" TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="meta" TextWrapping="Wrap">
              <Run Text="{l:T system.folders}" /><Run Text=" " /><Run Text="{Binding FoldersText}" />
            </TextBlock>
            <TextBlock Classes="meta" TextWrapping="Wrap">
              <Run Text="{l:T system.extensions}" /><Run Text=" " /><Run Text="{Binding ExtensionsText}" />
            </TextBlock>
          </StackPanel>
        </Grid>
      </c:CoverGrid.Header>
    </c:CoverGrid>
    <TextBlock Text="{l:T system.empty}" Classes="read" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Panel>
</p:PageBase>
