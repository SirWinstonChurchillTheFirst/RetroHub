<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.EmulatorsPage"
            x:DataType="vm:EmulatorsViewModel">
  <!--
    Emulatoren nach eigenen Systemen (DESIGN 7.6): one flat row per system of the library – its colour band and code,
    the name, and one sentence: "spielt mit mGBA 0.10.3" or the honest gap "Kein Emulator gefunden. Einrichten ›".
    Confirm folds the row open (180 ms) at every width: where the program lies (Cascadia Mono), how it starts, its cores,
    the candidates in the planner's order, [Ordner öffnen] [Website]. Below, "Weitere erkannte Programme" (folded).
    No cards, no status pills, no inspector column.
  -->
  <p:PageBase.Styles>
    <Style Selector="TextBlock.sys-code">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontSpine}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <!-- program names in read SemiBold Papier (QA 2, one rule with the detail's "Startet mit …"); the version in Zahl -->
    <Style Selector="Run.prog">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontRead}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="TextBlock.choice">
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    </Style>
    <Style Selector="TextBlock.choice.chosen">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="Run.ver">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontNumber}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource RhText3Brush}" />
    </Style>
    <Style Selector="TextBlock.path">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontRead}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="28" />
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Run.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    </Style>
    <Style Selector="TextBlock.quiet-gap">
      <Setter Property="Foreground" Value="{DynamicResource RhText3Brush}" />
    </Style>
    <Style Selector="TextBlock.kv-key">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="LetterSpacing" Value="0.45" />
      <Setter Property="Foreground" Value="{DynamicResource RhText3Brush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="TextBlock.kv-value">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontRead}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    </Style>
  </p:PageBase.Styles>

  <c:WorkbenchFrame Name="Frame">
    <!-- the head: title, one meta line; the buttons right on the list edge, their text on the meta line -->
    <Grid c:WorkbenchFrame.Role="Head" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="8">
        <TextBlock Text="{l:T nav.emulators}" Classes="poster" />
        <TextBlock c:Sentence.Text="{Binding SummaryText}" Classes="meta" />
      </StackPanel>
      <!-- narrow pages only: with the side column shown the two buttons stand in the Gerätefach -->
      <StackPanel Name="HeadButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,58,0,0">
        <Button Name="FolderButton" Theme="{StaticResource RhGhostButton}" Command="{Binding OpenEmulatorsFolderCommand}" MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
            <TextBlock Text="{l:T emulators.openFolder}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="RefreshButton" Theme="{StaticResource RhGhostButton}" Command="{Binding RefreshCommand}" MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Data="{StaticResource Icon.Refresh}" Width="18" Height="18" />
            <TextBlock Text="{l:T emulators.refresh}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Name="Scroller" c:WorkbenchFrame.Role="Scroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="0" Margin="0,16,24,48">
      <!-- the systems; where RetroHub looks, as one meta line beside the label -->
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12" Height="24">
        <c:ShelfLabel Text="{Binding FilterText}" IsVisible="{Binding IsFiltered}" VerticalAlignment="Center" />
        <c:ShelfLabel Text="{l:T emulators.systems}" IsVisible="{Binding !IsFiltered}" VerticalAlignment="Center" />
        <TextBlock Classes="meta" VerticalAlignment="Center">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!IsFiltered" />
              <Binding Path="!NoneInstalled" />
            </MultiBinding>
          </TextBlock.IsVisible>
          <Run Text="{l:T emulators.where.before}" /><Run Classes="mono" Text="emulators/&lt;name&gt;/" /><Run Text="{l:T emulators.where.after}" />
        </TextBlock>
        <!-- nothing installed: the head already names the folder – the label keeps only the promise (QA 2) -->
        <TextBlock Classes="meta" VerticalAlignment="Center" Text="{l:T emulators.promise}">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!IsFiltered" />
              <Binding Path="NoneInstalled" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>
        <Button Theme="{StaticResource RhGhostButton}" Command="{Binding ShowAllCommand}" Content="{l:T emulators.showAll}" IsVisible="{Binding IsFiltered}" MinHeight="36" />
      </StackPanel>
      <Border Height="1" Background="{DynamicResource RhLineBrush}" />
      <TextBlock Text="{l:T emulators.noSystems}" Classes="read" IsVisible="{Binding NoSystems}" Margin="0,20,0,0" />

      <ItemsControl Name="List" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EmulatorRowViewModel">
            <StackPanel>
              <Button Theme="{StaticResource RhFoldRow}" Classes="fold-row sysrow" AutomationProperties.Name="{Binding Title}"
                      Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).ToggleCommand}" CommandParameter="{Binding}">
                <!-- the system's spine (40 × 72), then the name from x 172 -->
                <Grid ColumnDefinitions="16,40,20,*,Auto" MinHeight="72">
                  <c:MiniSpine Grid.Column="1" Look="{Binding Look}" Code="{Binding Code}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="0" Margin="0,8,16,8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Classes="row-chip" Padding="8,1" CornerRadius="2" Margin="-8,0,0,0">
                        <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource RhFontUi}" FontWeight="Medium" FontSize="20" LineHeight="26" />
                      </Border>
                      <TextBlock c:Sentence.Text="{Binding GamesText}" Classes="meta" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- spielt mit mGBA 0.10.3 -->
                    <TextBlock Classes="read" LineHeight="26" IsVisible="{Binding Ready}" TextTrimming="CharacterEllipsis">
                      <Run Text="{l:T emulators.playsWith}" /><Run Text=" " /><Run Classes="prog" Text="{Binding PlaysWith}" /><Run Text=" " /><Run Classes="ver" Text="{Binding PlaysVersion}" />
                    </TextBlock>
                    <!-- a single gap: Kein Emulator gefunden. Einrichten › (with the warning) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowGap}">
                      <c:RhIcon Data="{StaticResource Icon.Warning}" Width="18" Height="18" Foreground="{DynamicResource RhWarningBrush}" VerticalAlignment="Center" />
                      <TextBlock Classes="read" LineHeight="26" VerticalAlignment="Center">
                        <Run Text="{Binding MissingText}" /><Run Text=" " /><Run Text="{l:T emulators.setUp}" Foreground="{DynamicResource RhText1Brush}" />
                      </TextBlock>
                    </StackPanel>
                    <!-- many gaps (a fresh install): the head says it once; the row only states it -->
                    <TextBlock Classes="read quiet-gap" LineHeight="26" IsVisible="{Binding ShowQuietGap}" Text="{l:T emulators.noneShort}" />
                  </StackPanel>
                  <c:RhIcon Grid.Column="4" Classes="row-chevron" Data="{StaticResource Icon.Expand}" Width="18" Height="18" StrokeThickness="2.6" Margin="0,0,20,0"
                            Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Center" IsVisible="{Binding !IsOpen}" />
                  <c:RhIcon Grid.Column="4" Classes="row-chevron" Data="{StaticResource Icon.Collapse}" Width="18" Height="18" StrokeThickness="2.6" Margin="0,0,20,0"
                            Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Center" IsVisible="{Binding IsOpen}" />
                </Grid>
              </Button>
              <!-- opened: a key/value grid – keys in label 15 Text 3 at x 228 (168 wide), values at x 412 in read 18 Text 2,
                   every line 32 px, paths in Cascadia Mono 15; 16 px before the buttons -->
              <c:FoldPanel IsOpen="{Binding IsOpen}">
                <StackPanel Margin="132,8,24,24" Spacing="0" IsVisible="{Binding HasEmulator}">
                  <Grid ColumnDefinitions="168,16,*" MinHeight="32">
                    <TextBlock Classes="kv-key" Text="{l:T emulators.key.program}" />
                    <TextBlock Grid.Column="2" Classes="kv-value" TextTrimming="CharacterEllipsis">
                      <Run Classes="prog" Text="{Binding Emulator.Name}" /><Run Text=" " /><Run Classes="ver" Text="{Binding Emulator.Version}" /><Run Text=" " /><Run Text="{Binding Emulator.PathInline}" /><Run Text=" " /><Run Classes="mono" Text="{Binding Emulator.PathOnly}" />
                    </TextBlock>
                  </Grid>
                  <Grid ColumnDefinitions="168,16,*" MinHeight="32" IsVisible="{Binding ShowModes}">
                    <TextBlock Classes="kv-key" Text="{l:T emulators.key.modes}" />
                    <TextBlock Grid.Column="2" Classes="kv-value" Text="{Binding Emulator.ModesSentence}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Grid ColumnDefinitions="168,16,*" MinHeight="32" IsVisible="{Binding HasCores}">
                    <TextBlock Classes="kv-key" Text="{l:T emulators.key.cores}" />
                    <TextBlock Grid.Column="2" Classes="kv-value" Text="{Binding CoresText}" TextWrapping="Wrap" />
                  </Grid>
                  <!-- the candidates in the planner's order: the one that plays in Papier -->
                  <Grid ColumnDefinitions="168,16,*" IsVisible="{Binding HasChoices}">
                    <TextBlock Classes="kv-key" Text="{l:T emulators.key.order}" />
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Choices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmulatorChoiceLine">
                          <StackPanel Orientation="Horizontal" Spacing="10" Height="32">
                            <Panel Width="18" VerticalAlignment="Center">
                              <c:RhIcon Data="{StaticResource Icon.Ok}" Width="16" Height="16" Foreground="{DynamicResource RhSuccessBrush}" IsVisible="{Binding IsUsable}" />
                              <c:RhIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Foreground="{DynamicResource RhWarningBrush}" IsVisible="{Binding !IsUsable}" />
                            </Panel>
                            <TextBlock Text="{Binding Name}" Classes="kv-value choice" VerticalAlignment="Center" Classes.chosen="{Binding IsChosen}" />
                            <TextBlock Text="{Binding State}" Classes="meta" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="184,16,0,0">
                    <Button Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding Emulator}" MinHeight="44">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:RhIcon Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
                        <TextBlock Text="{l:T emulators.openFolder}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).OpenDownloadCommand}" CommandParameter="{Binding Emulator}"
                            IsVisible="{Binding Emulator.HasDownload}" MinHeight="44">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:RhIcon Data="{StaticResource Icon.External}" Width="18" Height="18" />
                        <TextBlock Text="{l:T emulators.website}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </c:FoldPanel>
              <Border Height="1" Background="{DynamicResource RhLineBrush}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Weitere erkannte Programme (folded) -->
      <Panel IsVisible="{Binding OthersRow, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,40,0,0">
      <StackPanel DataContext="{Binding OthersRow}" x:DataType="vm:EmulatorRowViewModel">
        <Border Height="1" Background="{DynamicResource RhLineBrush}" />
        <Button Name="OthersButton" Theme="{StaticResource RhFoldRow}" Classes="fold-row" AutomationProperties.Name="{Binding Title}"
                Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).ToggleCommand}" CommandParameter="{Binding}">
          <Grid ColumnDefinitions="*,Auto" MinHeight="64">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="24,0,0,0">
              <Border Classes="row-chip" Padding="8,1" CornerRadius="2" Margin="-8,0,0,0">
                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource RhFontUi}" FontWeight="Medium" FontSize="20" LineHeight="26" />
              </Border>
              <TextBlock c:Sentence.Text="{Binding GamesText}" Classes="meta" VerticalAlignment="Center" />
            </StackPanel>
            <c:RhIcon Grid.Column="1" Classes="row-chevron" Data="{StaticResource Icon.Expand}" Width="18" Height="18" StrokeThickness="2.6" Margin="0,0,20,0"
                      Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Center" IsVisible="{Binding !IsOpen}" />
            <c:RhIcon Grid.Column="1" Classes="row-chevron" Data="{StaticResource Icon.Collapse}" Width="18" Height="18" StrokeThickness="2.6" Margin="0,0,20,0"
                      Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Center" IsVisible="{Binding IsOpen}" />
          </Grid>
        </Button>
        <c:FoldPanel IsOpen="{Binding IsOpen}">
          <ItemsControl ItemsSource="{Binding Others}" Margin="24,0,24,16">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EmulatorItemViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,14">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" Classes="ui-l" />
                    <TextBlock c:Sentence.Text="{Binding StateSentence}" Classes="read" />
                    <TextBlock Classes="path" FontSize="15">
                      <Run Text="{Binding PathPrefix}" /><Run Text=" " /><Run Classes="mono" Text="{Binding PathOnly}" />
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Theme="{StaticResource RhGhostButton}" MinHeight="44" ToolTip.Tip="{l:T emulators.openFolder}"
                            Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:RhIcon Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
                        <TextBlock Text="{l:T emulators.openFolder}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Theme="{StaticResource RhGhostButton}" MinHeight="44" IsVisible="{Binding HasDownload}"
                            Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).OpenDownloadCommand}" CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:RhIcon Data="{StaticResource Icon.External}" Width="18" Height="18" />
                        <TextBlock Text="{l:T emulators.website}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </c:FoldPanel>
        <Border Height="1" Background="{DynamicResource RhLineBrush}" />
      </StackPanel>
      </Panel>
    </StackPanel>
    </ScrollViewer>
    <Border c:WorkbenchFrame.Role="Fade" IsHitTestVisible="False" Background="{x:Static c:WorkbenchFrame.FadeBrush}" />

    <!-- the side column (QA 2: it stood empty beside the list): a "Gerätefach" – label "Bereit", "10 von 13" in Zahl 28,
         one 24 × 10 segment per system in its colour (lit = it can start, Wand hell = it cannot), then the page's two
         actions -->
    <StackPanel Name="DeviceBay" c:WorkbenchFrame.Role="Side" Spacing="0">
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12" Height="24">
        <c:ShelfLabel Text="{l:T emulators.readyLabel}" VerticalAlignment="Center" />
      </StackPanel>
      <Border Height="1" Background="{DynamicResource RhLineBrush}" Margin="0,0,0,20" />
      <TextBlock Name="ReadyCount" Classes="number" FontSize="28" LineHeight="32" Text="{Binding ReadyText}" Foreground="{DynamicResource RhText1Brush}" />
      <ItemsControl Name="ReadySegments" ItemsSource="{Binding Segments}" Margin="0,14,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReadySegment">
            <Border Width="24" Height="10" Background="{Binding Brush}" ToolTip.Tip="{Binding Code}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Spacing="4" Margin="-12,32,0,0">
        <Button Name="BayFolderButton" Theme="{StaticResource RhGhostButton}" Command="{Binding OpenEmulatorsFolderCommand}" MinHeight="44" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
            <TextBlock Text="{l:T emulators.openFolder}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="BayRefreshButton" Theme="{StaticResource RhGhostButton}" Command="{Binding RefreshCommand}" MinHeight="44" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Data="{StaticResource Icon.Refresh}" Width="18" Height="18" />
            <TextBlock Text="{l:T emulators.refresh}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </c:WorkbenchFrame>
</p:PageBase>
