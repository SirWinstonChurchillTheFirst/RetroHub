<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.EmulatorsPage"
            x:DataType="vm:EmulatorsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,4,40,40" Spacing="0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{l:T nav.emulators}" Classes="title" />
          <TextBlock Text="{Binding SummaryText}" Classes="meta" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
          <Button Command="{Binding OpenEmulatorsFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:RhIcon Data="{StaticResource Icon.Folder}" Width="17" Height="17" />
              <TextBlock Text="{l:T emulators.openFolder}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="RefreshButton" Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:RhIcon Data="{StaticResource Icon.Refresh}" Width="17" Height="17" />
              <TextBlock Text="{l:T emulators.refresh}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <TextBlock Text="{l:T emulators.intro}" Classes="body" MaxWidth="860" HorizontalAlignment="Left" Margin="0,14,0,22" />

      <ItemsControl Name="List" ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EmulatorItemViewModel">
            <Border Classes="card" Padding="20,18">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="52" Height="52" CornerRadius="16" VerticalAlignment="Top"
                        Background="{DynamicResource RhAccentSoftBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1">
                  <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource RhAccentTextBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,18,0" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Name}" Classes="h3" FontSize="17" VerticalAlignment="Center" />
                    <Border Classes="chip ok" IsVisible="{Binding IsInstalled}" Padding="9,3">
                      <TextBlock Text="{Binding StatusText}" FontSize="11.5" />
                    </Border>
                    <Border Classes="chip warn" IsVisible="{Binding IsMissing}" Padding="9,3">
                      <TextBlock Text="{Binding StatusText}" FontSize="11.5" />
                    </Border>
                    <TextBlock Text="{Binding VersionText}" Classes="meta" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding KindText}" Classes="meta" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding PathText}" Classes="mono" TextTrimming="CharacterEllipsis" />
                  <ItemsControl ItemsSource="{Binding Systems}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="chip" Padding="8,2" CornerRadius="8">
                          <TextBlock Text="{Binding}" FontSize="11.5" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="meta" FontSize="12" Margin="0,2,0,0">
                    <Run Text="{l:T emulators.modes}" /><Run Text=" " /><Run Text="{Binding ModesText}" />
                  </TextBlock>
                  <TextBlock Text="{Binding CoresText}" Classes="meta" FontSize="12" IsVisible="{Binding HasCores}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                  <Button Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{l:T emulators.openFolder}" Theme="{StaticResource RhIconButton}">
                    <c:RhIcon Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
                  </Button>
                  <Button Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).OpenDownloadCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding HasDownload}" ToolTip.Tip="{l:T emulators.download}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:RhIcon Data="{StaticResource Icon.External}" Width="16" Height="16" />
                      <TextBlock Text="{l:T emulators.website}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</p:PageBase>
