<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.EmulatorsPage"
            x:DataType="vm:EmulatorsViewModel">
  <!--
    Emulatoren (workbench sweep, DESIGN 7.6; the per-system rows follow in M6): flat rows on the room with a 1 px edge
    line, no row panels, no letter avatars, no status pills. State = icon + text; the path in Cascadia Mono only;
    systems as mini spines (8×48 colour band + code); start modes as a sentence.
  -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource RhPageInset}" Spacing="0" MaxWidth="1400" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{l:T nav.emulators}" Classes="title" />
          <TextBlock c:Sentence.Text="{Binding SummaryText}" Classes="meta" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
          <Button Command="{Binding OpenEmulatorsFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:RhIcon Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
              <TextBlock Text="{l:T emulators.openFolder}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="RefreshButton" Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:RhIcon Data="{StaticResource Icon.Refresh}" Width="18" Height="18" />
              <TextBlock Text="{l:T emulators.refresh}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <TextBlock Text="{l:T emulators.intro}" Classes="read" MaxWidth="860" HorizontalAlignment="Left" Margin="0,14,0,16" TextWrapping="Wrap" />
      <!-- filtered from a game's "Emulator einrichten": a paper label plus the way back to all -->
      <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsFiltered}" Margin="0,0,0,12">
        <c:ShelfLabel Text="{Binding FilterText}" VerticalAlignment="Center" />
        <Button Theme="{StaticResource RhGhostButton}" Command="{Binding ShowAllCommand}" Content="{l:T emulators.showAll}" />
      </StackPanel>
      <Border Height="1" Background="{DynamicResource RhLineBrush}" />

      <ItemsControl Name="List" ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EmulatorItemViewModel">
            <Panel>
              <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource RhLineBrush}" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,20">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="{Binding Name}" Classes="ui-l" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsMissing}" VerticalAlignment="Center">
                      <c:RhIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource RhWarningBrush}" />
                      <TextBlock Text="{Binding StatusText}" Classes="ui" Foreground="{DynamicResource RhWarningBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsInstalled}" VerticalAlignment="Center">
                      <c:RhIcon Data="{StaticResource Icon.Ok}" Width="20" Height="20" Foreground="{DynamicResource RhSuccessBrush}" />
                      <TextBlock Text="{Binding StatusText}" Classes="ui" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock c:Sentence.Text="{Binding VersionText}" Classes="meta" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding PathPrefix}" FontFamily="{DynamicResource RhFontRead}" FontSize="18" Foreground="{DynamicResource RhText2Brush}" />
                    <Run Text=" " FontSize="18" />
                    <Run Text="{Binding PathOnly}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource RhText2Brush}" />
                  </TextBlock>
                  <TextBlock Text="{Binding ModesSentence}" Classes="read" Foreground="{DynamicResource RhText2Brush}" />
                  <TextBlock Text="{Binding CoresText}" Classes="meta" IsVisible="{Binding HasCores}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top" HorizontalAlignment="Right">
                  <!-- the systems as mini spines -->
                  <ItemsControl ItemsSource="{Binding Spines}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SystemSpine">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Width="8" Height="48" Background="{Binding Color}" />
                          <TextBlock Text="{Binding Code}" Classes="spine" FontSize="22" Foreground="{DynamicResource RhText1Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="{l:T emulators.openFolder}" Theme="{StaticResource RhGhostButton}" MinHeight="44">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:RhIcon Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
                        <TextBlock Text="{l:T emulators.openFolder}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding $parent[p:PageBase].((vm:EmulatorsViewModel)DataContext).OpenDownloadCommand}" CommandParameter="{Binding}"
                            IsVisible="{Binding HasDownload}" ToolTip.Tip="{l:T emulators.download}" Theme="{StaticResource RhGhostButton}" MinHeight="44">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:RhIcon Data="{StaticResource Icon.External}" Width="18" Height="18" />
                        <TextBlock Text="{l:T emulators.website}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</p:PageBase>
