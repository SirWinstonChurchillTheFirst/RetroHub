<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.SystemsPage"
            x:DataType="vm:SystemsViewModel">
  <!-- Konsolen (M1 foundation state): one painted wall per system. The spine shelf with the turning front follows in M5 (DESIGN 7.4). -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource RhPageInset}" Spacing="8">
      <TextBlock c:Sentence.Text="{Binding SummaryText}" Classes="read" Margin="0,0,0,16" />
      <!-- columns follow the page width (code-behind), walls stretch to fill the row -->
      <ItemsControl Name="Cards" ItemsSource="{Binding Systems}" ClipToBounds="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" ColumnSpacing="24" RowSpacing="32" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SystemItemViewModel">
            <c:SystemCard Height="200" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding HasEmptySystems}" Spacing="12" Margin="0,40,0,0">
        <c:ShelfLabel Text="{l:T systems.withoutGames}" />
        <TextBlock Text="{l:T systems.withoutGames.hint}" Classes="read" MaxWidth="760" HorizontalAlignment="Left" />
        <ItemsControl ItemsSource="{Binding EmptySystems}" Margin="0,6,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="24" LineSpacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SystemItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="3" Height="14" Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Classes="ui" Foreground="{DynamicResource RhText2Brush}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</p:PageBase>
