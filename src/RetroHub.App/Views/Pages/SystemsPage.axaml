<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.SystemsPage"
            x:DataType="vm:SystemsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,4,40,40" Spacing="8">
      <TextBlock Text="{l:T nav.systems}" Classes="title" />
      <TextBlock Text="{Binding SummaryText}" Classes="meta" />
      <!-- columns follow the page width (code-behind), cards stretch to fill the row -->
      <ItemsControl Name="Cards" ItemsSource="{Binding Systems}" Margin="0,22,0,0" ClipToBounds="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" ColumnSpacing="20" RowSpacing="20" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SystemItemViewModel">
            <c:SystemCard Height="172" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding HasEmptySystems}" Spacing="12" Margin="0,28,0,0">
        <TextBlock Text="{l:T systems.withoutGames}" Classes="h2" />
        <TextBlock Text="{l:T systems.withoutGames.hint}" Classes="body" MaxWidth="720" HorizontalAlignment="Left" />
        <ItemsControl ItemsSource="{Binding EmptySystems}" Margin="0,6,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="10" LineSpacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SystemItemViewModel">
              <Border Classes="chip" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</p:PageBase>
