<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.SystemsPage"
            x:DataType="vm:SystemsViewModel">
  <!--
    Konsolen "Die Fächerwand" (DESIGN 7.4, M5). No card grid: the systems with games stand as SPINES on one stage board
    (128 × 460, band, texture, the code hanging under the band, the motif at the foot, the count); the focused one turns
    its FRONT forward (520 × 600: its wall with band and texture, name, maker and year, an inner shelf with three of its
    games, the count and the motif below it) and stands in slot 3 (the row glides; offsets from the target widths). The
    page ground is the wall of the focused system in shadow. Under the board the position rail (one tick per system,
    the current one with its code; "Fach 3 von 13" right); below a low edge with the systems without games as thin,
    quiet spines ("Noch leer"). Nothing scrolls vertically.
    Narrow pages (logical height < 860, class "compact"): spines 96 × 360, front 380 × 460 (two boxes on its shelf).
  -->
  <p:PageBase.Styles>
    <!-- R3 QA 2: the binders are 520 (≈1100: 400) tall – a 160 px dead band stood above 460 px spines beside the 600 px front -->
    <Style Selector="c|SystemSpine.wall">
      <Setter Property="Height" Value="600" />
      <Setter Property="SpineHeight" Value="520" />
      <Setter Property="SpineWidth" Value="128" />
      <Setter Property="FrontWidth" Value="520" />
      <Setter Property="ShowMotif" Value="True" />
    </Style>
    <!-- R3 QA 3 (a 160 px dead band of felt under the rail when there is no "Noch leer" row): without that row the
         wall grows to fill the page – binders 162 × 660, front 658 × 760 (class "tall", 1080 only) -->
    <Style Selector="Panel.tall c|SystemSpine.wall">
      <Setter Property="Height" Value="760" />
      <Setter Property="SpineHeight" Value="660" />
      <Setter Property="SpineWidth" Value="162" />
      <Setter Property="FrontWidth" Value="658" />
    </Style>
    <Style Selector="Panel.compact c|SystemSpine.wall">
      <Setter Property="Height" Value="460" />
      <Setter Property="SpineHeight" Value="400" />
      <Setter Property="SpineWidth" Value="96" />
      <Setter Property="FrontWidth" Value="380" />
    </Style>
    <!-- "Noch leer": sleeves around 56 × 168 (≈1100: 48 × 116), each seeded wider or narrower (−14 … +10), packed 2 px
         apart (R3 QA: the row filled two thirds of the board as a comb of equal swatches) -->
    <Style Selector="c|SystemSpine.unused">
      <Setter Property="Height" Value="168" />
      <Setter Property="SpineWidth" Value="56" />
      <Setter Property="Opens" Value="False" />
    </Style>
    <Style Selector="Panel.compact c|SystemSpine.unused">
      <Setter Property="Height" Value="116" />
      <Setter Property="SpineWidth" Value="48" />
    </Style>
    <Style Selector="c|Shelf#Wall">
      <Setter Property="ItemHeight" Value="600" />
      <Setter Property="AnchorX" Value="272" />
    </Style>
    <Style Selector="Panel.tall c|Shelf#Wall">
      <Setter Property="ItemHeight" Value="760" />
      <Setter Property="AnchorX" Value="340" />
    </Style>
    <Style Selector="Panel.compact c|Shelf#Wall">
      <Setter Property="ItemHeight" Value="460" />
      <Setter Property="AnchorX" Value="208" />
    </Style>
    <Style Selector="c|EmptySlot.wall">
      <Setter Property="Recessed" Value="True" />
      <Setter Property="Width" Value="128" />
      <Setter Property="Height" Value="520" />
    </Style>
    <Style Selector="Panel.compact c|EmptySlot.wall">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="400" />
    </Style>
  </p:PageBase.Styles>
  <p:PageBase.Resources>
    <DataTemplate x:Key="WallSpine" x:DataType="vm:SystemItemViewModel">
      <c:SystemSpine Classes="wall" VerticalAlignment="Bottom" />
    </DataTemplate>
    <DataTemplate x:Key="UnusedSpine" x:DataType="vm:SystemItemViewModel">
      <c:SystemSpine Classes="unused" VerticalAlignment="Bottom" />
    </DataTemplate>
  </p:PageBase.Resources>

  <Panel Name="Root">
    <!-- R3 QA 2 (a flat #121315 code canvas): the wall behind the binders is a material – a dark painted plaster tile
         (generated, neutral, no hue) at low contrast and the fixed light of one lamp above, falling off downward -->
    <c:WallSurface Name="WallSurface" />
    <StackPanel Name="Stack" VerticalAlignment="Top" Margin="0,88,0,0" Spacing="0">
      <!-- the wall: one stage board, spines and the open front standing on it (slot 3) -->
      <Panel>
        <c:Shelf Name="Wall" ItemsSource="{Binding Systems}" ItemTemplate="{StaticResource WallSpine}" ItemSpacing="8" TopGap="0"
                 ItemsMargin="{DynamicResource RhPageInsetX}" BoardLook="{Binding Current.Look, FallbackValue={x:Null}}" />
        <!-- an empty library: where the front would stand, one sentence and the way to the imports; the board waits with
             outlined places for spines -->
        <StackPanel Name="EmptyPlaces" Orientation="Horizontal" Spacing="8" Margin="{DynamicResource RhPageInsetX}" VerticalAlignment="Top"
                    IsVisible="{Binding IsLibraryEmpty}" ClipToBounds="True">
          <StackPanel Name="EmptyText" Width="520" VerticalAlignment="Bottom" Margin="0,0,24,40">
            <TextBlock Classes="poster-s" Text="{l:T systems.emptyTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="read-l" Text="{l:T systems.emptyText}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Button Name="EmptyImports" MinHeight="56" Padding="24,0" Margin="0,28,0,0" HorizontalAlignment="Left" Command="{Binding OpenImportsCommand}">
              <TextBlock Text="{l:T system.openImports}" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
          <!-- R3 QA 2: five empty binders and one leaning on them (eight in a row read as lockers) -->
          <c:EmptySlot Classes="wall" /><c:EmptySlot Classes="wall" /><c:EmptySlot Classes="wall" /><c:EmptySlot Classes="wall" />
          <c:EmptySlot Classes="wall" /><c:EmptySlot Classes="wall" Lean="True" Margin="6,0,0,0" />
        </StackPanel>
      </Panel>

      <!-- the position rail: one tick per system on the wall (a click turns that front forward), the current one with its
           code; right the position in a fixed column, never touching the rail ("Noch leer · 3 von 20" on the low edge) -->
      <!-- R3 QA 2: the rail runs up to the position tag (16 px before it), no dead column between them -->
      <Grid Name="TickerRow" ColumnDefinitions="*,Auto" Margin="{DynamicResource RhPageInsetX}" Height="52" IsVisible="{Binding HasSystems}">
        <c:PositionRail Name="Rail" Systems="{Binding Systems}" Current="{Binding Current}" Margin="0,0,16,0" />
        <!-- the position in a small window set into the bench, like the dial's counter (M7 "gezeichnet") -->
        <!-- R3: the position on a riveted metal tag (rendered, like the count tags on the spines) -->
        <!-- R3 QA 3: a paper card in a steel clamp frame (rendered "sign"), printed in ink in the binders' label face -->
        <c:TagPlate Name="PositionTag" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-2" Height="34"
                    IsVisible="{Binding PositionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock FontFamily="{DynamicResource RhFontSpine}" FontWeight="Bold" FontSize="17" Foreground="#0B0C0E" Margin="26,0,26,1"
                     VerticalAlignment="Center" Text="{Binding PositionText}" />
        </c:TagPlate>
      </Grid>

      <!-- the systems without games: thin, quiet spines on a low edge, the label hangs at its front -->
      <Panel Name="UnusedShelf" IsVisible="{Binding HasEmptySystems}" Margin="0,32,0,0">
        <c:Shelf Name="Unused" WheelScrollsRow="True" Bookend="True" ItemsSource="{Binding EmptySystems}" ItemTemplate="{StaticResource UnusedSpine}" ItemSpacing="2" TopGap="0"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}" Header="{l:T systems.unused}"
                 BoardLook="{Binding Current.Look, FallbackValue={x:Null}}"
                 ItemHeight="168" AnchorX="640" />
      </Panel>
    </StackPanel>
  </Panel>
</p:PageBase>
