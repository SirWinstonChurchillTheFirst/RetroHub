<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.HomePage"
            x:DataType="vm:HomeViewModel">
  <!--
    Start (M1 foundation state): the box of the game to continue stands on the stage board, the text block is
    anchored bottom left; below, shelves carry paper labels. The TV screen as the hero, measured titles and the
    shelf anchors follow in M2 (DESIGN 7.1).
  -->
  <p:PageBase.Resources>
    <DataTemplate x:Key="ShelfGame" x:DataType="vm:GameItemViewModel">
      <c:GameTile Width="150" Height="200" ShowCaption="False" />
    </DataTemplate>
    <DataTemplate x:Key="ShelfSystem" x:DataType="vm:SystemItemViewModel">
      <c:SystemCard Width="200" Height="200" />
    </DataTemplate>
  </p:PageBase.Resources>

  <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="0">
      <!-- ===== stage ===== -->
      <Grid Name="Stage" Height="488" ColumnDefinitions="*,Auto" Margin="{DynamicResource RhPageInsetX}" IsVisible="{Binding HasContinue}">
        <StackPanel VerticalAlignment="Bottom" Spacing="0" Margin="0,0,48,32">
          <TextBlock Classes="label accent" FontSize="18">
            <Run Text="{l:T home.continue}" /><Run Text=": " /><Run Text="{Binding Continue.LastPlayedText}" />
          </TextBlock>
          <TextBlock Text="{Binding Continue.Title}" Classes="poster" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,12,0,0" />
          <TextBlock c:Sentence.Text="{Binding ContinueMeta}" Classes="read-l" Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,28,0,0">
            <Button Name="PlayButton" Theme="{StaticResource RhPrimaryButton}" Command="{Binding PlayContinueCommand}" MinWidth="280" MinHeight="64">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <c:RhIcon Data="{StaticResource Icon.Play}" Filled="True" Width="24" Height="24" />
                <TextBlock Text="{l:T detail.play}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding OpenContinueCommand}" MinHeight="64" Padding="28,0">
              <TextBlock Text="{l:T home.details}" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </StackPanel>
        <!-- the box stands on the board (contain, bottom-aligned) -->
        <Panel Grid.Column="1" Width="300" Height="420" VerticalAlignment="Bottom">
          <c:CoverArt Name="StageBox" Source="{Binding Continue.CoverPath}" Title="{Binding Continue.Title}" Badge="{Binding Continue.SystemShort}"
                      SystemId="{Binding Continue.SystemId}" Accent="{Binding Continue.Accent}" />
        </Panel>
      </Grid>

      <!-- ===== empty library ===== -->
      <Grid Height="488" Margin="{DynamicResource RhPageInsetX}" IsVisible="{Binding !HasContinue}">
        <StackPanel VerticalAlignment="Bottom" Spacing="12" Margin="0,0,0,32" MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="{l:T home.empty.title}" Classes="poster" TextWrapping="Wrap" />
          <TextBlock Text="{l:T home.empty.text}" Classes="read-l" />
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0">
            <Button Theme="{StaticResource RhPrimaryButton}" Command="{Binding ShowImportsCommand}" Content="{l:T home.importGames}" />
            <Button Command="{Binding ShowLibraryCommand}" Content="{l:T home.openLibrary}" MinHeight="56" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- the stage board, edge to edge; the TV light ends here (RoomBackdrop) -->
      <c:ShelfBoard Name="StageBoard" Height="24" />

      <!-- ===== shelves: paper labels on the boards instead of headings ===== -->
      <StackPanel Spacing="8" Margin="0,8,0,48">
        <c:Shelf Header="{l:T home.shelf.recent}" ItemsSource="{Binding RecentlyPlayed}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.showAll}" ActionCommand="{Binding ShowLibraryCommand}" IsVisible="{Binding HasRecentlyPlayed}" />
        <c:Shelf Header="{l:T home.shelf.favorites}" ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.showAll}" ActionCommand="{Binding ShowFavoritesCommand}" IsVisible="{Binding HasFavorites}" />
        <c:Shelf Header="{l:T home.shelf.added}" ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 IsVisible="{Binding HasRecentlyAdded}" />
        <c:Shelf Header="{l:T home.shelf.platforms}" ItemsSource="{Binding Platforms}" ItemTemplate="{StaticResource ShelfSystem}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.allPlatforms}" ActionCommand="{Binding ShowSystemsCommand}" ItemSpacing="16" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</p:PageBase>
