<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.HomePage"
            x:DataType="vm:HomeViewModel">
  <!--
    Start "Der Fernseher im Regal" (DESIGN 7.1, M2). Nothing scrolls: the STAGE (text | box | TV) stands on the stage
    board at y 488 of the page (1920×1080 logical: window y 560); the SHELVES live in their own clipped area below it
    and glide so that the active shelf's boxes start at the vertical anchor (window y 632), the next shelf peeks in.
    The stage follows the focus: a shelf item that keeps the focus for the dwell time (220 ms) is shown on the stage.
    Narrow windows (logical height < 860) use the ≈1100 values (class "compact", set in code-behind).
  -->
  <p:PageBase.Styles>
    <Style Selector="c|GameTile.shelf">
      <Setter Property="Height" Value="200" />
    </Style>
    <Style Selector="c|SystemSpine.shelf">
      <Setter Property="Height" Value="200" />
    </Style>
    <Style Selector="Panel.compact c|GameTile.shelf">
      <Setter Property="Height" Value="160" />
    </Style>
    <Style Selector="Panel.compact c|SystemSpine.shelf">
      <Setter Property="Height" Value="160" />
      <Setter Property="SpineWidth" Value="56" />
      <Setter Property="FrontWidth" Value="160" />
    </Style>
    <Style Selector="c|Shelf">
      <Setter Property="ItemHeight" Value="200" />
      <Setter Property="TopGap" Value="40" />
      <Setter Property="AnchorX" Value="144" />
    </Style>
    <Style Selector="Panel.compact c|Shelf">
      <Setter Property="ItemHeight" Value="160" />
      <Setter Property="TopGap" Value="32" />
      <Setter Property="AnchorX" Value="112" />
    </Style>
    <!-- the empty library's shelf: recessed places waiting to be filled (M5 QA: no dashed outlines) -->
    <Style Selector="c|EmptySlot">
      <Setter Property="Recessed" Value="True" />
      <Setter Property="Width" Value="150" />
      <Setter Property="Height" Value="200" />
    </Style>
    <Style Selector="Panel.compact c|EmptySlot">
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="160" />
    </Style>
    <!-- the stage text: the label line in the light colour, the title measured, the sentence with Archivo numbers -->
    <Style Selector="TextBlock.stage-label">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="18" />
    </Style>
  </p:PageBase.Styles>
  <p:PageBase.Resources>
    <DataTemplate x:Key="ShelfGame" x:DataType="vm:GameItemViewModel">
      <c:GameTile Classes="shelf" ShowCaption="False" ShowFavorite="False" SlotAspect="{Binding CoverAspect}" FitToImage="True" VerticalAlignment="Bottom" />
    </DataTemplate>
    <DataTemplate x:Key="ShelfSystem" x:DataType="vm:SystemItemViewModel">
      <c:SystemSpine Classes="shelf" VerticalAlignment="Bottom" />
    </DataTemplate>
    <DataTemplate x:Key="ShelfSlot">
      <c:EmptySlot VerticalAlignment="Bottom" />
    </DataTemplate>
  </p:PageBase.Resources>

  <Panel Name="Root">
    <!-- the stage board first: the stage box's lit board piece and the contact shadows lie on top of it -->
    <c:ShelfBoard Name="StageBoard" Height="24" VerticalAlignment="Top" Margin="0,488,0,0" />

    <!-- ===== stage: text | box | TV, all standing on the stage board ===== -->
    <Grid Name="Stage" Height="488" VerticalAlignment="Top" ColumnDefinitions="*,52,Auto,52,Auto" Margin="{DynamicResource RhPageInsetX}">
      <StackPanel Name="TextColumn" VerticalAlignment="Bottom" Margin="0,0,0,32" x:DataType="vm:StageState">
        <StackPanel.RenderTransform>
          <TranslateTransform />
        </StackPanel.RenderTransform>
        <TextBlock Name="StageLabel" Classes="stage-label" Text="{Binding Label}" Foreground="{Binding LabelBrush}" IsVisible="{Binding !IsEmpty}" />
        <c:FitText Name="StageTitle" Classes="poster" Source="{Binding Title}" Sizes="72,56,40" MaxLines="2" LineFactor="1.06" Margin="0,12,0,0" />
        <TextBlock Name="StageMeta" c:Sentence.Text="{Binding Meta}" Classes="read-l" Margin="0,12,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" MaxWidth="760" />
        <StackPanel Name="Actions" Orientation="Horizontal" Spacing="16" Margin="0,28,0,0">
          <Button Name="PlayButton" Theme="{StaticResource RhPrimaryButton}" MinWidth="280" MinHeight="64">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:RhIcon Data="{StaticResource Icon.Play}" Filled="True" Width="24" Height="24" IsVisible="{Binding IsGame}" />
              <c:RhIcon Data="{StaticResource Icon.Folder}" Width="24" Height="24" IsVisible="{Binding IsEmpty}" />
              <TextBlock Text="{Binding PrimaryLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="DetailsButton" MinHeight="64" Padding="28,0" IsVisible="{Binding IsGame}">
            <TextBlock Text="{l:T home.details}" VerticalAlignment="Center" />
          </Button>
          <Button Name="FavoriteButton" Theme="{StaticResource RhIconButton}" Width="64" Height="64" IsVisible="{Binding IsGame}"
                  ToolTip.Tip="{l:T home.favorite}" AutomationProperties.Name="{l:T home.favorite}">
            <Panel>
              <c:RhIcon Data="{StaticResource Icon.Favorite}" Width="28" Height="28" IsVisible="{Binding !Game.IsFavorite}" />
              <c:RhIcon Data="{StaticResource Icon.Favorite}" Filled="True" Width="28" Height="28" Foreground="{DynamicResource RhFavoriteBrush}"
                        IsVisible="{Binding Game.IsFavorite}" />
            </Panel>
          </Button>
          <Button Name="ImportsButton" MinHeight="64" Padding="28,0" IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{l:T home.openImports}" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- the box stands on the board (contain, bottom-aligned); focusable: confirm opens the game -->
      <Panel Name="BoxSlot" Grid.Column="2" Width="300" Height="420" VerticalAlignment="Bottom" ClipToBounds="False">
        <c:GameTile Name="StageBox" ShowCaption="False" ShowFavorite="False" x:DataType="vm:GameItemViewModel" />
        <c:EmptyShelfDrawing Name="EmptyDrawing" IsVisible="False" Width="240" Height="240" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
      </Panel>

      <!-- the TV: the room light has a visible source (snap → title screen → "Kein Signal" → off) -->
      <c:PixelScreen Name="Screen" Grid.Column="4" Width="560" Height="451" VerticalAlignment="Bottom"
                     PicturePath="{Binding StageScreen}" SystemId="{Binding Stage.SystemId}" Accent="{Binding Stage.Accent}"
                     Code="{Binding Stage.Code}" IsTvSystem="{Binding Stage.IsTvSystem}" IsOff="{Binding Stage.IsEmpty}" />
    </Grid>

    <!-- ===== shelves: paper labels on the boards instead of headings, "Alle anzeigen" as a spine ===== -->
    <c:ShelfViewport Name="Shelves" Margin="0,520,0,0" AnchorY="40">
      <StackPanel Name="ShelfList" Spacing="52">
        <c:Shelf Name="RecentShelf" Header="{l:T home.shelf.recent}" ItemsSource="{Binding RecentlyPlayed}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.showAll}" ActionCommand="{Binding ShowRecentCommand}" IsVisible="{Binding HasRecentlyPlayed}" />
        <c:Shelf Name="FavoritesShelf" Header="{l:T home.shelf.favorites}" ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.showAll}" ActionCommand="{Binding ShowFavoritesCommand}" IsVisible="{Binding HasFavorites}" />
        <c:Shelf Name="AddedShelf" Header="{l:T home.shelf.added}" ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.showAll}" ActionCommand="{Binding ShowAddedCommand}" IsVisible="{Binding HasRecentlyAdded}" />
        <c:Shelf Name="SystemsShelf" Header="{l:T home.shelf.platforms}" ItemsSource="{Binding Platforms}" ItemTemplate="{StaticResource ShelfSystem}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.allPlatforms}" ActionCommand="{Binding ShowSystemsCommand}" ItemSpacing="8" IsVisible="{Binding HasPlatforms}" />
        <!-- an empty library still has its board with the label "Noch leer": five outlined slots waiting to be filled
             (not focusable; the items are set in code) -->
        <c:Shelf Name="EmptyShelf" Header="{l:T home.shelf.empty}" ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ItemTemplate="{StaticResource ShelfSlot}" IsVisible="{Binding IsLibraryEmpty}" />
      </StackPanel>
    </c:ShelfViewport>
    <!-- the shelf that peeks in from below shows only the top of its boxes (bands, codes of covers – never a half
         title): a short gradient, then the room; a flat-tone overlay, no opacity mask. Its top is set in code.
         It takes the pointer (R2): the boxes under it are invisible and must not be clicked; a click or the wheel
         there brings the next shelf up. -->
    <StackPanel Name="ShelfFade" VerticalAlignment="Top" Background="Transparent" Cursor="Hand">
      <Border Height="24">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#0014120F" Offset="0" />
            <GradientStop Color="#FF14120F" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Height="600" Background="#14120F" />
    </StackPanel>
  </Panel>
</p:PageBase>
