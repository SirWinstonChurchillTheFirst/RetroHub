<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.HomePage"
            x:DataType="vm:HomeViewModel">
  <!--
    Start (M1.5): the TV (interim "Kein Signal" screen, M2 brings the snaps) and the box of the game to continue stand
    on the stage board; the text block is anchored bottom left and its title is measured (72/56/40, two lines).
    Below, shelves with paper labels and an "Alle anzeigen" spine at the end of each board. Narrow windows
    (logical height < 1000) use the ≈1100 values of DESIGN 7.1 (class "compact", set in code-behind).
  -->
  <p:PageBase.Styles>
    <!-- boxes: height 200, width from the system's box format (GameTile.SlotAspect) -->
    <Style Selector="c|GameTile.shelf">
      <Setter Property="Height" Value="200" />
    </Style>
    <Style Selector="c|SystemCard.shelf">
      <Setter Property="Width" Value="200" />
      <Setter Property="Height" Value="200" />
    </Style>
    <Style Selector="StackPanel.compact c|GameTile.shelf">
      <Setter Property="Height" Value="160" />
    </Style>
    <Style Selector="StackPanel.compact c|SystemCard.shelf">
      <Setter Property="Width" Value="160" />
      <Setter Property="Height" Value="160" />
    </Style>
    <Style Selector="StackPanel.compact c|Shelf">
      <Setter Property="ItemHeight" Value="160" />
      <Setter Property="TopGap" Value="32" />
    </Style>
  </p:PageBase.Styles>
  <p:PageBase.Resources>
    <DataTemplate x:Key="ShelfGame" x:DataType="vm:GameItemViewModel">
      <c:GameTile Classes="shelf" ShowCaption="False" SlotAspect="{Binding CoverAspect}" />
    </DataTemplate>
    <DataTemplate x:Key="ShelfSystem" x:DataType="vm:SystemItemViewModel">
      <c:SystemCard Classes="shelf" />
    </DataTemplate>
  </p:PageBase.Resources>

  <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
    <StackPanel Name="PageContent" Spacing="0">
      <!-- ===== stage: text | box | screen, all standing on the stage board ===== -->
      <Grid Name="Stage" Height="488" ColumnDefinitions="*,52,Auto,52,Auto" Margin="{DynamicResource RhPageInsetX}" IsVisible="{Binding HasContinue}">
        <StackPanel Name="TextColumn" VerticalAlignment="Bottom" Spacing="0" Margin="0,0,0,32">
          <TextBlock Classes="label accent" FontSize="18">
            <Run Text="{l:T home.continue}" /><Run Text=": " /><Run Text="{Binding Continue.LastPlayedText}" />
          </TextBlock>
          <c:FitText Name="StageTitle" Classes="poster" Source="{Binding Continue.Title}" Sizes="72,56,40" MaxLines="2" LineFactor="1.06" Margin="0,12,0,0" />
          <TextBlock c:Sentence.Text="{Binding ContinueMeta}" Classes="read-l" Margin="0,12,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,28,0,0">
            <Button Name="PlayButton" Theme="{StaticResource RhPrimaryButton}" Command="{Binding PlayContinueCommand}" MinWidth="280" MinHeight="64">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <c:RhIcon Data="{StaticResource Icon.Play}" Filled="True" Width="24" Height="24" />
                <TextBlock Text="{l:T detail.play}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding OpenContinueCommand}" MinHeight="64" Padding="28,0">
              <TextBlock Text="{l:T home.details}" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </StackPanel>
        <!-- the box stands on the board (contain, bottom-aligned); its placeholder carries no title here -->
        <Panel Name="BoxSlot" Grid.Column="2" Width="300" Height="420" VerticalAlignment="Bottom">
          <c:CoverArt Name="StageBox" Source="{Binding Continue.CoverPath}" Title="{Binding Continue.Title}" Badge="{Binding Continue.SystemShort}"
                      SystemId="{Binding Continue.SystemId}" Accent="{Binding Continue.Accent}" ShowTitle="False" />
        </Panel>
        <!-- the TV: the light of the room has a visible source -->
        <c:TvScreen Name="Screen" Grid.Column="4" Width="560" Height="420" VerticalAlignment="Bottom"
                    SystemId="{Binding Continue.SystemId}" Accent="{Binding Continue.Accent}" Code="{Binding Continue.SystemShort}" />
      </Grid>

      <!-- ===== empty library ===== -->
      <Grid Name="EmptyStage" Height="488" Margin="{DynamicResource RhPageInsetX}" IsVisible="{Binding !HasContinue}">
        <StackPanel VerticalAlignment="Bottom" Spacing="12" Margin="0,0,0,32" MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="{l:T home.empty.title}" Classes="poster" TextWrapping="Wrap" />
          <TextBlock Text="{l:T home.empty.text}" Classes="read-l" />
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0">
            <Button Theme="{StaticResource RhPrimaryButton}" Command="{Binding ShowImportsCommand}" Content="{l:T home.importGames}" />
            <Button Command="{Binding ShowLibraryCommand}" Content="{l:T home.openLibrary}" MinHeight="56" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- the stage board, edge to edge; the TV light ends here (RoomBackdrop); box and screen cast contact shadows -->
      <c:ShelfBoard Name="StageBoard" Height="24" />

      <!-- ===== shelves: paper labels on the boards instead of headings, "Alle anzeigen" as a spine ===== -->
      <StackPanel Name="Shelves" Spacing="0" Margin="0,0,0,48">
        <c:Shelf Header="{l:T home.shelf.recent}" ItemsSource="{Binding RecentlyPlayed}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.showAll}" ActionCommand="{Binding ShowLibraryCommand}" IsVisible="{Binding HasRecentlyPlayed}" />
        <c:Shelf Header="{l:T home.shelf.favorites}" ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.showAll}" ActionCommand="{Binding ShowFavoritesCommand}" IsVisible="{Binding HasFavorites}" />
        <c:Shelf Header="{l:T home.shelf.added}" ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource ShelfGame}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.showAll}" ActionCommand="{Binding ShowLibraryCommand}" IsVisible="{Binding HasRecentlyAdded}" />
        <c:Shelf Header="{l:T home.shelf.platforms}" ItemsSource="{Binding Platforms}" ItemTemplate="{StaticResource ShelfSystem}"
                 ItemsMargin="{DynamicResource RhPageInsetX}" LabelMargin="{DynamicResource RhPageInsetX}"
                 ActionLabel="{l:T home.allPlatforms}" ActionCommand="{Binding ShowSystemsCommand}" ItemSpacing="8" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</p:PageBase>
