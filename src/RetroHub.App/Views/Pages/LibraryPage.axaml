<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.LibraryPage"
            x:DataType="vm:LibraryViewModel">
  <!--
    Library "Das Regal" (DESIGN 7.2, M3). No picture background, no headline: the count and the position live in the
    footer. Fixed on top: the TICKER (system filter, shoulders step through it) with the tools, and the SHELF MIRROR
    (one spine per game, bracket = what is in view, mark = focus). Below the shelf grid (boxes on 10 px shelf edges,
    one focus layer) or the list with its preview. A selected system becomes a compartment: its wall banner heads the
    grid, the page ground and the board light become its wall and light (RoomBackdrop), the slot format comes from its
    stored cover sizes.
    1920×1080 logical: ticker 72–136, bracket 142, mirror 146–158, grid from 168 (first box top 208).
  -->
  <p:PageBase.Resources>
    <DataTemplate x:Key="GridTile" x:DataType="vm:GameItemViewModel">
      <!-- filtered to one system the label line drops the code (DESIGN 7.2.1): bar, variant and year stay -->
      <c:GameTile ShowSticker="True" Classes.no-code="{Binding $parent[p:PageBase].((vm:LibraryViewModel)DataContext).IsSystemSelected, FallbackValue=False}"
                  Classes.bare="{Binding !HasLabelDetail}" />
    </DataTemplate>
    <DataTemplate x:Key="ListRow" x:DataType="vm:GameItemViewModel">
      <c:GameTile Theme="{StaticResource RhGameRow}" />
    </DataTemplate>
  </p:PageBase.Resources>

  <p:PageBase.Styles>
    <!-- narrow: the tools are icons only -->
    <Style Selector="StackPanel#Tools.compact TextBlock.tool-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- ticker entry: code chip (6×4, R 2) + count; active = code in paper and the underline; focus = the chip inverts -->
    <Style Selector="Border.code-chip">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.code-chip">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.09" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.code-text">
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    </Style>
    <Style Selector="Button.ticker:pointerover TextBlock.code-text">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="Button.ticker.selected TextBlock.code-text">
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="Button.ticker:focus-visible Border.code-chip">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
    <Style Selector="Button.ticker:focus-visible TextBlock.code-text">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <!-- the shoulder plates at the ticker's ends: quiet Regal-hell plates (never the brightest thing on the page);
         hover/press inverts them to paper. A click steps like the shoulder button. They are neutral step plates in both
         input modes (keyboard caps "Strg+Bild auf" pushed the last systems out of the ticker); the footer names the key. -->
    <Style Selector="Button.shoulder">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="44" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- R3 QA: the shoulder wedges (◤ ◥) did not read as "previous/next" – a 32 × 32 chevron plate like the start shelf's -->
    <Style Selector="Button.shoulder Border.chev">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource RhSurfaceHiBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RhLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.shoulder Border.chev c|RhIcon">
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    </Style>
    <Style Selector="Button.shoulder:pointerover Border.chev">
      <Setter Property="Background" Value="{DynamicResource RhPaperBrush}" />
    </Style>
    <Style Selector="Button.shoulder:pointerover Border.chev c|RhIcon">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
    <!-- favourites tool on: the star filled in favourite yellow (the status colour, never Cyan) -->
    <Style Selector="ToggleButton#FavToggle:checked c|RhIcon#FavIcon">
      <Setter Property="Filled" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource RhFavoriteBrush}" />
    </Style>
    <Style Selector="ToggleButton#FavToggle:focus-visible c|RhIcon#FavIcon">
      <Setter Property="Foreground" Value="{DynamicResource RhInkBrush}" />
    </Style>
  </p:PageBase.Styles>

  <Grid RowDefinitions="64,32,*">
    <!-- ===== ticker (system filter) + tools ===== -->
    <!-- an empty library has no ticker at all (no orphan "Alle 0") -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{DynamicResource RhPageInsetX}" IsVisible="{Binding !IsLibraryEmpty}">
      <Button Name="ShoulderLeft" Theme="{StaticResource RhTickerItem}" Classes="shoulder" Margin="0,0,16,0" Command="{Binding PreviousChipCommand}"
              ToolTip.Tip="{l:T library.prevShelf}">
        <Border Classes="chev"><c:RhIcon Data="{StaticResource Icon.ChevronLeft}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      </Button>
      <Panel Grid.Column="1" VerticalAlignment="Center">
        <ScrollViewer Name="TickerScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl Name="Ticker" ItemsSource="{Binding Chips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="26" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterChip">
                <Button Theme="{StaticResource RhTickerItem}" Classes="ticker" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[p:PageBase].((vm:LibraryViewModel)DataContext).SelectChipCommand}" CommandParameter="{Binding}">
                  <!-- code chip and count on one line; the 3 px underline in the system's colour (Cyan for "Alle")
                       sits under the code, 6 px below the baseline -->
                  <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,7,0,0">
                    <Border Classes="code-chip">
                      <TextBlock Classes="code code-text" Text="{Binding Label}" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="number" Text="{Binding Count}" FontSize="15" Foreground="{DynamicResource RhText3Brush}"
                               VerticalAlignment="Center" Margin="2,1,0,0" />
                    <Panel Grid.Row="1" Height="3" Margin="6,2,6,0" IsVisible="{Binding IsSelected}">
                      <Border Background="{Binding MarkBrush}" IsVisible="{Binding !IsAll}" />
                      <Border Background="{DynamicResource RhAccentBrush}" IsVisible="{Binding IsAll}" />
                    </Panel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <!-- 48 px fades in the page ground at the ticker edges (overlays, no OpacityMask; colours set in code) -->
        <Border Name="FadeLeft" Width="48" HorizontalAlignment="Left" IsHitTestVisible="False" IsVisible="False" />
        <Border Name="FadeRight" Width="48" HorizontalAlignment="Right" IsHitTestVisible="False" IsVisible="False" />
        <!-- the search field, slid out over the ticker -->
        <Border Name="SearchPanel" Width="360" HorizontalAlignment="Right" Padding="12,0,0,0" IsVisible="False">
          <TextBox Name="Search" Classes="search" Text="{Binding SearchText}" PlaceholderText="{l:T library.searchPlaceholder}">
            <TextBox.InnerRightContent>
              <Button Theme="{StaticResource RhGhostButton}" Width="32" Height="32" MinHeight="0" Padding="0" Margin="0,0,6,0" Focusable="False"
                      Command="{Binding ClearSearchCommand}" IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <c:RhIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
        </Border>
      </Panel>
      <!-- 16 px air between the ticker's clip edge (with its 48 px fade) and the right plate (M3 QA) -->
      <Button Name="ShoulderRight" Grid.Column="2" Theme="{StaticResource RhTickerItem}" Classes="shoulder" Margin="16,0,24,0" Command="{Binding NextChipCommand}"
              ToolTip.Tip="{l:T library.nextShelf}">
        <Border Classes="chev"><c:RhIcon Data="{StaticResource Icon.ChevronRight}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      </Button>
      <!-- tools: 44 high, frameless, focus = inversion -->
      <StackPanel Name="Tools" Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding !IsLibraryEmpty}">
        <Button Name="SearchToggle" Theme="{StaticResource RhGhostButton}" Height="44" MinHeight="44" Width="44" Padding="0"
                ToolTip.Tip="{l:T hint.search}" AutomationProperties.Name="{l:T hint.search}">
          <c:RhIcon Data="{StaticResource Icon.Search}" Width="22" Height="22" />
        </Button>
        <Button Name="SortButton" Theme="{StaticResource RhGhostButton}" Height="44" MinHeight="44" Padding="11,0" ToolTip.Tip="{l:T library.sort}"
                AutomationProperties.Name="{l:T library.sort}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Data="{StaticResource Icon.Sort}" Width="22" Height="22" />
            <TextBlock Classes="tool-label" Text="{Binding SelectedSort.Label}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ToggleButton Name="FavToggle" IsChecked="{Binding FavoritesOnly}" Theme="{StaticResource RhToggleChip}" ToolTip.Tip="{l:T library.favoritesOnly}"
                      Height="44" Padding="11,0" AutomationProperties.Name="{l:T library.favoritesOnly}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Name="FavIcon" Data="{StaticResource Icon.Star}" Width="22" Height="22" />
            <TextBlock Classes="tool-label" Text="{l:T library.favorites}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <!-- one view tool (no second "selected" underline: Cyan belongs to the ticker's "Alle") -->
        <Button Name="ViewToggle" Theme="{StaticResource RhGhostButton}" Height="44" MinHeight="44" Padding="11,0" Command="{Binding ToggleViewCommand}"
                ToolTip.Tip="{l:T library.view}" AutomationProperties.Name="{l:T library.view}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Panel Width="22" Height="22">
              <c:RhIcon Data="{StaticResource Icon.Grid}" Width="22" Height="22" IsVisible="{Binding IsGridView}" />
              <c:RhIcon Data="{StaticResource Icon.List}" Width="22" Height="22" IsVisible="{Binding IsListView}" />
            </Panel>
            <Panel>
              <TextBlock Classes="tool-label" Text="{l:T library.view.shelf}" VerticalAlignment="Center" IsVisible="{Binding IsGridView}" />
              <TextBlock Classes="tool-label" Text="{l:T library.view.list}" VerticalAlignment="Center" IsVisible="{Binding IsListView}" />
            </Panel>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== shelf mirror: one spine per game; bracket = in view; mark = focus ===== -->
    <c:ShelfMirror Name="Mirror" Grid.Row="1" Margin="{DynamicResource RhPageInsetX}" VerticalAlignment="Top" Height="24" />

    <!-- ===== shelf grid ===== -->
    <c:CoverGrid Name="Covers" Grid.Row="2" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GridTile}"
                 IsVisible="{Binding IsGridView}" ItemWidth="176" Spacing="28" RowSpacing="24" CoverAspect="{Binding SlotAspect}" CaptionHeight="90"
                 MaxStretch="1.15" ContentPadding="{DynamicResource RhShelfInset}" HeaderBleed="True">
      <c:CoverGrid.Header>
        <!-- the wall banner of a selected system: wall (band, texture), name and sentence left, the motif right standing
             on a stage board; randlos (the negative margins are set in code from the grid's padding) -->
        <Panel Name="Banner" Height="200" IsVisible="{Binding IsSystemSelected}" ClipToBounds="True">
          <c:SystemWall Name="BannerWall" SystemId="{Binding SystemLook.Id, FallbackValue={x:Null}}" Accent="{Binding BannerAccent}" MotifShare="0" TextureOpacity="0.09" />
          <c:ShelfBoard Name="BannerBoard" Height="24" VerticalAlignment="Bottom" WallLook="{Binding SystemLook}" />
          <Panel Name="BannerContent" Margin="{DynamicResource RhPageInsetX}">
            <StackPanel Name="BannerText" VerticalAlignment="Bottom" Margin="0,0,280,48">
              <TextBlock Name="BannerTitle" Classes="poster" Text="{Binding BannerTitle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
              <TextBlock Name="BannerSentence" Classes="read-l" c:Sentence.Text="{Binding BannerSentence}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <c:MotifView Name="BannerMotif" Width="160" Height="160" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,24"
                         SystemId="{Binding SystemLook.Id, FallbackValue={x:Null}}" Accent="{Binding BannerAccent}" />
          </Panel>
        </Panel>
      </c:CoverGrid.Header>
    </c:CoverGrid>

    <!-- ===== list (44 %) + preview (56 %) ===== -->
    <Grid Name="ListView" Grid.Row="2" ColumnDefinitions="44*,56*" IsVisible="{Binding IsListView}">
      <c:CoverGrid Name="Rows" ClickSelectsFirst="True" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ListRow}" ShowBoard="False"
                   ItemWidth="4000" MaxStretch="1" Spacing="0" RowSpacing="0" CoverAspect="0" CaptionHeight="64"
                   ContentPadding="{DynamicResource RhListInset}" />
      <!-- the preview: the box on a shelf edge, the title, the sentence, Spielen and Details. No TV light. -->
      <Grid Name="Preview" Grid.Column="1" RowDefinitions="*,Auto" Margin="56,40,0,48" DataContext="{Binding}" IsVisible="{Binding PreviewItem, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Panel Name="PreviewShelf" ClipToBounds="False">
          <c:CoverArt Name="PreviewArt" MaxWidth="420" MaxHeight="560" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,12"
                      Source="{Binding PreviewItem.CoverPath, FallbackValue={x:Null}}" Title="{Binding PreviewItem.Title, FallbackValue={x:Null}}"
                      Badge="{Binding PreviewItem.SystemShort, FallbackValue={x:Null}}" SystemId="{Binding PreviewItem.SystemId, FallbackValue={x:Null}}"
                      IsMissing="{Binding PreviewItem.IsMissing, FallbackValue=False}" ShowFavorite="False" />
          <c:ShelfBoard Name="PreviewBoard" Height="12" IsEdge="True" VerticalAlignment="Bottom" Margin="-56,0,0,0" />
        </Panel>
        <StackPanel Grid.Row="1" Margin="0,26,96,0" MaxWidth="900" HorizontalAlignment="Left">
          <!-- measured (M3 QA): 40, else 32 px, up to 3 lines before an ellipsis – the tail tells namesakes apart -->
          <c:FitText Name="PreviewTitle" Classes="poster-s" Source="{Binding PreviewItem.WrapCaption, FallbackValue={x:Null}}" Sizes="40,32" MaxLines="3" />
          <TextBlock Name="PreviewMeta" Classes="read-l" c:Sentence.Text="{Binding PreviewMeta}" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" Margin="0,12,0,0" />
          <StackPanel Name="PreviewActions" Orientation="Horizontal" Spacing="16" Margin="0,24,0,0">
            <Button Name="PreviewPlay" Theme="{StaticResource RhPrimaryButton}" MinWidth="240" MinHeight="64" Command="{Binding PlayPreviewCommand}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <c:RhIcon Data="{StaticResource Icon.Play}" Filled="True" Width="24" Height="24" />
                <TextBlock Text="{l:T detail.play}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="PreviewDetails" MinHeight="64" Padding="28,0" Command="{Binding OpenPreviewCommand}">
              <TextBlock Text="{l:T home.details}" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- an empty library (DESIGN 10.3 "Keine Spiele"): the empty shelf drawing on a board, one sentence, the way out -->
    <!-- the empty shelf (M3 QA): no ticker; the board stands at ≈ 45 % of the page (top margin set in code), on it the
         one leaning box (200 high) and recessed places waiting for boxes – the Start page's empty-shelf language –
         and the text block 48 px below the board -->
    <StackPanel Name="EmptyShelf" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsLibraryEmpty}" Margin="{DynamicResource RhPageInsetX}"
                VerticalAlignment="Top" Spacing="0">
      <StackPanel Name="EmptyPlaces" Orientation="Horizontal" Spacing="24" ClipToBounds="True">
        <c:EmptyShelfDrawing Gesture="True" Width="140" Height="200" VerticalAlignment="Bottom" Margin="0,0,8,0" />
        <c:EmptySlot Recessed="True" Width="150" Height="200" VerticalAlignment="Bottom" />
        <c:EmptySlot Recessed="True" Width="150" Height="200" VerticalAlignment="Bottom" />
        <c:EmptySlot Recessed="True" Width="150" Height="200" VerticalAlignment="Bottom" />
        <c:EmptySlot Recessed="True" Width="150" Height="200" VerticalAlignment="Bottom" />
        <c:EmptySlot Name="EmptySlotLast" Recessed="True" Width="150" Height="200" VerticalAlignment="Bottom" />
      </StackPanel>
      <c:ShelfBoard Name="EmptyBoard" Height="12" IsEdge="True" Margin="-200,0,-200,0" />
      <TextBlock Classes="poster-s" Text="{l:T home.empty.title}" Margin="0,48,0,0" />
      <TextBlock Classes="read-l" Text="{l:T home.empty.text}" Margin="0,12,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,28,0,0">
        <Button Name="EmptyAddFolder" Theme="{StaticResource RhPrimaryButton}" MinWidth="280" MinHeight="64" Command="{Binding AddFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <c:RhIcon Data="{StaticResource Icon.Folder}" Width="24" Height="24" />
            <TextBlock Text="{l:T home.addFolder}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button MinHeight="64" Padding="28,0" Command="{Binding OpenImportsCommand}">
          <TextBlock Text="{l:T home.openImports}" VerticalAlignment="Center" />
        </Button>
      </StackPanel>
    </StackPanel>
    <!-- nothing matches search/filter: one sentence and the hint, the search stays open -->
    <StackPanel Grid.Row="2" IsVisible="{Binding IsNoMatch}" Margin="{DynamicResource RhPageInsetX}" VerticalAlignment="Top" Spacing="12">
      <TextBlock Text="{Binding EmptyText}" Classes="poster-s" Margin="0,64,0,0" />
      <TextBlock Text="{l:T library.emptyHint}" Classes="read-l" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</p:PageBase>
