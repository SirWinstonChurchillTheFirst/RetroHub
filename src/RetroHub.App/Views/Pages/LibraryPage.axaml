<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.LibraryPage"
            x:DataType="vm:LibraryViewModel">
  <!--
    Library (M1.5): no picture background, no headline – the count and the position live in the footer. A ticker row
    (system filter) with icon tools on the right, then the shelf grid (boxes on 10 px shelf edges, one focus layer).
    The shelf mirror, the wall banner and the preview list follow in M3 (DESIGN 7.2).
  -->
  <p:PageBase.Resources>
    <DataTemplate x:Key="GridTile" x:DataType="vm:GameItemViewModel">
      <c:GameTile />
    </DataTemplate>
    <DataTemplate x:Key="ListRow" x:DataType="vm:GameItemViewModel">
      <c:GameTile Theme="{StaticResource RhGameRow}" />
    </DataTemplate>
  </p:PageBase.Resources>

  <p:PageBase.Styles>
    <!-- narrow: the tools are icons only -->
    <Style Selector="StackPanel#Tools.compact TextBlock#SortLabel, StackPanel#Tools.compact TextBlock#FavLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </p:PageBase.Styles>

  <Grid RowDefinitions="64,*">
    <!-- ticker (system filter) + tools. Search is an icon that slides a 360 px field out over the ticker; below
         1500 px logical width the tools are icons only (class "compact" on Tools, set in code-behind). -->
    <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource RhPageInsetX}">
      <Panel Margin="-10,0,24,0" VerticalAlignment="Center">
        <ScrollViewer Name="TickerScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl Name="Ticker" ItemsSource="{Binding Chips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterChip">
                <Button Theme="{StaticResource RhChip}" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[p:PageBase].((vm:LibraryViewModel)DataContext).SelectChipCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource RhFontSpine}" FontWeight="Bold" FontSize="17" LetterSpacing="0.6" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Count}" Classes="number" FontSize="15" Opacity="0.7" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <!-- 48 px room fades at the ticker edges (overlays, no OpacityMask) -->
        <Border Name="FadeLeft" Width="48" HorizontalAlignment="Left" IsHitTestVisible="False" IsVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#FF14120F" />
              <GradientStop Offset="1" Color="#0014120F" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border Name="FadeRight" Width="48" HorizontalAlignment="Right" IsHitTestVisible="False" IsVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#0014120F" />
              <GradientStop Offset="1" Color="#FF14120F" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <!-- the search field, slid out over the ticker -->
        <Border Name="SearchPanel" Width="360" HorizontalAlignment="Right" Background="{DynamicResource RhBaseBrush}" Padding="12,0,0,0" IsVisible="False">
          <TextBox Name="Search" Classes="search" Text="{Binding SearchText}" PlaceholderText="{l:T library.searchPlaceholder}">
            <TextBox.InnerRightContent>
              <Button Theme="{StaticResource RhGhostButton}" Width="32" Height="32" MinHeight="0" Padding="0" Margin="0,0,6,0" Focusable="False"
                      Command="{Binding ClearSearchCommand}" IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <c:RhIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
        </Border>
      </Panel>
      <StackPanel Name="Tools" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Name="SearchToggle" Theme="{StaticResource RhGhostButton}" Height="44" MinHeight="44" Width="44" Padding="0"
                ToolTip.Tip="{l:T hint.search}" AutomationProperties.Name="{l:T hint.search}">
          <c:RhIcon Data="{StaticResource Icon.Search}" Width="22" Height="22" />
        </Button>
        <Button Name="SortButton" Theme="{StaticResource RhGhostButton}" Height="44" MinHeight="44" Padding="11,0" ToolTip.Tip="{l:T library.sort}"
                AutomationProperties.Name="{l:T library.sort}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Data="{StaticResource Icon.Sort}" Width="22" Height="22" />
            <TextBlock Name="SortLabel" Text="{Binding SelectedSort.Label}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ToggleButton Name="FavToggle" IsChecked="{Binding FavoritesOnly}" Theme="{StaticResource RhToggleChip}" ToolTip.Tip="{l:T library.favoritesOnly}"
                      Height="44" Padding="11,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:RhIcon Data="{StaticResource Icon.Star}" Width="22" Height="22" />
            <TextBlock Name="FavLabel" Text="{l:T library.favorites}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <Button Theme="{StaticResource RhChip}" Classes.selected="{Binding IsGridView}" Command="{Binding ShowGridCommand}" Width="44" Height="44" Padding="0"
                ToolTip.Tip="{l:T library.gridView}">
          <c:RhIcon Data="{StaticResource Icon.Grid}" Width="22" Height="22" />
        </Button>
        <Button Theme="{StaticResource RhChip}" Classes.selected="{Binding IsListView}" Command="{Binding ShowListCommand}" Width="44" Height="44" Padding="0"
                ToolTip.Tip="{l:T library.listView}">
          <c:RhIcon Data="{StaticResource Icon.List}" Width="22" Height="22" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- shelf grid: 1 : 1.25 slots, boxes stand on 10 px shelf edges -->
    <c:CoverGrid Name="Covers" Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GridTile}"
                 IsVisible="{Binding IsGridView}" ItemWidth="176" Spacing="28" RowSpacing="24" CoverAspect="1.25" CaptionHeight="92" MaxStretch="1.15"
                 ContentPadding="{DynamicResource RhGridInset}" />
    <!-- list -->
    <c:CoverGrid Name="Rows" Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ListRow}" ShowBoard="False"
                 IsVisible="{Binding IsListView}" ItemWidth="4000" MaxStretch="1" Spacing="0" RowSpacing="0" CoverAspect="0" CaptionHeight="64"
                 ContentPadding="{DynamicResource RhPageInset}" />

    <!-- empty state: line drawing + one sentence + the way out -->
    <StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,0,0,80">
      <c:RhIcon Data="{StaticResource Icon.Library}" Width="64" Height="64" Foreground="{DynamicResource RhText2Brush}" HorizontalAlignment="Center" StrokeThickness="1.5" />
      <TextBlock Text="{Binding EmptyText}" Classes="h2" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
      <TextBlock Text="{l:T library.emptyHint}" Classes="read" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520" />
    </StackPanel>
  </Grid>
</p:PageBase>
