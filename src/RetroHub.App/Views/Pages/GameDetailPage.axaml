<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.GameDetailPage"
            x:DataType="vm:GameDetailViewModel">
  <!--
    Spiel-Detail "Die Schachtel aus dem Regal" (DESIGN 7.3, M4). The STAGE: the box pulled from the shelf (generated
    spine + front, one focusable object with lift, cone, lit board piece and ring) stands on the stage board in the TV
    light; the text column (system label, measured title, meta and play sentence, actions) is anchored at the bottom
    right of it. Below the board the "RÜCKSEITE" like the back of a package: "Über das Spiel" (description, then the
    title screen and the snap as two small sets on a shelf edge), "Start" (choice rows, status, file) and the
    "Ausleihkarte" (the last sessions as stamps). Nothing about the game known: the column "Über das Spiel" drops out,
    "Start" moves left and the card takes the right column – the back is never half empty. Narrow windows (logical
    page height < 860) use the ≈1100 values in one column (class "compact", code-behind). Overlays (Mehr, Dateiinfo,
    Weiterlesen, Cover, Bildschirme) lie over the page, the header and the footer stay.
  -->
  <p:PageBase.Styles>
    <Style Selector="TextBlock.stage-label">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <!-- a stamp of "Gespielt" (M4 QA): a rubber stamp - 2 px frame in Text 3 at 70 %, an inner 1 px rule 3 px inside,
         date (15, Text 2) over duration (18, Papier), both on 20 px lines, the numbers in Zahl (Archivo SemiExpanded) and
         the words in the UI face so "unter 1 Min." fits the stamp; tilted by hand (static) -->
    <Style Selector="Border.stamp">
      <Setter Property="BorderBrush" Value="#B3948A7A" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Height" Value="64" />
    </Style>
    <Style Selector="Border.stamp-rule">
      <Setter Property="BorderBrush" Value="#B3948A7A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TextBlock.stamp-date">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    </Style>
    <Style Selector="TextBlock.stamp-note">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
  </p:PageBase.Styles>

  <Panel Name="Root">
    <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="PageContent" Spacing="0">
        <!-- ===== stage: [spine | box] · text column, everything standing on the stage board ===== -->
        <!-- one panel for the stage and its board: the box's focus layer lies over both, so the lit board piece is drawn
             ON the board (M4 QA: drawn in the box slot, the board covered it). ZIndex 1: the board's and the focus
             shadows fall onto the back, which is room (below the board the TV light ends, DESIGN 2.5) -->
        <Panel Name="StageHost" ZIndex="1" ClipToBounds="False">
        <Grid Name="Stage" Height="588" ColumnDefinitions="Auto,56,*" Margin="{DynamicResource RhPageInsetX}" VerticalAlignment="Top">
          <Panel Name="BoxSlot" Width="388" Height="504" VerticalAlignment="Bottom" HorizontalAlignment="Left" ClipToBounds="False">
            <c:GameTile Name="DetailBox" Theme="{StaticResource RhPulledBox}" Padding="28,0,0,0" DataContext="{Binding Game}"
                        AutomationProperties.Name="{l:T hint.cover}" />
          </Panel>

          <StackPanel Name="TextColumn" Grid.Column="2" VerticalAlignment="Bottom" Spacing="0" Margin="0,0,0,44" MaxWidth="1100" HorizontalAlignment="Left">
            <!-- system label: colour bar + name in the system's light; opens the system -->
            <Button Name="SystemButton" Theme="{StaticResource RhGhostButton}" Command="{Binding OpenSystemCommand}" ToolTip.Tip="{l:T detail.openSystem}"
                    HorizontalAlignment="Left" Padding="8,0" Margin="-8,0,0,0" MinHeight="36">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="4" Height="18" Background="{Binding Game.SystemColorBrush}" VerticalAlignment="Center" />
                <TextBlock Name="SystemName" Classes="stage-label" Text="{Binding Game.SystemName}" Foreground="{Binding System.LightBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <c:FitText Name="StageTitle" Classes="poster" Source="{Binding Game.Title}" Sizes="72,56,40" MaxLines="2" LineFactor="1.06" Margin="0,10,0,0" />
            <StackPanel Margin="0,14,0,0" Spacing="0">
              <TextBlock Name="MetaLine" c:Sentence.Text="{Binding MetaSentence}" Classes="read-l" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                         IsVisible="{Binding MetaSentence, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Name="PlayLine" c:Sentence.Text="{Binding PlaySentence}" Classes="read-l" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" IsVisible="{Binding Game.IsMissing}">
              <c:RhIcon Data="{StaticResource Icon.Missing}" Width="20" Height="20" Foreground="{DynamicResource RhDangerBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T tile.missing}" Classes="ui" Foreground="{DynamicResource RhDangerBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Name="Actions" Orientation="Horizontal" Spacing="16" Margin="0,28,0,0">
              <Button Name="PlayButton" Theme="{StaticResource RhPrimaryButton}" MinWidth="300" MinHeight="64" Command="{Binding PlayCommand}"
                      IsVisible="{Binding !ShowSolution}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <c:RhIcon Data="{StaticResource Icon.Play}" Filled="True" Width="24" Height="24" />
                  <TextBlock Text="{l:T detail.play}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- not startable: the solution button takes the place (and the first focus) of "Spielen" -->
              <Button Name="SolveButton" Theme="{StaticResource RhSolutionButton}" MinWidth="300" MinHeight="64" Command="{Binding SolveCommand}"
                      IsVisible="{Binding ShowSolution}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <c:RhIcon Data="{StaticResource Icon.Warning}" Width="24" Height="24" Foreground="{DynamicResource RhWarningBrush}" />
                  <TextBlock Text="{Binding SolutionText}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="FavoriteButton" MinHeight="64" Padding="24,0" Command="{Binding ToggleFavoriteCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Panel>
                    <c:RhIcon Stamp="True" Data="{StaticResource Icon.Favorite}" Width="22" Height="22" IsVisible="{Binding !Game.IsFavorite}" />
                    <c:RhIcon Stamp="True" Data="{StaticResource Icon.Favorite}" Filled="True" Width="22" Height="22" Foreground="{DynamicResource RhFavoriteBrush}" IsVisible="{Binding Game.IsFavorite}" />
                  </Panel>
                  <TextBlock Text="{l:T detail.addFavorite}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- Mehr: cover, folder, file info, reset – an overlay -->
              <Button Name="MoreButton" Width="64" Height="64" Padding="0" Command="{Binding ShowMoreCommand}" ToolTip.Tip="{l:T detail.more}"
                      AutomationProperties.Name="{l:T detail.more}">
                <c:RhIcon Data="{StaticResource Icon.More}" Width="24" Height="24" StrokeThickness="3" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- the stage board, edge to edge, right under the stage (code-behind keeps its top at Stage.Height); the TV light
             ends here; the box casts its contact shadow on it -->
        <c:ShelfBoard Name="StageBoard" Height="24" Margin="0,588,0,0" />
        </Panel>

        <!-- ===== "Rückseite" ===== -->
        <Border Name="BackGround" Background="{DynamicResource RhBaseBrush}" Padding="{DynamicResource RhPageInset}">
        <!-- 160 px under the back (48 inset + 112): the last section never ends in the footer's fade (QA 2) -->
        <Grid Name="Back" ColumnDefinitions="904*,80,744*" Margin="0,0,0,112">
          <!-- two stacks; the sections move between them (code-behind, ApplyBackLayout) -->
          <StackPanel Name="LeftStack" Spacing="0">
          <!-- Über das Spiel: description (68 characters, 8 lines, then "Weiterlesen"), the two screens on a shelf edge -->
          <StackPanel Name="AboutSection" Spacing="0" Margin="0,16,0,0" IsVisible="{Binding HasAbout}">
            <c:ShelfLabel Text="{l:T detail.section.about}" />
            <!-- "Weiterlesen" opens the text in place (QA 2, no sheet): up to 12 lines, longer text scrolls inside them with
                 a 12 px fade at the cut; the button only appears when the 8 lines clip the text -->
            <Panel Name="DescriptionHost" Margin="0,16,0,0" HorizontalAlignment="Left" MaxWidth="760" IsVisible="{Binding HasDescription}">
              <ScrollViewer Name="DescriptionScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <TextBlock Name="DescriptionText" Text="{Binding Description}" Classes="read-l" TextWrapping="Wrap" MaxLines="8" TextTrimming="WordEllipsis" />
              </ScrollViewer>
              <Border Name="DescriptionFade" Height="12" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#0014120F" />
                    <GradientStop Offset="1" Color="#FF14120F" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Panel>
            <Button Name="ReadMoreButton" Theme="{StaticResource RhGhostButton}" Command="{Binding ShowDescriptionCommand}" HorizontalAlignment="Left"
                    Margin="-12,6,0,0" IsVisible="False">
              <TextBlock Name="ReadMoreText" Text="{l:T detail.readMore}" />
            </Button>
            <!-- the screens stand on a shelf edge; R2: their captions are paper strips on the sets' chins (under the board
                 the footer's fade took them at 1920) -->
            <Panel Name="ScreensShelf" Margin="0,20,0,0" IsVisible="{Binding HasScreens}" HorizontalAlignment="Left">
              <StackPanel Spacing="0">
                <StackPanel Name="ScreenSets" Orientation="Horizontal" Spacing="32" Height="335">
                  <Button Name="TitleScreenButton" Theme="{StaticResource RhScreenButton}" Command="{Binding ShowScreensCommand}" IsVisible="{Binding HasTitleScreen}"
                          AutomationProperties.Name="{l:T detail.screen.title}">
                    <c:PixelScreen Name="TitleSet" Width="400" Height="335" PicturePath="{Binding TitleScreen}" SystemId="{Binding Game.SystemId}" Caption="{l:T detail.screen.title}"
                                   Accent="{Binding Game.Accent}" Code="{Binding Game.SystemShort}" IsTvSystem="{Binding IsTvSystem}" />
                  </Button>
                  <Button Name="SnapScreenButton" Theme="{StaticResource RhScreenButton}" Command="{Binding ShowScreensCommand}" IsVisible="{Binding HasSnapScreen}"
                          AutomationProperties.Name="{l:T detail.screen.snap}">
                    <c:PixelScreen Name="SnapSet" Width="400" Height="335" PicturePath="{Binding SnapScreen}" SystemId="{Binding Game.SystemId}" Caption="{l:T detail.screen.snap}"
                                   Accent="{Binding Game.Accent}" Code="{Binding Game.SystemShort}" IsTvSystem="{Binding IsTvSystem}" />
                  </Button>
                </StackPanel>
                <c:ShelfBoard Name="ScreensBoard" IsEdge="True" Height="12" />
                <StackPanel Name="ScreenCaptions" Orientation="Horizontal" Spacing="32" Margin="0,12,0,0" IsVisible="False">
                  <TextBlock Name="TitleCaption" Classes="caption" Width="400" Text="{l:T detail.screen.title}" IsVisible="{Binding HasTitleScreen}" />
                  <TextBlock Name="SnapCaption" Classes="caption" Width="400" Text="{l:T detail.screen.snap}" IsVisible="{Binding HasSnapScreen}" />
                </StackPanel>
              </StackPanel>
            </Panel>
          </StackPanel>

          <!-- Start: choice rows, status line, file -->
          <StackPanel Name="StartSection" Spacing="0" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
              <c:ShelfLabel Text="{l:T detail.section.start}" VerticalAlignment="Center" />
              <TextBlock c:Sentence.Text="{Binding PlanSummary}" Classes="read" VerticalAlignment="Center" TextTrimming="WordEllipsis" />
            </StackPanel>
            <!-- choice rows: confirm opens the in-style choice list that hangs at the row (no stock drop-down) -->
            <Button Name="EmulatorBox" Theme="{StaticResource RhInfoRow}" Tag="{l:T detail.emulator}" Command="{Binding ShowEmulatorChoiceCommand}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding SelectedEmulator.Label, FallbackValue=''}" VerticalAlignment="Center" TextTrimming="WordEllipsis" />
                <TextBlock c:Sentence.Text="{Binding SelectedEmulator.Status, FallbackValue=''}" Classes="meta" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- the choice list folds open under its row (180 ms, pushing the rows below down): items from the value column -->
            <c:FoldPanel Name="EmulatorFold" IsOpen="False">
              <ItemsControl Name="EmulatorChoices" ItemsSource="{Binding ChoiceItems}" Margin="154,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PickOption">
                    <Button Theme="{StaticResource RhSheetRow}" Classes.current="{Binding IsCurrent}"
                            Command="{Binding $parent[p:PageBase].((vm:GameDetailViewModel)DataContext).PickCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="22,*">
                        <c:RhIcon Data="{StaticResource Icon.Check}" Width="18" Height="18" StrokeThickness="2.6" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          <TextBlock c:Sentence.Text="{Binding Note}" Classes="meta" VerticalAlignment="Center" IsVisible="{Binding HasNote}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </c:FoldPanel>
            <Button Name="ModeBox" Theme="{StaticResource RhInfoRow}" Tag="{l:T detail.mode}" Command="{Binding ShowModeChoiceCommand}">
              <TextBlock Text="{Binding SelectedMode.Label, FallbackValue=''}" VerticalAlignment="Center" />
            </Button>
            <c:FoldPanel Name="ModeFold" IsOpen="False">
              <ItemsControl Name="ModeChoices" ItemsSource="{Binding ChoiceItems}" Margin="154,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PickOption">
                    <Button Theme="{StaticResource RhSheetRow}" Classes.current="{Binding IsCurrent}"
                            Command="{Binding $parent[p:PageBase].((vm:GameDetailViewModel)DataContext).PickCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="22,*">
                        <c:RhIcon Data="{StaticResource Icon.Check}" Width="18" Height="18" StrokeThickness="2.6" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          <TextBlock c:Sentence.Text="{Binding Note}" Classes="meta" VerticalAlignment="Center" IsVisible="{Binding HasNote}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </c:FoldPanel>
            <TextBlock Text="{Binding SelectedMode.Hint}" Classes="meta" TextWrapping="Wrap" Margin="16,10,0,6" />
            <!-- status line: icon + one sentence; a download link sits behind "Website" -->
            <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}" Margin="16,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProblemItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                    <Panel VerticalAlignment="Center">
                      <c:RhIcon Data="{StaticResource Icon.Error}" Width="20" Height="20" Foreground="{DynamicResource RhDangerBrush}" IsVisible="{Binding IsBlocking}" />
                      <c:RhIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource RhWarningBrush}" IsVisible="{Binding !IsBlocking}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Margin="12,0,16,0" Text="{Binding Text}" Classes="read" Foreground="{DynamicResource RhText1Brush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Theme="{StaticResource RhGhostButton}" IsVisible="{Binding HasUrl}" MinHeight="44" VerticalAlignment="Center"
                            Command="{Binding $parent[p:PageBase].((vm:GameDetailViewModel)DataContext).OpenWebsiteCommand}" CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:RhIcon Data="{StaticResource Icon.External}" Width="18" Height="18" />
                        <TextBlock Text="{l:T detail.website}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !HasProblems}" MinHeight="48" Margin="16,0,0,0">
              <c:RhIcon Data="{StaticResource Icon.Ok}" Width="20" Height="20" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T detail.ready}" Classes="ui" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- file: name and size; confirm opens the file info (path, CRC) -->
            <Button Name="FileRow" Theme="{StaticResource RhInfoRow}" Tag="{l:T detail.file}" Command="{Binding ShowFileInfoCommand}" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420" />
                <TextBlock c:Sentence.Text="{Binding FileInfo}" Classes="meta" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- Dateiinfo folds open under its row (QA 2, no sheet): keys in Etikett 15 Text 3 at the row's label (168 wide),
                 values at the row's value column (row + 216) in read Text 2, paths and the checksum in Cascadia Mono Regular 15 -->
            <c:FoldPanel Name="FileFold" IsOpen="False">
              <StackPanel Margin="16,6,0,16" Spacing="0">
                <ItemsControl Name="FileLines" ItemsSource="{Binding FileLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InfoLine">
                      <Grid ColumnDefinitions="168,32,*" MinHeight="32">
                        <TextBlock Classes="kv-key" Text="{Binding Label}" />
                        <TextBlock Grid.Column="2" Classes="kv-value" c:Sentence.Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding !Mono}" />
                        <TextBlock Grid.Column="2" Classes="kv-mono" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding Mono}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Name="FileFolderButton" Command="{Binding OpenGameFolderCommand}" MinHeight="44" Margin="200,12,0,0" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:RhIcon Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
                    <TextBlock Text="{l:T detail.openFolder}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </c:FoldPanel>
            <!-- the other versions of this game on the shelf (folded out of "Daneben im Regal") -->
            <Button Name="VariantsRow" Theme="{StaticResource RhInfoRow}" Tag="{l:T detail.variants}" Command="{Binding ShowVariantsCommand}"
                    IsVisible="{Binding HasVariants}">
              <!-- R2: never cut mid-word – two lines before the list would be shortened -->
              <TextBlock Text="{Binding VariantsText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" VerticalAlignment="Center" Margin="0,6" />
            </Button>
          </StackPanel>

          <!-- Ausleihkarte: the last sessions as stamps, the entry stamp, empty places waiting for the next -->
          <StackPanel Name="CardSection" Spacing="0" Margin="0,48,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
              <c:ShelfLabel Text="{l:T detail.section.card}" VerticalAlignment="Center" />
              <TextBlock c:Sentence.Text="{Binding CardSentence}" Classes="read" VerticalAlignment="Center"
                         IsVisible="{Binding CardSentence, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ItemsControl Name="CardPlaces" ItemsSource="{Binding CardPlaces}" HorizontalAlignment="Left">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CardPlace">
                  <Panel Margin="0,0,12,0" Width="132" Height="64">
                    <c:EmptySlot Baseline="True" IsVisible="{Binding IsEmpty}" />
                    <Border Classes="stamp" IsVisible="{Binding IsStamp}" RenderTransform="{Binding Tilt}">
                      <Border Classes="stamp-rule">
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                          <TextBlock Classes="stamp-date" c:Sentence.Text="{Binding Date}" />
                          <TextBlock Classes="stamp-note" c:Sentence.Text="{Binding Note}" IsVisible="{Binding IsSession}" />
                          <TextBlock Classes="stamp-note" Text="{Binding Note}" Foreground="{DynamicResource RhText2Brush}" IsVisible="{Binding IsEntry}" />
                        </StackPanel>
                      </Border>
                    </Border>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Daneben im Regal: the shelf the box came from – its neighbours and the gap it left (filled in code) -->
          <StackPanel Name="ShelfSection" Spacing="0" Margin="0,48,0,0" IsVisible="{Binding HasNeighbours}">
            <c:ShelfLabel Text="{l:T detail.section.shelf}" />
            <Panel Name="NeighbourHost" Margin="0,24,0,0" ClipToBounds="False">
              <StackPanel Name="NeighbourRow" Orientation="Horizontal" Spacing="24" Height="180" VerticalAlignment="Top" HorizontalAlignment="Left" />
              <c:ShelfBoard Name="NeighbourBoard" IsEdge="True" Height="12" Margin="0,180,0,16" />
            </Panel>
          </StackPanel>
          </StackPanel>
          <StackPanel Name="RightStack" Grid.Column="2" Spacing="0" />
        </Grid>
        </Border>
        <!-- room below the back, so the page can scroll to a clean cut above the actions (code-behind) -->
        <Border Name="BottomSpacer" Height="0" Background="{DynamicResource RhBaseBrush}" />
      </StackPanel>
    </ScrollViewer>
    <!-- free scrolling inside the back: the content fades out under the header instead of being cut (DESIGN 8.4) -->
    <Border Name="TopFade" Height="12" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#FF14120F" />
          <GradientStop Offset="1" Color="#0014120F" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- ===== overlays: the page dims (room-deep, no blur); header and footer stay ===== -->
    <Panel Name="SheetLayer" IsVisible="False" Focusable="True" Background="Transparent">
      <Border Name="SheetScrim" Background="#B80A0908" />
      <!-- Mehr and "Auch im Regal": a list that hangs at its button (Dateiinfo and Weiterlesen fold open in the page) -->
      <!-- R2: the list is a riveted plate of the workbench hanging at its button, not a floating card -->
      <Border Name="SheetPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Width="420" Background="Transparent"
              Padding="0,10,0,10" ClipToBounds="False">
        <Panel>
          <c:PanelPlate Name="SheetEdge" Margin="0,-10,0,-10" />
          <StackPanel Spacing="0">
            <!-- Mehr -->
            <StackPanel Name="MoreRows" Spacing="0">
              <Button Name="ChooseCoverItem" Theme="{StaticResource RhSheetRow}" Command="{Binding ChooseCoverCommand}" IsVisible="{Binding CanEditCover}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <c:RhIcon Data="{StaticResource Icon.Cover}" Width="22" Height="22" />
                  <TextBlock Text="{l:T artwork.choose}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="RemoveCoverItem" Theme="{StaticResource RhSheetRow}" Command="{Binding RemoveCoverCommand}" IsVisible="{Binding HasCover}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <c:RhIcon Data="{StaticResource Icon.Remove}" Width="22" Height="22" />
                  <TextBlock Text="{l:T artwork.remove}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="OpenFolderItem" Theme="{StaticResource RhSheetRow}" Command="{Binding OpenGameFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <c:RhIcon Data="{StaticResource Icon.Folder}" Width="22" Height="22" />
                  <TextBlock Text="{l:T detail.openFolder}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="FileInfoItem" Theme="{StaticResource RhSheetRow}" Command="{Binding ShowFileInfoCommand}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <c:RhIcon Data="{StaticResource Icon.File}" Width="22" Height="22" />
                  <TextBlock Text="{l:T detail.fileInfo}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="ResetItem" Theme="{StaticResource RhSheetRow}" Command="{Binding ResetLaunchOptionsCommand}" IsVisible="{Binding HasOverrides}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <c:RhIcon Data="{StaticResource Icon.Refresh}" Width="22" Height="22" />
                  <TextBlock Text="{l:T detail.resetOptions}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <!-- Auch im Regal: the other versions, each opens its detail -->
            <ItemsControl Name="VariantRows" ItemsSource="{Binding Variants}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VariantOption">
                  <Button Theme="{StaticResource RhSheetRow}" Command="{Binding $parent[p:PageBase].((vm:GameDetailViewModel)DataContext).OpenVariantCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <Border Width="3" Height="14" Background="{Binding Game.SystemColorBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="WordEllipsis" MaxWidth="560" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Panel>
      </Border>

      <!-- Cover: the box large, standing on a board -->
      <Grid Name="CoverView" RowDefinitions="*,Auto" Margin="0,40,0,0">
        <c:CoverArt Name="CoverLarge" Margin="96,0,96,0" Source="{Binding Game.CoverPath}" Title="{Binding Game.Title}" Badge="{Binding Game.SystemShort}"
                    SystemId="{Binding Game.SystemId}" Accent="{Binding Game.Accent}" ShowFavorite="False" Year="{Binding Game.YearText}" />
        <c:ShelfBoard Name="CoverBoard" Grid.Row="1" Height="24" Margin="0,0,0,64" />
      </Grid>

      <!-- Bildschirme: title screen and snap side by side, large -->
      <Grid Name="ScreensView" RowDefinitions="*,Auto,Auto,Auto" Margin="0,40,0,0">
        <StackPanel Name="LargeSets" Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <c:PixelScreen Name="TitleLarge" PicturePath="{Binding TitleScreen}" SystemId="{Binding Game.SystemId}" Accent="{Binding Game.Accent}"
                         Caption="{l:T detail.screen.title}" Code="{Binding Game.SystemShort}" IsTvSystem="{Binding IsTvSystem}" IsVisible="{Binding HasTitleScreen}" />
          <c:PixelScreen Name="SnapLarge" PicturePath="{Binding SnapScreen}" SystemId="{Binding Game.SystemId}" Accent="{Binding Game.Accent}"
                         Caption="{l:T detail.screen.snap}" Code="{Binding Game.SystemShort}" IsTvSystem="{Binding IsTvSystem}" IsVisible="{Binding HasSnapScreen}" />
        </StackPanel>
        <c:ShelfBoard Name="ScreensLargeBoard" Grid.Row="1" Height="24" />
        <!-- R3 QA: the captions are the paper strips on the sets' chins, as on the page (the flat 48 px band under the
             board is gone; kept hidden for the layout code) -->
        <Border Grid.Row="2" Height="48" IsVisible="False">
          <StackPanel Name="LargeCaptions" Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="TitleLargeCaption" Classes="caption" Text="{l:T detail.screen.title}" IsVisible="{Binding HasTitleScreen}" />
            <TextBlock Name="SnapLargeCaption" Classes="caption" Text="{l:T detail.screen.snap}" IsVisible="{Binding HasSnapScreen}" />
          </StackPanel>
        </Border>
        <Panel Grid.Row="3" Height="40" />
      </Grid>
    </Panel>
  </Panel>
</p:PageBase>
