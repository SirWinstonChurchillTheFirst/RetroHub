<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.GameDetailPage"
            x:DataType="vm:GameDetailViewModel">
  <!--
    Game detail (M1.5): the box stands on the stage board in the TV light, the text column (measured title) is anchored
    bottom right of it; actions: Spielen (or the solution button), Favorit, Mehr. Below the board the "Rückseite":
    about the game | start (selection rows, status line, file). Without a description the start column moves to the
    left edge. The generated box spine, screenshots and the play log follow in M4 (DESIGN 7.3).
  -->
  <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="0">
      <!-- ===== stage (a landscape cover widens the box frame to 460, see code-behind) ===== -->
      <Grid Name="Stage" Height="588" ColumnDefinitions="360,56,*" Margin="{DynamicResource RhPageInsetX}">
        <Panel Name="BoxSlot" Width="360" Height="504" VerticalAlignment="Bottom">
          <c:CoverArt Name="DetailBox" Source="{Binding Game.CoverPath}" Title="{Binding Game.Title}" Badge="{Binding Game.SystemShort}"
                      SystemId="{Binding Game.SystemId}" Accent="{Binding Game.Accent}" IsMissing="{Binding Game.IsMissing}" />
        </Panel>
        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="0" Margin="0,0,0,44" MaxWidth="1100" HorizontalAlignment="Left">
          <!-- system label: colour bar + name in the system's light -->
          <Button Theme="{StaticResource RhGhostButton}" Command="{Binding OpenSystemCommand}" ToolTip.Tip="{l:T detail.openSystem}" HorizontalAlignment="Left"
                  Padding="8,0" Margin="-8,0,0,0" MinHeight="36">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="4" Height="18" Background="{Binding Game.SystemColorBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Game.SystemName}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding System.LightBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <c:FitText Name="StageTitle" Classes="poster" Source="{Binding Game.Title}" Sizes="72,56,40" MaxLines="2" LineFactor="1.06" Margin="0,10,0,0" />
          <StackPanel Margin="0,16,0,0" Spacing="0">
            <TextBlock c:Sentence.Text="{Binding MetaSentence}" Classes="read-l" TextWrapping="Wrap"
                       IsVisible="{Binding MetaSentence, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock c:Sentence.Text="{Binding PlaySentence}" Classes="read-l" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" IsVisible="{Binding Game.IsMissing}">
            <c:RhIcon Data="{StaticResource Icon.Missing}" Width="20" Height="20" Foreground="{DynamicResource RhDangerBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{l:T tile.missing}" Classes="ui" Foreground="{DynamicResource RhDangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,28,0,0">
            <Button Name="PlayButton" Theme="{StaticResource RhPrimaryButton}" MinWidth="300" MinHeight="64" Command="{Binding PlayCommand}"
                    IsVisible="{Binding !ShowSolution}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <c:RhIcon Data="{StaticResource Icon.Play}" Filled="True" Width="24" Height="24" />
                <TextBlock Text="{l:T detail.play}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- not startable: the solution button takes the place (and the first focus) of "Spielen" -->
            <Button Name="SolveButton" Theme="{StaticResource RhSolutionButton}" MinWidth="300" MinHeight="64" Command="{Binding SolveCommand}"
                    IsVisible="{Binding ShowSolution}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <c:RhIcon Data="{StaticResource Icon.Warning}" Width="24" Height="24" Foreground="{DynamicResource RhWarningBrush}" />
                <TextBlock Text="{Binding SolutionText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button MinHeight="64" Padding="24,0" Command="{Binding ToggleFavoriteCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Panel>
                  <c:RhIcon Data="{StaticResource Icon.Star}" Width="22" Height="22" IsVisible="{Binding !Game.IsFavorite}" />
                  <c:RhIcon Data="{StaticResource Icon.Star}" Filled="True" Width="22" Height="22" Foreground="{DynamicResource RhFavoriteBrush}" IsVisible="{Binding Game.IsFavorite}" />
                </Panel>
                <TextBlock Text="{l:T detail.addFavorite}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- Mehr: cover and folder actions as an overlay -->
            <Button Name="MoreButton" Width="64" Height="64" Padding="0" ToolTip.Tip="{l:T detail.more}" AutomationProperties.Name="{l:T detail.more}">
              <c:RhIcon Data="{StaticResource Icon.More}" Width="24" Height="24" StrokeThickness="3" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Name="ChooseCoverItem" Header="{l:T artwork.choose}" Command="{Binding ChooseCoverCommand}" IsVisible="{Binding CanEditCover}" />
                  <MenuItem Name="RemoveCoverItem" Header="{l:T artwork.remove}" Command="{Binding RemoveCoverCommand}" IsVisible="{Binding HasCover}" />
                  <MenuItem Header="{l:T detail.openFolder}" Command="{Binding OpenGameFolderCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- the stage board, edge to edge; the TV light ends here; the box casts its contact shadow on it -->
      <c:ShelfBoard Name="StageBoard" Height="24" />

      <!-- ===== "Rückseite": about the game | start (start moves left when there is no description) ===== -->
      <Grid Name="Back" ColumnDefinitions="*,80,*" Margin="{DynamicResource RhPageInset}">
        <StackPanel Name="AboutColumn" Spacing="14" Margin="0,16,0,0" IsVisible="{Binding HasDescription}">
          <c:ShelfLabel Text="{l:T detail.section.about}" />
          <TextBlock Text="{Binding Description}" Classes="read-l" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Name="StartColumn" Grid.Column="2" Spacing="0" Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
            <c:ShelfLabel Text="{l:T detail.section.start}" VerticalAlignment="Center" />
            <TextBlock c:Sentence.Text="{Binding PlanSummary}" Classes="read" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ComboBox Name="EmulatorBox" Theme="{StaticResource RhChoiceRow}" Tag="{l:T detail.emulator}" ItemsSource="{Binding Emulators}" SelectedItem="{Binding SelectedEmulator}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EmulatorOption">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Status}" Classes="meta" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Name="ModeBox" Theme="{StaticResource RhChoiceRow}" Tag="{l:T detail.mode}" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModeOption">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding SelectedMode.Hint}" Classes="meta" TextWrapping="Wrap" Margin="16,10,0,6" />
          <!-- status line: icon + one sentence; a download link sits behind "Website" -->
          <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}" Margin="16,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProblemItem">
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                  <Panel VerticalAlignment="Center">
                    <c:RhIcon Data="{StaticResource Icon.Error}" Width="20" Height="20" Foreground="{DynamicResource RhDangerBrush}" IsVisible="{Binding IsBlocking}" />
                    <c:RhIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource RhWarningBrush}" IsVisible="{Binding !IsBlocking}" />
                  </Panel>
                  <TextBlock Grid.Column="1" Margin="12,0,16,0" Text="{Binding Text}" Classes="read" Foreground="{DynamicResource RhText1Brush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Theme="{StaticResource RhGhostButton}" IsVisible="{Binding HasUrl}" MinHeight="44" VerticalAlignment="Center"
                          Command="{Binding $parent[p:PageBase].((vm:GameDetailViewModel)DataContext).OpenWebsiteCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:RhIcon Data="{StaticResource Icon.External}" Width="18" Height="18" />
                      <TextBlock Text="{l:T detail.website}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !HasProblems}" MinHeight="48" Margin="16,0,0,0">
            <c:RhIcon Data="{StaticResource Icon.Ok}" Width="20" Height="20" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{l:T detail.ready}" Classes="ui" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <!-- file: name and size (path and CRC belong in the file info) -->
          <Grid ColumnDefinitions="200,*" Margin="16,12,0,0">
            <TextBlock Text="{l:T detail.file}" Classes="ui" Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Binding FileName}" Classes="ui" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding FileInfo}" Classes="meta" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</p:PageBase>
