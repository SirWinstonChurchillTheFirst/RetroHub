<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.GameDetailPage"
            x:DataType="vm:GameDetailViewModel">
  <Panel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="40,4,40,40">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" MaxWidth="940" />
        </Grid.ColumnDefinitions>
        <!-- left: cover + actions -->
        <StackPanel Spacing="14">
          <Border Width="300" Height="410" CornerRadius="24" ClipToBounds="True" BoxShadow="0 28 60 -16 #C0000000" BorderBrush="#26FFFFFF" BorderThickness="1">
            <c:CoverArt Source="{Binding Game.CoverPath}" Title="{Binding Game.Title}" Badge="{Binding Game.SystemShort}" Accent="{Binding Game.Accent}" ShowTitle="True" />
          </Border>
          <Button Name="PlayButton" Theme="{StaticResource RhPrimaryButton}" HorizontalAlignment="Stretch" MinHeight="54" Command="{Binding PlayCommand}" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:RhIcon Data="{StaticResource Icon.Play}" Filled="True" Width="17" Height="17" Foreground="White" />
              <TextBlock Text="{l:T detail.play}" VerticalAlignment="Center" FontSize="16" />
            </StackPanel>
          </Button>
          <Button HorizontalAlignment="Stretch" Command="{Binding ToggleFavoriteCommand}">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !Game.IsFavorite}">
                <c:RhIcon Data="{StaticResource Icon.Star}" Width="17" Height="17" />
                <TextBlock Text="{l:T detail.addFavorite}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Game.IsFavorite}">
                <c:RhIcon Data="{StaticResource Icon.Star}" Filled="True" Width="17" Height="17" Foreground="{DynamicResource RhFavoriteBrush}" />
                <TextBlock Text="{l:T detail.isFavorite}" VerticalAlignment="Center" />
              </StackPanel>
            </Panel>
          </Button>
          <!-- cover (artwork module) -->
          <DockPanel IsVisible="{Binding CanEditCover}">
            <Button Name="RemoveCoverButton" DockPanel.Dock="Right" Margin="10,0,0,0" Theme="{StaticResource RhIconButton}" Width="44" Height="44"
                    VerticalAlignment="Center" IsVisible="{Binding HasCover}" Command="{Binding RemoveCoverCommand}"
                    ToolTip.Tip="{l:T artwork.remove}" AutomationProperties.Name="{l:T artwork.remove}">
              <c:RhIcon Data="{StaticResource Icon.Close}" Width="15" Height="15" />
            </Button>
            <Button Name="ChooseCoverButton" HorizontalAlignment="Stretch" Command="{Binding ChooseCoverCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:RhIcon Data="{StaticResource Icon.Folder}" Width="17" Height="17" />
                <TextBlock Text="{l:T artwork.choose}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DockPanel>
        </StackPanel>

        <!-- right: info -->
        <StackPanel Grid.Column="2" Spacing="0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Theme="{StaticResource RhChip}" Command="{Binding OpenSystemCommand}" ToolTip.Tip="{l:T detail.openSystem}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{Binding Game.AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Game.SystemName}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Classes="chip bad" IsVisible="{Binding Game.IsMissing}" VerticalAlignment="Center">
              <TextBlock Text="{l:T tile.missing}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Game.Title}" Classes="display" TextWrapping="Wrap" Margin="0,16,0,0" />
          <ItemsControl ItemsSource="{Binding Facts}" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="28" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FactItem">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Caption}" Classes="label" FontSize="10.5" />
                  <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource RhText1Brush}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Description}" Classes="body" FontSize="15" LineHeight="25" MaxWidth="820" HorizontalAlignment="Left" Margin="0,22,0,0" />

          <!-- play stats -->
          <Grid ColumnDefinitions="*,14,*,14,*,14,*" Margin="0,28,0,0">
            <Border Classes="card" Padding="18,14">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <c:RhIcon Data="{StaticResource Icon.Clock}" Width="14" Height="14" Foreground="{DynamicResource RhText3Brush}" />
                  <TextBlock Text="{l:T detail.playTime}" Classes="meta" FontSize="12" />
                </StackPanel>
                <TextBlock Text="{Binding PlayTime}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="18,14">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <c:RhIcon Data="{StaticResource Icon.Calendar}" Width="14" Height="14" Foreground="{DynamicResource RhText3Brush}" />
                  <TextBlock Text="{l:T detail.lastPlayed}" Classes="meta" FontSize="12" />
                </StackPanel>
                <TextBlock Text="{Binding LastPlayed}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card" Padding="18,14">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <c:RhIcon Data="{StaticResource Icon.Trophy}" Width="14" Height="14" Foreground="{DynamicResource RhText3Brush}" />
                  <TextBlock Text="{l:T detail.starts}" Classes="meta" FontSize="12" />
                </StackPanel>
                <TextBlock Text="{Binding PlayCount}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border Grid.Column="6" Classes="card" Padding="18,14">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <c:RhIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Foreground="{DynamicResource RhText3Brush}" />
                  <TextBlock Text="{l:T detail.added}" Classes="meta" FontSize="12" />
                </StackPanel>
                <TextBlock Text="{Binding Added}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- launch settings -->
          <Border Classes="glass" Padding="24,22" Margin="0,18,0,0">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T detail.launchSettings}" Classes="h3" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PlanSummary}" Classes="meta" VerticalAlignment="Center" Margin="16,0,0,0" />
              </Grid>
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Spacing="6">
                  <TextBlock Text="{l:T detail.emulator, Upper=True}" Classes="label" FontSize="10.5" />
                  <ComboBox Name="EmulatorBox" ItemsSource="{Binding Emulators}" SelectedItem="{Binding SelectedEmulator}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EmulatorOption">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="meta" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="{l:T detail.mode, Upper=True}" Classes="label" FontSize="10.5" />
                  <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModeOption">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding SelectedMode.Hint}" Classes="meta" TextWrapping="Wrap" />
              <!-- problems from the planner, shown as they are -->
              <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProblemItem">
                    <Panel>
                      <Border Classes="chip bad" Padding="12,10" CornerRadius="14" IsVisible="{Binding IsBlocking}">
                        <Grid ColumnDefinitions="Auto,*">
                          <c:RhIcon Data="{StaticResource Icon.Alert}" Width="17" Height="17" Foreground="{DynamicResource RhDangerBrush}" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text}" TextWrapping="Wrap" FontWeight="Medium" />
                        </Grid>
                      </Border>
                      <Border Classes="chip warn" Padding="12,10" CornerRadius="14" IsVisible="{Binding !IsBlocking}">
                        <Grid ColumnDefinitions="Auto,*">
                          <c:RhIcon Data="{StaticResource Icon.Info}" Width="17" Height="17" Foreground="{DynamicResource RhWarningBrush}" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text}" TextWrapping="Wrap" FontWeight="Medium" />
                        </Grid>
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasProblems}">
                <c:RhIcon Data="{StaticResource Icon.Check}" Width="16" Height="16" Foreground="{DynamicResource RhSuccessBrush}" />
                <TextBlock Text="{l:T detail.ready}" FontSize="13" FontWeight="Medium" Foreground="#8FF0C8" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- file -->
          <StackPanel Spacing="4" Margin="0,22,0,0">
            <TextBlock Text="{l:T detail.file, Upper=True}" Classes="label" FontSize="10.5" />
            <TextBlock Text="{Binding FilePath}" Classes="mono" TextWrapping="Wrap" />
            <TextBlock Text="{Binding FileInfo}" Classes="meta" FontSize="12" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Panel>
</p:PageBase>
