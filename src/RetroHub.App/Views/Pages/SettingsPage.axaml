<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.SettingsPage"
            x:DataType="vm:SettingsViewModel">
  <!--
    Einstellungen as a TV's service menu (DESIGN 7.6, 7.6.2): the pinned Werkbank head, one continuous numbered list on the
    room ("01" … in Rücken), paper labels as section heads, flat 72 px rows with the value in a room-deep display window
    between two filled triangles (◀ [Wert] ▶). Left/right change a value at once, confirm moves it on, the mouse clicks the
    triangles; shoulder left/right jump between the sections. Right of the list stands the TV from Start with a test card
    that previews what changes (light colour, channel display, motion) – an object, not an inspector. No cards, no toggle
    switches, no sliders, no segment controls, no drop-down.
  -->
  <c:WorkbenchFrame Name="Frame">
    <StackPanel c:WorkbenchFrame.Role="Head" Spacing="8">
      <TextBlock Text="{l:T nav.settings}" Classes="poster" />
      <TextBlock Text="{l:T settings.intro}" Classes="meta" />
    </StackPanel>

    <ScrollViewer Name="Scroller" c:WorkbenchFrame.Role="Scroll" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl Name="SectionList" ItemsSource="{Binding Sections}" Margin="0,16,24,48">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ServiceSection">
            <StackPanel Spacing="0" Margin="0,0,0,40" Classes="section">
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <c:ShelfLabel Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Note}" Classes="meta" VerticalAlignment="Center" IsVisible="{Binding HasNote}" />
              </StackPanel>
              <c:Groove />
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ServiceSetting">
                    <c:ServiceRow />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border c:WorkbenchFrame.Role="Fade" IsHitTestVisible="False" Background="{x:Static c:WorkbenchFrame.FadeBrush}" />

    <!-- the TV from Start with the test card, standing on a shelf edge (hidden below 1500 px page width) -->
    <StackPanel Name="TvColumn" c:WorkbenchFrame.Role="Side" Spacing="0">
      <c:PixelScreen Name="Tv" Width="420" Height="351" HorizontalAlignment="Left" LedBrush="{DynamicResource RhAccentBrush}" />
      <c:ShelfBoard IsEdge="True" Height="12" Width="420" HorizontalAlignment="Left" />
      <TextBlock Text="{l:T settings.testCard}" Classes="meta" Margin="0,14,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </c:WorkbenchFrame>
</p:PageBase>
