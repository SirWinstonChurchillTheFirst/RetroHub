<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            x:Class="RetroHub.App.Views.Pages.SettingsPage"
            x:DataType="vm:SettingsViewModel">
  <!--
    Einstellungen as a service menu (DESIGN 7.6): one continuous list on the room, paper labels as section heads, flat
    72 px rows with the value between two arrows on one axis (◀ Wert ▶). Left/right change a value at once, confirm moves
    it on, the mouse clicks the arrows; shoulder left/right jump between the sections. No cards, no toggle switches, no
    sliders, no segment controls, no drop-down.
  -->
  <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
    <!-- the menu is at most 1100 wide and stands left at the page margin (DESIGN 7.6) -->
    <Grid Margin="{DynamicResource RhPageInset}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1000*" MaxWidth="1100" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
    <StackPanel Spacing="0">
      <StackPanel Spacing="2" HorizontalAlignment="Left">
        <TextBlock Text="{l:T nav.settings}" Classes="title" />
        <TextBlock Text="{l:T settings.intro}" Classes="meta" />
      </StackPanel>

      <ItemsControl Name="SectionList" ItemsSource="{Binding Sections}" Margin="0,16,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ServiceSection">
            <StackPanel Spacing="0" Margin="0,32,0,0" Classes="section">
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <c:ShelfLabel Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Note}" Classes="meta" VerticalAlignment="Center" IsVisible="{Binding HasNote}" />
              </StackPanel>
              <Border Height="1" Background="{DynamicResource RhLineBrush}" />
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ServiceSetting">
                    <c:ServiceRow />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</p:PageBase>
