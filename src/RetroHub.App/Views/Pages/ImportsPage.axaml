<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            xmlns:lib="using:RetroHub.Core.Library"
            x:Class="RetroHub.App.Views.Pages.ImportsPage"
            x:DataType="vm:ImportsViewModel">
  <!--
    Importe (DESIGN 7.6): left the library folders as service-menu rows (path, how it is read, "◀ Aktiv ▶"; confirm
    opens the folder's "Mehr" list), right the scan column: "Jetzt scannen", the segment bar while it runs and the
    delivery note ("Lieferschein") of the last scan instead of a toast – it stands until the next scan begins. Below,
    the covers in the same flat language. No cards, no stat tiles, no progress pill.
  -->
  <p:PageBase.Styles>
    <Style Selector="TextBlock.note-count">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontNumber}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
      <Setter Property="FontFeatures">
        <FontFeatureCollection>
          <FontFeature Tag="tnum" />
        </FontFeatureCollection>
      </Setter>
    </Style>
    <Style Selector="TextBlock.note-text">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="TextBlock.note-count.zero, TextBlock.note-text.zero">
      <Setter Property="Foreground" Value="{DynamicResource RhText3Brush}" />
    </Style>
    <Style Selector="TextBlock.percent">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontNumber}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="LineHeight" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
      <Setter Property="FontFeatures">
        <FontFeatureCollection>
          <FontFeature Tag="tnum" />
        </FontFeatureCollection>
      </Setter>
    </Style>
    <Style Selector="TextBlock.slip-head">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontSpine}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="LetterSpacing" Value="0.7" />
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    </Style>
    <Style Selector="Run.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource RhText2Brush}" />
    </Style>
    <!-- R3 QA: the delivery note is LIGHT paper (#E9E1CF) printed in ink (#2A251E) – the dark slip read as one more panel -->
    <Style Selector="StackPanel#DeliveryNote TextBlock">
      <Setter Property="Foreground" Value="#2A251E" />
    </Style>
    <Style Selector="StackPanel#DeliveryNote TextBlock.meta, StackPanel#DeliveryNote TextBlock.slip-head, StackPanel#DeliveryNote TextBlock.label">
      <Setter Property="Foreground" Value="#5C5347" />
    </Style>
    <Style Selector="StackPanel#DeliveryNote TextBlock.zero">
      <Setter Property="Foreground" Value="#8C8272" />
    </Style>
    <Style Selector="StackPanel#DeliveryNote TextBlock.mono">
      <Setter Property="Foreground" Value="#2A251E" />
    </Style>
    <Style Selector="StackPanel#DeliveryNote c|RhIcon.row-chevron">
      <Setter Property="Foreground" Value="#5C5347" />
    </Style>
    <Style Selector="StackPanel#DeliveryNote Border.row-chip">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </p:PageBase.Styles>
  <c:WorkbenchFrame Name="Frame" SideInScroll="True">
    <StackPanel c:WorkbenchFrame.Role="Head" Spacing="8">
      <TextBlock Text="{l:T nav.imports}" Classes="poster" />
      <TextBlock Text="{l:T imports.intro}" Classes="meta" />
    </StackPanel>

    <ScrollViewer Name="Scroller" c:WorkbenchFrame.Role="Scroll" HorizontalScrollBarVisibility="Disabled">
      <Grid Name="Columns" ColumnDefinitions="*,56,420" Margin="0,16,24,48">
        <!-- ===== library folders ===== -->
        <StackPanel Name="FolderColumn" Spacing="0">
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
            <c:ShelfLabel Text="{l:T imports.folders}" VerticalAlignment="Center" />
            <TextBlock Text="{l:T imports.folders.hint}" Classes="meta" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <c:Groove />
          <ItemsControl Name="FolderList" ItemsSource="{Binding Folders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderItemViewModel">
                <StackPanel>
                  <c:ServiceRow Classes="folder" Classes.open="{Binding $parent[StackPanel].((vm:FolderItemViewModel)DataContext).IsMenuOpen}" DataContext="{Binding Row}" />
                  <!-- its "Mehr" list folds open under the row (180 ms): three 56 px rows from x 120, hairlines between -->
                  <c:FoldPanel Name="MenuLayer" IsOpen="{Binding IsMenuOpen}">
                    <StackPanel Name="MenuRows" Classes="menu-rows" Spacing="0" Margin="24,0,0,0">
                      <Button Theme="{StaticResource RhSheetRow}" Command="{Binding $parent[p:PageBase].((vm:ImportsViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                          <c:RhIcon Data="{StaticResource Icon.Folder}" Width="22" Height="22" />
                          <TextBlock Text="{l:T imports.openFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <c:Groove IsVisible="{Binding CanRemove}" />
                      <Button Theme="{StaticResource RhSheetRow}" Command="{Binding $parent[p:PageBase].((vm:ImportsViewModel)DataContext).ToggleFolderCommand}" CommandParameter="{Binding}"
                              IsVisible="{Binding CanRemove}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                          <!-- pause = two filled bars, resume = the play triangle of "Spielen" (not the refresh arrows) -->
                          <Panel Width="22" Height="22">
                            <c:RhIcon Data="{StaticResource Icon.Pause}" Filled="True" Width="22" Height="22" IsVisible="{Binding IsEnabled}" />
                            <c:RhIcon Data="{StaticResource Icon.Play}" Filled="True" Width="22" Height="22" IsVisible="{Binding !IsEnabled}" />
                          </Panel>
                          <TextBlock Text="{Binding ToggleText}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <c:Groove IsVisible="{Binding CanRemove}" />
                      <Button Theme="{StaticResource RhSheetRow}" Command="{Binding $parent[p:PageBase].((vm:ImportsViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}"
                              IsVisible="{Binding CanRemove}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                          <c:RhIcon Data="{StaticResource Icon.Remove}" Width="22" Height="22" />
                          <TextBlock Text="{l:T imports.removeFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <c:Groove />
                    </StackPanel>
                  </c:FoldPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,24,0,0">
            <Button Name="AddFolderButton" Command="{Binding AddFolderCommand}" MinHeight="48">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:RhIcon Data="{StaticResource Icon.Plus}" Width="18" Height="18" />
                <TextBlock Text="{l:T imports.addFolder}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="{l:T imports.neverChanged}" Classes="meta" VerticalAlignment="Center" />
          </StackPanel>

          <!-- covers (artwork module) – in the folder column since QA 2: the scan column ended under the footer with the
               delivery note open, while the left half stood empty below the folders -->
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,48,0,12">
            <c:ShelfLabel Text="{l:T artwork.title}" VerticalAlignment="Center" />
          </StackPanel>
          <c:Groove Margin="0,0,0,16" />
          <TextBlock Text="{Binding CoverOnlineText}" Classes="read" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
            <Button Name="CoversButton" Command="{Binding FindCoversCommand}" MinHeight="48">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:RhIcon Data="{StaticResource Icon.Search}" Width="18" Height="18" />
                <TextBlock Text="{l:T artwork.find}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding CancelCoversCommand}" IsVisible="{Binding IsFindingCovers}" Content="{l:T common.cancel}" MinHeight="48" />
          </StackPanel>
          <StackPanel Spacing="10" Margin="0,20,0,0" IsVisible="{Binding IsFindingCovers}">
            <TextBlock Classes="percent" IsVisible="{Binding !CoverIndeterminate}" Text="{Binding CoverProgress, StringFormat={}{0:0} %}" />
            <c:SegmentBar Value="{Binding CoverProgress}" IsIndeterminate="{Binding CoverIndeterminate}" HorizontalAlignment="Left" />
            <TextBlock c:Sentence.Text="{Binding CoverProgressText}" Classes="ui" Foreground="{DynamicResource RhText2Brush}" />
            <TextBlock Text="{Binding CoverCurrent}" Classes="meta" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock c:Sentence.Text="{Binding CoverResultText}" IsVisible="{Binding HasCoverResult}" Classes="meta" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>

        <!-- ===== scan column (the side column of the Werkbank grid) ===== -->
        <StackPanel Name="ScanColumn" Grid.Column="2" Spacing="0">
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
            <c:ShelfLabel Text="{Binding ScanLabel}" VerticalAlignment="Center" />
          </StackPanel>
          <c:Groove Margin="0,0,0,20" />
          <TextBlock c:Sentence.Text="{Binding ScanSentence}" Classes="read" Margin="0,0,0,16" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Name="ScanButton" Theme="{StaticResource RhPrimaryButton}" Command="{Binding ScanCommand}" IsVisible="{Binding !IsScanning}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:RhIcon Data="{StaticResource Icon.Refresh}" Width="18" Height="18" />
                <TextBlock Text="{l:T imports.scanNow}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="CancelScanButton" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" Content="{l:T common.cancel}" MinHeight="56" />
          </StackPanel>

          <!-- running: the segment bar and the phase as a sentence ("29 von 80 Dateien geprüft.") -->
          <StackPanel Spacing="10" Margin="0,28,0,0" IsVisible="{Binding IsScanning}">
            <TextBlock Classes="percent" IsVisible="{Binding !IsIndeterminate}" Text="{Binding Progress, StringFormat={}{0:0} %}" />
            <c:SegmentBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" HorizontalAlignment="Left" />
            <TextBlock c:Sentence.Text="{Binding ProgressText}" Classes="ui" Foreground="{DynamicResource RhText2Brush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding CurrentFile}" Classes="mono" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <!-- the delivery note of the last scan: a paper slip torn off at the top, lines with dotted leaders to the numbers -->
          <StackPanel Name="DeliveryNote" Margin="0,28,0,0" IsVisible="{Binding HasReport}">
            <!-- the slip one step lighter than Regal (Wand hell 60 % over Raum, QA 2), so it reads as paper -->
            <Panel Background="#E9E1CF">
              <c:PaperSlip Light="True" />
              <c:Sawtooth Name="NoteTear" Fill="{DynamicResource RhBaseBrush}" VerticalAlignment="Top" />
              <!-- torn off at the foot too: the slip came off a roll -->
              <c:Sawtooth Name="NoteTearFoot" Fill="{DynamicResource RhBaseBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="50%,50%">
                <c:Sawtooth.RenderTransform>
                  <ScaleTransform ScaleY="-1" ScaleX="-1" />
                </c:Sawtooth.RenderTransform>
              </c:Sawtooth>
              <StackPanel Name="NoteBody" Spacing="0" Margin="20,24,20,24">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                  <TextBlock Text="{l:T imports.note}" Classes="slip-head" VerticalAlignment="Bottom" />
                  <TextBlock Grid.Column="1" c:Sentence.Text="{Binding ReportTitle}" Classes="meta" VerticalAlignment="Bottom" />
                </Grid>
                <c:Groove Margin="0,0,0,8" />
                <ItemsControl Name="DeliveryLines" ItemsSource="{Binding Delivery}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeliveryLine">
                      <Grid ColumnDefinitions="Auto,*,Auto" Height="32">
                        <TextBlock Classes="note-text" Classes.zero="{Binding IsZero}" Text="{Binding Text}" VerticalAlignment="Center" />
                        <c:DotLeader Grid.Column="1" VerticalAlignment="Center" Margin="12,8,12,0" />
                        <TextBlock Grid.Column="2" Classes="note-count" Classes.zero="{Binding IsZero}" Text="{Binding CountText}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- the games the scan brought in, as small spines -->
                <ItemsControl ItemsSource="{Binding NewGames}" IsVisible="{Binding HasNewGames}" Margin="0,10,0,6">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameItemViewModel">
                      <!-- a click opens the game (R2): the spine is pulled 4 px up under the pointer -->
                      <!-- R3 QA: 34 px spines with the system code in 12 (the title in 8 px was cut to "The Legend of…");
                           the title is the tooltip and the accessible name -->
                      <Button Theme="{StaticResource RhTickerItem}" Classes="game-link" Height="96" Focusable="False" ToolTip.Tip="{Binding Title}"
                              AutomationProperties.Name="{Binding Title}">
                        <c:MiniSpine Width="34" Height="96" SystemId="{Binding SystemId}" Code="{Binding SystemShort}" CodeSize="12" ShowMotif="False" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- "3 Hinweise ›": folds the notes open below -->
                <Button Name="IssuesButton" Theme="{StaticResource RhFoldRow}" Classes="fold-row" MinHeight="40" Margin="-20,2,-20,0" IsVisible="{Binding HasIssues}"
                        Command="{Binding ToggleIssuesCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="40" Margin="20,0,20,0">
                    <Border Classes="row-chip" Padding="8,1" CornerRadius="2" Margin="-8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock Classes="note-text" Text="{Binding IssuesText}" />
                    </Border>
                    <c:DotLeader Grid.Column="1" VerticalAlignment="Center" Margin="12,8,12,0" />
                    <TextBlock Grid.Column="2" Classes="note-count" Text="{Binding IssueCount}" VerticalAlignment="Center" Foreground="#A4561C" />
                    <Panel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                      <c:RhIcon Classes="row-chevron" Data="{StaticResource Icon.Expand}" Width="16" Height="16" StrokeThickness="2.6"
                                Foreground="{DynamicResource RhText3Brush}" IsVisible="{Binding !IssuesOpen}" />
                      <c:RhIcon Classes="row-chevron" Data="{StaticResource Icon.Collapse}" Width="16" Height="16" StrokeThickness="2.6"
                                Foreground="{DynamicResource RhText3Brush}" IsVisible="{Binding IssuesOpen}" />
                    </Panel>
                  </Grid>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding ReportClean}">
                  <c:RhIcon Data="{StaticResource Icon.Ok}" Width="16" Height="16" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{l:T imports.clean}" Classes="meta" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <c:FoldPanel IsOpen="{Binding IssuesOpen}">
                  <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,4">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="14" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:IssueGroup">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="label" Foreground="{DynamicResource RhText2Brush}" c:Sentence.Text="{Binding Title}" />
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="lib:ScanIssue">
                                <StackPanel Margin="0,4">
                                  <TextBlock Text="{Binding Path}" Classes="mono" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Reason}" Classes="meta" TextWrapping="Wrap" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding MoreText}" IsVisible="{Binding HasMore}" Classes="meta" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </c:FoldPanel>
                <TextBlock c:Sentence.Text="{Binding ReportFoot}" Classes="meta" Margin="0,10,0,0" />
              </StackPanel>
            </Panel>
          </StackPanel>


        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border c:WorkbenchFrame.Role="Fade" IsHitTestVisible="False" Background="{x:Static c:WorkbenchFrame.FadeBrush}" />
  </c:WorkbenchFrame>
</p:PageBase>