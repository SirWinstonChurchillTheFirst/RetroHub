<p:PageBase xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:p="using:RetroHub.App.Views.Pages"
            xmlns:vm="using:RetroHub.App.ViewModels"
            xmlns:c="using:RetroHub.App.Controls"
            xmlns:l="using:RetroHub.App.Localization"
            xmlns:lib="using:RetroHub.Core.Library"
            x:Class="RetroHub.App.Views.Pages.ImportsPage"
            x:DataType="vm:ImportsViewModel">
  <!--
    Importe (DESIGN 7.6): left the library folders as service-menu rows (path, how it is read, "◀ Aktiv ▶"; confirm
    opens the folder's "Mehr" list), right the scan column: "Jetzt scannen", the segment bar while it runs and the
    delivery note ("Lieferschein") of the last scan instead of a toast – it stands until the next scan begins. Below,
    the covers in the same flat language. No cards, no stat tiles, no progress pill.
  -->
  <p:PageBase.Styles>
    <Style Selector="TextBlock.note-count">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontNumber}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
      <Setter Property="FontFeatures">
        <FontFeatureCollection>
          <FontFeature Tag="tnum" />
        </FontFeatureCollection>
      </Setter>
    </Style>
    <Style Selector="TextBlock.note-text">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontUi}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
    </Style>
    <Style Selector="TextBlock.note-count.zero, TextBlock.note-text.zero">
      <Setter Property="Foreground" Value="{DynamicResource RhText3Brush}" />
    </Style>
    <Style Selector="TextBlock.percent">
      <Setter Property="FontFamily" Value="{DynamicResource RhFontNumber}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="LineHeight" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource RhText1Brush}" />
      <Setter Property="FontFeatures">
        <FontFeatureCollection>
          <FontFeature Tag="tnum" />
        </FontFeatureCollection>
      </Setter>
    </Style>
  </p:PageBase.Styles>

  <Panel>
    <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{DynamicResource RhPageInset}" Spacing="0">
        <TextBlock Text="{l:T nav.imports}" Classes="title" />
        <TextBlock Text="{l:T imports.intro}" Classes="read" MaxWidth="860" HorizontalAlignment="Left" Margin="0,14,0,0" />

        <Grid Name="Columns" ColumnDefinitions="*,56,420" Margin="0,32,0,0">
          <!-- ===== library folders ===== -->
          <StackPanel Name="FolderColumn" Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
              <c:ShelfLabel Text="{l:T imports.folders}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T imports.folders.hint}" Classes="meta" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource RhLineBrush}" />
            <ItemsControl Name="FolderList" ItemsSource="{Binding Folders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderItemViewModel">
                  <c:ServiceRow Classes="folder" DataContext="{Binding Row}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,24,0,0">
              <Button Name="AddFolderButton" Command="{Binding AddFolderCommand}" MinHeight="48">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <c:RhIcon Data="{StaticResource Icon.Plus}" Width="18" Height="18" />
                  <TextBlock Text="{l:T imports.addFolder}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Text="{l:T imports.neverChanged}" Classes="meta" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- ===== scan column ===== -->
          <StackPanel Name="ScanColumn" Grid.Column="2" Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
              <c:ShelfLabel Text="{l:T imports.lastReport}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource RhLineBrush}" Margin="0,0,0,20" />
            <TextBlock c:Sentence.Text="{Binding LastScanText}" Classes="read" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Name="ScanButton" Theme="{StaticResource RhPrimaryButton}" Command="{Binding ScanCommand}" IsVisible="{Binding !IsScanning}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <c:RhIcon Data="{StaticResource Icon.Refresh}" Width="18" Height="18" />
                  <TextBlock Text="{l:T imports.scanNow}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="CancelScanButton" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" Content="{l:T common.cancel}" MinHeight="56" />
            </StackPanel>

            <!-- running: the segment bar and the phase -->
            <StackPanel Spacing="10" Margin="0,28,0,0" IsVisible="{Binding IsScanning}">
              <TextBlock Classes="percent" IsVisible="{Binding !IsIndeterminate}" Text="{Binding Progress, StringFormat={}{0:0} %}" />
              <c:SegmentBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding ProgressText}" Classes="ui" Foreground="{DynamicResource RhText2Brush}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding CurrentFile}" Classes="mono" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- the delivery note of the last scan -->
            <Border Name="DeliveryNote" Margin="0,28,0,0" BorderBrush="{DynamicResource RhLineBrush}" BorderThickness="1" CornerRadius="0" Padding="20,16,20,14"
                    IsVisible="{Binding HasReport}">
              <StackPanel Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                  <TextBlock Text="{l:T imports.note}" Classes="label" Foreground="{DynamicResource RhText2Brush}" />
                  <TextBlock Grid.Column="1" c:Sentence.Text="{Binding ReportTitle}" Classes="meta" />
                </Grid>
                <Border Height="1" Background="{DynamicResource RhLineBrush}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Delivery}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeliveryLine">
                      <Grid ColumnDefinitions="64,16,*" Height="32">
                        <TextBlock Classes="note-count" Classes.zero="{Binding IsZero}" Text="{Binding CountText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="note-text" Classes.zero="{Binding IsZero}" Text="{Binding Text}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- "3 Hinweise ›": folds the notes open below -->
                <Button Name="IssuesButton" Theme="{StaticResource RhFoldRow}" Classes="fold-row" MinHeight="40" Margin="-20,2,-20,0" IsVisible="{Binding HasIssues}"
                        Command="{Binding ToggleIssuesCommand}">
                  <Grid ColumnDefinitions="64,16,*,Auto" Height="40" Margin="20,0,20,0">
                    <TextBlock Classes="note-count" Text="{Binding IssueCount}" VerticalAlignment="Center" Foreground="{DynamicResource RhWarningBrush}" />
                    <Border Grid.Column="2" Classes="row-chip" Padding="8,1" CornerRadius="2" Margin="-8,0,0,0" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                      <TextBlock Classes="note-text" Text="{Binding IssuesText}" />
                    </Border>
                    <c:RhIcon Grid.Column="3" Classes="row-chevron" Data="{StaticResource Icon.Expand}" Width="16" Height="16" StrokeThickness="2.6"
                              Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Center" IsVisible="{Binding !IssuesOpen}" />
                    <c:RhIcon Grid.Column="3" Classes="row-chevron" Data="{StaticResource Icon.Collapse}" Width="16" Height="16" StrokeThickness="2.6"
                              Foreground="{DynamicResource RhText3Brush}" VerticalAlignment="Center" IsVisible="{Binding IssuesOpen}" />
                  </Grid>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding ReportClean}">
                  <c:RhIcon Data="{StaticResource Icon.Ok}" Width="16" Height="16" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{l:T imports.clean}" Classes="meta" Foreground="{DynamicResource RhSuccessBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <c:FoldPanel IsOpen="{Binding IssuesOpen}">
                  <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,4">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="14" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:IssueGroup">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="label" Foreground="{DynamicResource RhText2Brush}">
                            <Run Text="{Binding Title}" /><Run Text=" · " /><Run Text="{Binding Total}" />
                          </TextBlock>
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="lib:ScanIssue">
                                <StackPanel Margin="0,4">
                                  <TextBlock Text="{Binding Path}" Classes="mono" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Reason}" Classes="meta" TextWrapping="Wrap" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding MoreText}" IsVisible="{Binding HasMore}" Classes="meta" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </c:FoldPanel>
                <TextBlock c:Sentence.Text="{Binding ReportFoot}" Classes="meta" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <!-- covers (artwork module) -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,48,0,12">
              <c:ShelfLabel Text="{l:T artwork.title}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource RhLineBrush}" Margin="0,0,0,16" />
            <TextBlock Text="{Binding CoverOnlineText}" Classes="read" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
              <Button Name="CoversButton" Command="{Binding FindCoversCommand}" MinHeight="48">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <c:RhIcon Data="{StaticResource Icon.Search}" Width="18" Height="18" />
                  <TextBlock Text="{l:T artwork.find}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding CancelCoversCommand}" IsVisible="{Binding IsFindingCovers}" Content="{l:T common.cancel}" MinHeight="48" />
            </StackPanel>
            <StackPanel Spacing="10" Margin="0,20,0,0" IsVisible="{Binding IsFindingCovers}">
              <TextBlock Classes="percent" IsVisible="{Binding !CoverIndeterminate}" Text="{Binding CoverProgress, StringFormat={}{0:0} %}" />
              <c:SegmentBar Value="{Binding CoverProgress}" IsIndeterminate="{Binding CoverIndeterminate}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding CoverProgressText}" Classes="ui" Foreground="{DynamicResource RhText2Brush}" />
              <TextBlock Text="{Binding CoverCurrent}" Classes="meta" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock c:Sentence.Text="{Binding CoverResultText}" IsVisible="{Binding HasCoverResult}" Classes="meta" TextWrapping="Wrap" Margin="0,14,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== a folder's "Mehr" list: hangs under its row, the page dims (Raum-Tief 72 %, no blur) ===== -->
    <Panel Name="MenuLayer" IsVisible="{Binding IsMenuOpen}" Background="Transparent">
      <Border Name="MenuScrim" Background="#B80A0908" />
      <Border Name="MenuPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Width="420" Background="{DynamicResource RhSurfaceBrush}"
              BorderBrush="{DynamicResource RhLineBrush}" BorderThickness="1" CornerRadius="{DynamicResource RhRadiusPanel}" Padding="0,8,0,8"
              BoxShadow="{DynamicResource RhPanelShadow}">
        <Panel>
          <Border Height="1" VerticalAlignment="Top" Margin="0,-8,0,0" Background="{DynamicResource RhLightEdgeBrush}" />
          <StackPanel Name="MenuRows" Spacing="0">
            <Button Theme="{StaticResource RhSheetRow}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding MenuFolder}">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <c:RhIcon Data="{StaticResource Icon.Folder}" Width="22" Height="22" />
                <TextBlock Text="{l:T imports.openFolder}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource RhSheetRow}" Command="{Binding ToggleFolderCommand}" CommandParameter="{Binding MenuFolder}"
                    IsVisible="{Binding MenuFolder.CanRemove, FallbackValue=False}">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <c:RhIcon Data="{StaticResource Icon.Refresh}" Width="22" Height="22" />
                <TextBlock Text="{Binding MenuFolder.ToggleText, FallbackValue=''}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource RhSheetRow}" Command="{Binding RemoveFolderCommand}" CommandParameter="{Binding MenuFolder}"
                    IsVisible="{Binding MenuFolder.CanRemove, FallbackValue=False}">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <c:RhIcon Data="{StaticResource Icon.Remove}" Width="22" Height="22" />
                <TextBlock Text="{l:T imports.removeFolder}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Panel>
      </Border>
    </Panel>
  </Panel>
</p:PageBase>
